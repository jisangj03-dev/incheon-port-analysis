---
// 차트 퍼가기 지면(B7) — 다른 사이트가 iframe 으로 싣는 작은 그릇. 검색 안 됨(noindex) · sitemap 에 없음.
// 남의 사이트 안에서 도는 지면이라 **분석 스크립트를 싣지 않는다**(방문자 추적 0). 출처·원 보고서 링크를 늘 같이 보인다.
// 판단: 개편 기준 10 「레이아웃 없는 지면 0」은 독자가 직접 여는 지면에 대한 것이고, 이 지면은 남의 지면 안의 조각이다 — 그래서 상단 바·바닥글 대신 출처 띠 하나를 둔다.
import "../../styles/global.css";
import { getCollection } from "astro:content";
import ReportChart from "../../components/report/ReportChart.astro";
import { REPORT_WIDGET } from "../../lib/report-data";
import { title, splitTitle } from "../../lib/content";
import { abs, u, BRAND } from "../../lib/site";
export async function getStaticPaths() {
  return (await getCollection("reports")).filter((e) => REPORT_WIDGET[e.id]).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { no, text } = splitTitle(title(entry.body ?? ""));
const src = abs(`/reports/${entry.id}.html`);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
  <title>{text} · {BRAND.name} 차트</title>
  <link rel="canonical" href={src} />
  <link rel="stylesheet" href={u("/fonts/pretendard/pretendard.css")} />
</head>
<body data-surface="dark" style="padding:12px">
  <main>
    <ReportChart id={entry.id} embed />
    <p class="em-src"><a href={src} target="_blank" rel="noopener">{BRAND.name}{no ? ` 보고서 ${no}` : ""} — {text}</a> · 공공 1차 데이터</p>
  </main>
  <style>
    .em-src { font-size: 0.82rem; color: var(--mist); margin: 0.6rem 0 0; }
  </style>
</body>
</html>
