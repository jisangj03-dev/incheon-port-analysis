---
// 시안 ③ 지도 한 면 — maplibre 실제 렌더(내장 PMTiles · 외부 요청 0) · 셰입맵급 절제(땅·물·해안선 + 장소 넷).
// 숫자 = analysis/terminal_monthly_long.csv 마지막 달(정체성 §2-1) · 자리 = data/derived/places.json.
import { aiMark } from "../lib/profile";
import Studio from "../layouts/Studio.astro";
import { mapSeries } from "../lib/data";
import { u } from "../lib/site";
import Trust from "../components/scene/Trust.astro";
import Haedo from "../components/scene/Haedo.astro";
import { route, rooms } from "../lib/rooms";
import { sourceLine } from "../lib/sources";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../lib/content";
const D = mapSeries();
// 등심선(있을 때만) — bathy 워크플로가 라이선스 확인 뒤 만든 파일. 없으면 해안선만(채팅 경계)
const bf = join(repoRoot(), "data/derived/bathy_incheon.geojson"), bm = join(repoRoot(), "data/derived/bathy_incheon.json");
const bathy = existsSync(bf) ? JSON.parse(readFileSync(bf, "utf-8")) : null;
const bmeta = existsSync(bm) ? JSON.parse(readFileSync(bm, "utf-8")) : null;
const lastYm = D.months[D.months.length - 1];
type DP = { id: string; label: string; kind: string; lon: number; lat: number; approx: boolean; v: number | null; values: (number | null)[] | null };
const places: DP[] = D.places.map((p: any) => ({ id: p.id, label: p.label, kind: p.kind, lon: p.lon, lat: p.lat, approx: !!p.approx, v: p.values ? p.values[p.values.length - 1] : null, values: p.values || null }));
const RT = route();
const CT = JSON.parse(readFileSync(join(repoRoot(), "data/derived/supply_hs85.json"), "utf-8")).counter;
// 첫 화면 = 해도 그림(빌드 때 SVG) 위에서 달이 흐른다 — maplibre 는 넓은 화면이면 한가할 때, 좁은 화면이면 사람이 움직이면 띄운다(2026-10-14 출고 검사: 모바일 성능 56 · maplibre 실행이 주범 · 10-15 P0 자동 재생).
const pvmax = Math.max(1, ...places.map((p) => p.v || 0));
const ppts = places.map((p) => ({ id: p.id, lon: p.lon, lat: p.lat, v: p.v, cls: p.v === pvmax ? "top" : "" })).concat([{ id: "to", label: RT.to.label, lon: RT.to.lon, lat: RT.to.lat, v: null, cls: "to" }] as any);
const pfit: [number, number][] = ppts.map((p: any) => [p.lon, p.lat]);
const MORE = (rooms().find((r) => r.id === "map")?.items || []);
// 내장 타일 범위(캡션용) — 손으로 적지 않고 설정 파일에서
const TB = String(JSON.parse(readFileSync(join(repoRoot(), "tools-build/pmtiles.json"), "utf-8")).bbox).split(",").map(Number);
const top = [...places].filter((p) => p.v != null).sort((a, b) => (b.v as number) - (a.v as number))[0];
const sea = places.filter((p) => p.kind === "port").length, air = places.filter((p) => p.kind === "air").length;
---
<Studio title="지도 — 인천을 지나는 공급망의 문" description="인천의 항만·공항을 한 장에 — 점 크기는 그 달 컨테이너 처리량, 달이 흐르면 점이 숨 쉬듯 커졌다 작아진다. 내장 지도 타일 · 외부 요청 0." current="map">
  <div class="s-wrap" data-content="ds-map">
    <section class="head">
      <p class="s-cap">지도 · 인천 · {lastYm}</p>
      <h1 class="s-prose">바다 문 {sea}곳, 하늘 문 {air}곳.</h1>
      <p class="s-lead s-prose">점 크기는 그 달 컨테이너 처리량입니다. {lastYm} 가장 큰 문은 <span class="s-signal">{top.id}</span>({top.v}천TEU). 달이 흐르면 점이 숨 쉬듯 커졌다 작아집니다.</p>
      <p class="counter s-prose"><b>반대 지표</b> — {CT.text}. {CT.ym.slice(0, 4)}-{CT.ym.slice(4)} 전국 수입액 중 부산항·부산신항 <b class="s-signal">{CT.busan_pct}%</b>, 인천항 <b>{CT.incheon_port_pct}%</b>(통관 관문 기준).</p>
      <p class="s-cap s-prose">반대 지표 출처 {sourceLine("kcs-porttrade")} · 계산 <a href={u("/map/follow.html")}>공급망 따라가기</a>의 통관 구간과 같다.</p>
    </section>
  </div>
  <div class="ds-map-wrap">
    <div class="ds-map-box">
      <div class="ds-poster" aria-hidden="true"><Haedo id="map-poster" points={ppts} fit={pfit} vmax={pvmax} pad={{ t: 50, b: 50, l: 60, r: 110 }} /></div>
    <div id="ds-map" class="ds-map" role="img" aria-label={`인천 지도 — ${places.map((p) => p.id).join(", ")}`}></div>
    </div>
    <div class="ds-time s-wrap">
      <button type="button" id="ds-play" class="s-btn s-btn--ghost" aria-pressed="false">멈춤</button>
      <label class="ds-time__l"><span id="ds-ym" class="ds-ym">{lastYm}</span><input id="ds-m" type="range" min="0" max={D.months.length - 1} value={D.months.length - 1} step="1" aria-label="달 고르기" /></label>
    </div>
  </div>
  <div class="s-wrap" data-content="ds-map-foot">
    <p class="s-cap">흐름선은 신항·남항·국제여객부두에서 {RT.to.label} 쪽으로 긋는 <b>개념선</b>입니다 — 굵기만 그 달 처리량이고, 길은 실제 운송 경로가 아닙니다. 공항은 컨테이너 통계가 없어 선이 없습니다. 내장 지도 타일은 동경 {TB[0]}°~{TB[2]}° 라, 그 서쪽은 바다색으로만 칠했고(작은 섬은 안 보임) 동쪽(서울 쪽)은 땅색 종이입니다.</p>
    <p class="s-cap">바탕 © OpenStreetMap 기여자 · Protomaps(저장소 내장 타일){bathy && bmeta ? ` · 등심선 ${bmeta.institution || ""} ${(String(bmeta.title || "").match(/(ETOPO\w*|GEBCO_?\d+|SRTM\w*)/) || [bmeta.source])[0].replace(/_/g, " ")}(격자 ${bmeta.resolution_arcsec}″ · ${bmeta.retrieved} 받음 · 선을 부드럽게 다듬음 · 항해용 아님)` : " · 등심선 없음(수심 자료 라이선스 확인 전)"} · 처리량 {D.source} · 자리 OpenStreetMap 시설 면 중심{places.some((p) => p.approx) ? " · 「개략 위치」는 ±2km" : ""}</p>
    <Trust updated={D.updated} source={sourceLine("mof-incheon-port-stats")} csv={u("/data/map-places.csv")} csvName="incheon-map-places.csv" note={`${lastYm} · 천TEU`} />
    {MORE.length > 0 && <section class="more"><h2 class="s-cap">이 지도에서 더</h2><ol class="s-index">{MORE.map((r) => <li><div><h3><a href={u(r.href)}>{r.title}</a></h3><p>{r.lead}</p></div></li>)}</ol></section>}
    <dl class="s-maker" data-maker-note style="margin-top:32px;max-width:46rem">
      <dt>왜</dt><dd data-note="why">인천을 지나는 화물이 어느 문으로 드나드는지, 표보다 먼저 자리로 보이게 하려고.</dd>
      <dt>어떻게</dt><dd data-note="how">공표 월별 처리량을 시설 면 중심점 위에 원 넓이로 얹었다. 바탕은 땅·물·해안선만 남겼다.</dd>
      <dt>한계</dt><dd data-note="limits">점은 문이지 길이 아니다 — 문에서 수도권 어디로 가는지는 아직 데이터가 없다.</dd>
    </dl>
    <p class="s-cap" data-ai-mark style="margin-top:24px">{aiMark()}</p>
  </div>
  <script type="application/json" id="ds-map-data" set:html={JSON.stringify(places)}></script>
  <script type="application/json" id="ds-map-months" set:html={JSON.stringify({ months: D.months, to: RT.to })}></script>
  <script type="application/json" id="ds-bathy" set:html={JSON.stringify(bathy ? { features: bathy.features } : null)}></script>
  <script define:vars={{ ml: u("/vendor/maplibre/maplibre-gl.mjs"), worker: u("/vendor/maplibre/maplibre-gl-worker.mjs"), css: u("/vendor/maplibre/maplibre-gl.css"), tiles: u("/tiles/incheon.pmtiles") }}>
    window.__mapcfg = { ml, worker, css, tiles };
  </script>
  <script>
    import { initDsMap } from "../lib/ds-map";
    import { initHaedo } from "../lib/haedo";
    // [2026-10-15 공개 전 개편 P0] 들어오자마자 돈다 — 클릭 없이.
    //  · 첫 장면 = 해도 정지 그림 위에서 달이 흐른다(점 넓이 = 그 달 처리량 · 원 반지름만 바꾼다 — 가볍다 · 모바일 성능 90)
    //  · 넓은 화면은 한가할 때 maplibre 를 받아 이어 돈다 · 좁은 화면은 사람이 움직이면 받는다(maplibre 실행이 모바일 성능 56 의 주범이었다 · 10-14)
    //  · 만지면(달 막대·끌기) 멈췄다가 6초 뒤 다시 · 「멈춤」 단추로 멈춘 것은 그대로 · 동작 줄이기면 돌지 않는다
    const fig = document.getElementById("map-poster") as HTMLElement;
    let s = 1;
    initHaedo(fig, (k) => { s = k; });
    const P = JSON.parse(document.getElementById("ds-map-data")!.textContent || "[]");
    const MD = JSON.parse(document.getElementById("ds-map-months")!.textContent || "{}");
    const slider = document.getElementById("ds-m") as HTMLInputElement, play = document.getElementById("ds-play") as HTMLButtonElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches, lite = matchMedia("(max-width: 720px)").matches;
    const last = (p: any) => (p.values ? p.values[p.values.length - 1] : null);
    const vmax = Math.max(1, ...P.map((p: any) => last(p) || 0));
    const W = window as any;
    W.__mapPlay = { held: reduce, i: MD.months.length - 1, frames: 0 };
    let pt: any = null, rt: any = 0, started = false;
    const pset = (i: number) => {
      W.__mapPlay.i = i; W.__mapPlay.frames++;
      slider.value = String(i); document.getElementById("ds-ym")!.textContent = MD.months[i];
      for (const p of P) {
        const v = p.values ? p.values[i] : null, c = fig.querySelector<SVGCircleElement>(`circle[data-pt="${CSS.escape(p.id)}"]`);
        if (c) { const r = v ? 4 + 12 * Math.sqrt(v / vmax) : 3.5; c.dataset.rpx = r.toFixed(1); c.setAttribute("r", String(r / s)); }
        const lb = fig.querySelector(`[data-lb="${CSS.escape(p.id)}"] i`); if (lb) lb.textContent = v == null ? "—" : String(v);
      }
    };
    const pbtn = () => { play.textContent = pt ? "멈춤" : "재생"; play.setAttribute("aria-pressed", String(!pt)); };
    const pstart = () => { if (pt || W.__mapPlay.held) return; pt = setInterval(() => pset((W.__mapPlay.i + 1) % MD.months.length), 900); pbtn(); };
    const pstop = () => { clearInterval(pt); pt = null; pbtn(); };
    const ptouch = () => { pstop(); clearTimeout(rt); if (!W.__mapPlay.held && !reduce) rt = setTimeout(pstart, 6000); };
    const onPlay = () => { if (pt) { W.__mapPlay.held = true; pstop(); } else { W.__mapPlay.held = false; pstart(); } };
    const onSlide = () => { ptouch(); pset(Number(slider.value)); };
    play.addEventListener("click", onPlay); slider.addEventListener("input", onSlide);
    if (!reduce) { pbtn(); setTimeout(pstart, 1200); } else pbtn();
    // 움직이는 지도(maplibre)로 넘긴다 — 넘길 때 달·멈춤 상태를 그대로 준다
    const EV = ["scroll", "pointerdown", "pointermove", "keydown", "touchstart", "wheel"] as const;
    // 첫 장면은 maplibre 가 다 그릴(idle) 때까지 계속 돈다 — 받는 동안 멈춘 화면이 없게(ds-map 이 idle 에서 부른다)
    W.__mapPosterStop = () => { clearInterval(pt); pt = null; clearTimeout(rt); play.removeEventListener("click", onPlay); slider.removeEventListener("input", onSlide); };
    const go = () => {
      if (started) return; started = true;
      for (const e of EV) removeEventListener(e, go); initDsMap();
    };
    for (const e of EV) addEventListener(e, go, { passive: true, once: true });
    if (!lite) "requestIdleCallback" in window ? W.requestIdleCallback(go, { timeout: 2500 }) : setTimeout(go, 800);
    if (location.hash === "#live") go();
  </script>
</Studio>
<style>
  .counter { border-left: 3px solid var(--s-signal); padding-left: var(--s-4); margin-top: var(--s-5); }
  .more { margin-top: var(--s-7); max-width: 46rem; }
  .head { padding: var(--s-7) 0 var(--s-5); }
  .head h1 { margin: var(--s-3) 0 var(--s-4); }
  .ds-map-wrap { position: relative; }
  .ds-time { display: flex; align-items: center; gap: var(--s-4); margin-top: var(--s-3); margin-bottom: var(--s-4); }
  .ds-time__l { flex: 1; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--s-4); }
  .ds-ym { font-style: italic; font-variant-numeric: tabular-nums; color: var(--s-ink-2); min-width: 5.5em; }
  .ds-time input { width: 100%; accent-color: var(--s-signal); min-height: 44px; margin: 0; }
  .ds-map-box { position: relative; }
  .ds-poster { position: absolute; inset: 0 0 var(--s-4); overflow: hidden; }
  .ds-map:not([data-ready]) { background: transparent; }
  .ds-map { position: relative; height: clamp(420px, calc(100svh - 460px), 720px); background: var(--s-paper); border-top: 1px solid var(--s-rule); border-bottom: 1px solid var(--s-rule); margin-bottom: var(--s-4); }
  :global(.ds-labels) { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  :global(.ds-labels .ds-label) { position: absolute; }
  :global(.ds-lines) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; stroke: var(--s-ink-3); stroke-width: 0.8; }
  .ds-map-box:has(#ds-map[data-ready]) .ds-poster { display: none; }
  :global(.ds-label) { font: 500 13px/1.2 var(--s-font); color: var(--s-ink); white-space: nowrap; text-shadow: 0 0 3px var(--s-paper), 0 0 3px var(--s-paper), 0 0 2px var(--s-paper); pointer-events: none; }
  :global(.ds-label b) { display: block; font-weight: 600; font-size: 14px; letter-spacing: -0.01em; }
  /* 데이터 숫자 = 해도 수심 표기처럼 작은 기울임 · 상자 없음 */
  :global(.ds-label i) { font-style: italic; font-weight: 500; font-size: 15px; letter-spacing: 0; color: var(--s-ink-2); font-variant-numeric: tabular-nums; }
  :global(.ds-label i small) { font-size: 11px; font-style: normal; color: var(--s-ink-3); margin-left: 2px; }
  :global(.ds-label em) { display: block; font-style: normal; color: var(--s-ink-3); font-size: 11px; }
  :global(.ds-depth) { font: italic 400 10px/1 var(--s-font); color: var(--s-ink-3); pointer-events: none; text-shadow: 0 0 2px var(--s-paper), 0 0 2px var(--s-paper); }
  /* 가장자리 위경도 눈금 — 종이 해도의 테두리 눈금자(분 단위 흑백 막대) */
  :global(.ds-grat) { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  :global(.ds-grat text) { font: 400 10px var(--s-font); fill: var(--s-ink-3); }
</style>
