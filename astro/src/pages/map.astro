---
// 인천 물류 3D 지도(개편 2단계 · 기준 20) — 바탕 = 저장소에 내장한 PMTiles(인천만 · Actions 가 빌드 때 추출) · 실행 중 API 키 0 · 외부 요청 0.
// 첫 화면은 정지 그림(빌드 때 SVG)이고, 3D(maplibre + deck.gl · 약 2MB)는 늦게 붙는다. 시간축 = 월별 처리량(실제 공표값).
// 시각 마감(위성 질감·HDRI·후보정)은 시안 뒤 — 지금은 구조·데이터·컴포넌트다. 공개 전 선장님 「진짜 같다」(기준 21).
import Base from "../layouts/Base.astro";
import Updated from "../components/Updated.astro";
import { mapSeries } from "../lib/data";
import { u } from "../lib/site";

const D = mapSeries();
const last = D.months.length - 1;
// 정지 그림 — 경위도를 단순 투영해 기둥으로(지도 타일 없이도 뜬다).
const W = 720, H = 420, bx = [126.35, 126.85], by = [37.25, 37.62];
const px = (lon: number) => ((lon - bx[0]) / (bx[1] - bx[0])) * W;
const py = (lat: number) => H - ((lat - by[0]) / (by[1] - by[0])) * H;
// 「A·B는/은」 — 마지막 이름의 받침으로 조사를 고른다.
const topic = (ps: any[]) => { const t = ps.map((p) => p.id).join("·"); const c = t.charCodeAt(t.length - 1) - 0xac00; return t + (c >= 0 && c < 11172 && c % 28 ? "은" : "는"); };
const vmax = Math.max(...D.places.flatMap((p: any) => (p.values || []).filter((v: any) => v !== null)));
---
<Base title="인천 물류 3D 지도" description="인천항 부두군·터미널별 월별 컨테이너 처리량을 입체 기둥으로 — 시간축을 움직여 2023년부터 지금까지. 바탕지도는 저장소에 내장(외부 요청 0)." path="/map.html" wide>
  <div class="mp">
    <div class="wrap mp__head">
      <p class="eyebrow">지도 · 시안 전 구조판</p>
      <h1>인천 물류, 입체로</h1>
      <p class="lede">부두군별 월 처리량(천TEU)을 기둥 높이로. 시간축을 움직이면 {D.months[0]}부터 {D.months[last]}까지 바뀌는 모양을 봅니다.</p>
    </div>
    <div class="mp__stage" data-chart="map3d">
      <svg class="mp__still" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`정지 그림 — ${D.months[last]} 부두군별 처리량`}>
        <rect width={W} height={H} fill="#05090f" />
        {Array.from({ length: 8 }, (_, k) => <line x1="0" x2={W} y1={(k + 1) * (H / 9)} y2={(k + 1) * (H / 9)} stroke="rgba(63,211,230,.08)" />)}
        {D.places.map((p: any) => {
          const v = p.values ? p.values[last] : null;
          const h = v ? (v / vmax) * 150 : 0;
          return (
            <g>
              {v ? <rect x={px(p.lon) - 9} y={py(p.lat) - h} width="18" height={h} rx="3" fill={p.kind === "air" ? "#ffb547" : "#3fd3e6"} opacity=".9" /> : <circle cx={px(p.lon)} cy={py(p.lat)} r="7" fill="#ffb547" />}
              <text x={px(p.lon) + 14} y={py(p.lat) + 4} fill="#eef5fa" font-size="13" font-weight="700">{p.id}{p.approx ? "(개략)" : ""}{v ? ` ${v}천TEU` : ""}</text>
            </g>
          );
        })}
      </svg>
      <div id="map" class="mp__map" hidden></div>
      <div class="mp__ctrl">
        <button type="button" id="open3d" class="btn btn--primary">3D 지도 열기</button>
        <label for="month" class="mp__lab">월 <strong id="month-out">{D.months[last]}</strong></label>
        <input id="month" type="range" min="0" max={last} value={last} step="1" />
        <button type="button" id="play" class="btn">▶ 재생</button>
      </div>
      <p class="mp__note"><strong>기둥 자리</strong> — {topic(D.places.filter((p: any) => !p.approx))} OpenStreetMap 시설 면의 중심점(ODbL){D.places.some((p: any) => p.approx) && <>, <strong>{topic(D.places.filter((p: any) => p.approx))} 개략 위치(±2km · 측량값 아님)</strong></>}입니다. <Updated date={D.updated} source={`${D.source} · ${D.months.length}개월`} /> <span id="attrib">바탕지도 © OpenStreetMap · Protomaps</span></p>
    </div>
    <div class="wrap mp__more">
      <h2>이 지도에 아직 없는 것</h2>
      <ul>
        <li><strong>교역국 항로 아크 · 품목별 수출입</strong> — 관세청 품목·국가별 API 활용신청 뒤(선장님 손).</li>
        <li><strong>실제 입출항 기록으로 움직이는 선박</strong> — 해수부 선박입출항 API 활용신청 뒤.</li>
        <li><strong>공항화물 · 물류단지 · 보세구역 · 자유무역지역</strong> — 항공화물 축 선커밋(기준 11) 뒤 수집. 창고는 <a href={u("/tools/warehouse-map.html")}>구·동 배치도</a>에.</li>
        <li><strong>실사 질감(위성·지형·조명)</strong> — 시안 반영 뒤. 위성(Sentinel-2)·지형(Copernicus DEM)은 출처 고지 조건을 지켜 싣는다.</li>
      </ul>
    </div>
  </div>
  <script type="application/json" id="map-data" set:html={JSON.stringify({ months: D.months, places: D.places })} />
  <script define:vars={{ ml: u("/vendor/maplibre/maplibre-gl.mjs"), worker: u("/vendor/maplibre/maplibre-gl-worker.mjs"), css: u("/vendor/maplibre/maplibre-gl.css"), tiles: u("/tiles/incheon.pmtiles") }}>
    window.__mapcfg = { ml, worker, css, tiles };
  </script>
  <script>
    import { initMap } from "../lib/map-ui";
    initMap();
  </script>
</Base>
<style>
  .mp__head { padding-top: 2rem; }
  .mp__head h1 { margin-top: 0.2em; }
  .mp__stage { position: relative; max-width: 1200px; margin: 1rem auto 0; padding: 0 var(--gutter); }
  .mp__still, .mp__map { width: 100%; aspect-ratio: 12 / 7; border-radius: var(--r-lg); display: block; border: 1px solid var(--hair); background: #05090f; }
  .mp__map { height: auto; overflow: hidden; }
  .mp__ctrl { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; margin-top: 0.8rem; }
  .mp__ctrl input[type="range"] { flex: 1 1 220px; accent-color: var(--sonar); min-height: 44px; }
  .mp__lab { font-size: 0.9rem; color: var(--mist); }
  .mp__lab strong { color: var(--sodium); font-variant-numeric: tabular-nums; }
  .mp__note { font-size: 0.82rem; color: var(--mist); margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
  .mp__more { margin-top: 2rem; max-width: 820px; }
</style>
