---
// 시안 ① 새 홈 — 「해도」 한 장 위로 신항→수도권 주홍 선이 스크롤을 따라 그려진다(pudding·Reuters 의 스크롤 이야기 원리).
// 방·노트는 콘텐츠 목록 하나(data/rooms.json)에서 자동 배치. 숫자는 데이터 파일에서만(정체성 §2-1).
// 실명·소속·연락처는 자리표시(정체성 §5-4 공개 전환 PR 에서 채운다). lab/ 전용 — 공개 배포물에는 없다.
import Studio from "../../../layouts/Studio.astro";
import Scene from "../../../components/scene/Scene.astro";
import Trust from "../../../components/scene/Trust.astro";
import NoteList from "../../../components/scene/NoteList.astro";
import { portMonthly, mapSeries } from "../../../lib/data";
import { rooms, route } from "../../../lib/rooms";
import { repoRoot } from "../../../lib/content";
import { u } from "../../../lib/site";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

const P = portMonthly();
const S = P.series;
const last = S[S.length - 1];
const R = rooms();
const RT = route();

// ── 해도 한 장(빌드 때 SVG · 외부 요청 0) ── 경위도 사각 투영(위도 37.44° 에서 cos 보정).
// 그림 좌표는 넓게 깔고, 실제 보이는 범위(viewBox)는 화면 비율에 맞춰 JS 가 신항·인천공항·서울을 한 장면으로 맞춘다.
const M = mapSeries();
const places = M.places.map((p: any) => ({ id: p.id, kind: p.kind, lon: p.lon, lat: p.lat, v: p.values ? p.values[p.values.length - 1] : null }));
const rd = (f: string) => { const q = join(repoRoot(), f); return existsSync(q) ? JSON.parse(readFileSync(q, "utf-8")) : null; };
const bathy = rd("data/derived/bathy_incheon.geojson");
const land = rd("data/derived/land_incheon.geojson");
const BB = [126.0, 37.0, 127.4, 37.9]; // 그림 좌표 범위(넓게)
const KX = 1000 / (BB[2] - BB[0]), KY = KX / Math.cos((37.44 * Math.PI) / 180);
const px = (lon: number) => (lon - BB[0]) * KX;
const py = (lat: number) => (BB[3] - lat) * KY;
const CH = Math.round(py(BB[1]));
const path = (c: number[][], close = false) => c.map(([x, y], i) => `${i ? "L" : "M"}${px(x).toFixed(1)},${py(y).toFixed(1)}`).join("") + (close ? "Z" : "");
const contours = bathy ? bathy.features.filter((f: any) => f.properties.kind === "contour").map((f: any) => path(f.geometry.coordinates)) : [];
const coast = bathy ? bathy.features.filter((f: any) => f.properties.kind === "coast").map((f: any) => path(f.geometry.coordinates)) : [];
// 땅 면은 하나의 path 로(타일 경계 이음새가 안 보이게 선 없이 채우기만) · 고속도로는 가는 선 하나로
const landD = land ? land.features.filter((f: any) => f.properties.kind === "land").map((f: any) => path(f.geometry.coordinates[0], true)).join("") : "";
const roadD = land ? land.features.filter((f: any) => f.properties.kind === "road").map((f: any) => path(f.geometry.coordinates)).join("") : "";
const from = places.find((p: any) => p.id === RT.from)!;
const [x0, y0, x1, y1] = [px(from.lon), py(from.lat), px(RT.to.lon), py(RT.to.lat)];
// 완만한 곡선 하나 — 개념선(실제 경로 아님)
const cx = (x0 + x1) / 2 - (y1 - y0) * 0.18, cy = (y0 + y1) / 2 + (x1 - x0) * 0.12;
const routeD = `M${x0.toFixed(1)},${y0.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${x1.toFixed(1)},${y1.toFixed(1)}`;
const vmax = Math.max(...places.map((p: any) => p.v || 0));
// 맞출 범위(그림 좌표) — 장소 넷 + 서울
const fitPts = places.map((p: any) => [px(p.lon), py(p.lat)]).concat([[x1, y1]]);
const FIT = [Math.min(...fitPts.map((q: number[]) => q[0])), Math.min(...fitPts.map((q: number[]) => q[1])), Math.max(...fitPts.map((q: number[]) => q[0])), Math.max(...fitPts.map((q: number[]) => q[1]))];
const geo = { BB, KX, KY, FIT };

// ── 숫자 장면(달 막대로 앞뒤로 움직인다) ──
const W = 1000, H = 220, pad = 10;
const vs = S.map((s) => s.v), lo = Math.min(...vs), hi = Math.max(...vs);
const sx = (i: number) => pad + (i * (W - 2 * pad)) / (S.length - 1);
const sy = (v: number) => H - pad - ((v - lo) * (H - 2 * pad)) / (hi - lo || 1);
const spark = S.map((s, i) => `${i ? "L" : "M"}${sx(i).toFixed(1)},${sy(s.v).toFixed(1)}`).join("");
const iHi = vs.indexOf(hi), iLo = vs.indexOf(lo);
const pct = (i: number) => `${((sx(i) / W) * 100).toFixed(2)}%`;
const series = S.map((s, i) => ({ ym: s.ym, v: s.v, yoy: s.yoy, x: +sx(i).toFixed(1), y: +sy(s.v).toFixed(1) }));
---
<Studio title="측심 — SCM 작업실(시안)" current="home">
  <div class="hero" data-content="ds-home-hero">
    <div class="hero__stick">
      <figure class="chart" aria-label="인천 앞바다에서 서울까지 — 신항에서 서울 쪽으로 긋는 개념선">
        <svg id="sea" viewBox={`0 0 1000 ${CH}`} preserveAspectRatio="none" role="img">
          {landD && <path d={landD} class="land" />}
          {contours.map((d: string) => <path d={d} class="ct" />)}
          {!landD && coast.map((d: string) => <path d={d} class="cs" />)}
          {roadD && <path d={roadD} class="road" />}
          <path d={routeD} class="route" id="route" pathLength="1" />
          {places.map((p: any) => <circle cx={px(p.lon)} cy={py(p.lat)} r="1" data-rpx={(p.v ? 4 + 12 * Math.sqrt(p.v / vmax) : 3.5).toFixed(1)} class:list={["pt", { top: p.v === vmax }]} />)}
          <circle cx={x1} cy={y1} r="1" data-rpx="5" class="pt-to to" />
        </svg>
        <div class="labels" aria-hidden="true">
          {places.map((p: any) => <span class="lb" data-x={px(p.lon).toFixed(1)} data-y={py(p.lat).toFixed(1)} data-off={((p.v ? 4 + 12 * Math.sqrt(p.v / vmax) : 3.5) + 6).toFixed(1)}><b>{p.id}</b>{p.v != null && <i>{p.v}</i>}</span>)}
          <span class="lb lb--to" data-x={x1.toFixed(1)} data-y={y1.toFixed(1)} data-off="11"><b>{RT.to.label}</b></span>
        </div>
        <svg class="grat" aria-hidden="true"></svg>
      </figure>
      <div class="s-wrap hero__text">
        <h1 class="s-prose"><span class="s-signal">인천</span>을 지나는 물건의 길을, 공공 1차 데이터로 잽니다.</h1>
        <p class="s-lead s-prose">〈운영자 실명〉의 SCM 작업실입니다. 항만·공항·창고를 잇는 수도권 공급망을 실제 숫자로 움직여 보여 줍니다.</p>
      </div>
      <p class="s-wrap s-cap hero__cap">주홍 선은 신항에서 {RT.to.label} 쪽으로 긋는 개념선입니다 — 실제 운송 경로가 아닙니다. 숫자는 {M.months[M.months.length - 1]} 컨테이너 처리량(천TEU) · 땅·고속도로 © OpenStreetMap 기여자(ODbL) · 등심선 NOAA ETOPO 2022(항해용 아님).</p>
      <script type="application/json" id="geo" set:html={JSON.stringify(geo)}></script>
    </div>
  </div>

  <div class="s-wrap" data-content="ds-home">
    <Scene kind="num" id="now">
      <h2 class="s-cap now-h"><span id="now-ym">{last.ym}</span> 한 달 동안 인천항으로 드나든 컨테이너</h2>
      <p class="s-num"><span id="now-v">{last.v}</span><span class="s-unit">천TEU</span></p>
      <p class="s-lead s-prose">작년 같은 달보다 <strong id="now-yoy" class={last.yoy !== null && last.yoy < 0 ? "s-signal" : ""}>{last.yoy === null ? "—" : `${last.yoy > 0 ? "+" : last.yoy < 0 ? "−" : ""}${Math.abs(last.yoy)}%`}</strong>. 주장에 불리한 숫자도 같은 자리에 둡니다.</p>
      <figure class="spark">
        <div class="spark-box">
          <div class="spark-in">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${S[0].ym}부터 ${last.ym}까지 월별 처리량`}>
            <path d={spark} fill="none" stroke="var(--s-ink-2)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            <line id="now-rule" x1={sx(S.length - 1)} x2={sx(S.length - 1)} y1="0" y2={H} stroke="var(--s-rule)" vector-effect="non-scaling-stroke" />
          </svg>
          <span id="now-dot" class="dot" style={`left:${pct(S.length - 1)};top:${((sy(last.v) / H) * 100).toFixed(2)}%`}></span>
          </div>
          <span class="mark hi" style={`left:${pct(iHi)}`}>가장 많은 달 {S[iHi].ym} · {hi}</span>
          <span class="mark lo" style={`left:${pct(iLo)}`}>가장 적은 달 {S[iLo].ym} · {lo}</span>
        </div>
        <label class="scrub"><span class="s-cap">달을 옮겨 보세요</span><input id="now-m" type="range" min="0" max={S.length - 1} value={S.length - 1} step="1" aria-label="달 고르기" /></label>
        <Trust updated={P.updated} source={P.source} csv={u("/lab/data/port-monthly.csv")} csvName="incheon-port-monthly.csv" note="월별 · 천TEU" />
      </figure>
      <script type="application/json" id="now-data" set:html={JSON.stringify(series)}></script>
    </Scene>

    <Scene kind="text" title="네 개의 방">
      <ol class="s-index">
        {R.map((r) => <li><div><h3><a href={r.href.startsWith("#") ? r.href : u(r.href)}>{r.title}</a></h3><p>{r.lead}</p></div></li>)}
      </ol>
    </Scene>

    <Scene kind="note" id="notes" title="노트" lead="심은 날과 고친 날을 박아 둡니다. 초안에서 정본으로 자랍니다.">
      <NoteList limit={6} />
    </Scene>

    <Scene kind="text" id="about" title="소개">
      <p class="s-lead s-prose">〈운영자 실명〉 · 〈소속〉. 〈자격〉 · 〈기고〉.</p>
      <p class="s-prose">공급망이 어디서 막히고 어디서 출렁이는지를 숫자로 보이는 일을 합니다. 틀린 곳을 알려 주시면 고쳐 적습니다.</p>
      <p class="contact"><a class="s-btn" href="#about">LinkedIn 〈자리표시〉</a> <a class="s-btn s-btn--ghost" href="#about">메일 〈자리표시〉</a></p>
    </Scene>
  </div>
  <script>
    // ① 스크롤을 따라 주홍 선이 그려진다(움직임 줄이기 설정이면 처음부터 다 그린 채)
    const hero = document.querySelector(".hero") as HTMLElement, path = document.getElementById("route") as unknown as SVGPathElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const draw = () => {
      const r = hero.getBoundingClientRect(), span = Math.max(1, hero.offsetHeight - innerHeight);
      const t = reduce ? 1 : Math.min(1, Math.max(0, (-r.top + innerHeight * 0.15) / span));
      path.style.strokeDashoffset = String(1 - t);
      hero.dataset.progress = t.toFixed(2);
    };
    addEventListener("scroll", draw, { passive: true }); addEventListener("resize", draw); draw();
    // ⓪ 화면 비율에 맞춰 보이는 범위를 정한다 — 글자 자리(위·왼쪽)를 비워 두고 신항~서울을 한 장면으로
    const G = JSON.parse(document.getElementById("geo")!.textContent || "{}");
    const fig = document.querySelector(".hero .chart") as HTMLElement, sea = document.getElementById("sea") as unknown as SVGSVGElement;
    const grat = document.querySelector(".hero .grat") as unknown as SVGSVGElement;
    const fit = () => {
      const W = fig.clientWidth, H = fig.clientHeight, narrow = W < 700;
      const text = (document.querySelector(".hero__text") as HTMLElement).getBoundingClientRect().height;
      const pad = { t: text + (narrow ? 40 : 60), b: narrow ? 120 : 120, l: narrow ? 24 : W * 0.18, r: narrow ? 64 : W * 0.1 };
      const [fx0, fy0, fx1, fy1] = G.FIT, bw = fx1 - fx0, bh = fy1 - fy0;
      const s = Math.min((W - pad.l - pad.r) / bw, (H - pad.t - pad.b) / bh);
      const vx = fx0 - pad.l / s - ((W - pad.l - pad.r) / s - bw) / 2, vy = fy0 - pad.t / s - ((H - pad.t - pad.b) / s - bh) / 2;
      sea.setAttribute("viewBox", `${vx.toFixed(1)} ${vy.toFixed(1)} ${(W / s).toFixed(1)} ${(H / s).toFixed(1)}`);
      for (const el of document.querySelectorAll<HTMLElement>(".hero .lb")) {
        el.style.left = `${(Number(el.dataset.x) - vx) * s + Number(el.dataset.off || 10)}px`; el.style.top = `${(Number(el.dataset.y) - vy) * s}px`;
      }
      // 점 크기·주홍 선 굵기는 화면 픽셀로 고정(확대 비율이 바뀌어도 같은 크기) — 선은 vector-effect 를 쓰면 대시(그려지는 효과)가 화면 픽셀로 계산돼 끊긴다
      for (const c of document.querySelectorAll<SVGCircleElement>(".hero circle[data-rpx]")) c.setAttribute("r", String(Number(c.dataset.rpx) / s));
      (document.getElementById("route") as unknown as SVGPathElement).style.strokeWidth = String(3 / s);
      // 가장자리 위경도 눈금(5′) — 화면 픽셀로
      const lon = (x: number) => G.BB[0] + (x / s + vx) / G.KX, lat = (y: number) => G.BB[3] - (y / s + vy) / G.KY;
      const X = (lo: number) => ((lo - G.BB[0]) * G.KX - vx) * s, Y = (la: number) => ((G.BB[3] - la) * G.KY - vy) * s;
      const dm = (deg: number) => { const d = Math.floor(deg + 1e-9), m = Math.round((deg - d) * 60); return `${d}°${String(m).padStart(2, "0")}′`; };
      let g = "";
      for (let m = Math.ceil(lat(H) * 12) * 5; m <= lat(0) * 60; m += 5) { const y = Y(m / 60); if (y < pad.t - 20 || y > H - 130) continue; g += `<line x1="0" x2="8" y1="${y}" y2="${y}"/><text x="12" y="${y + 3}">${dm(m / 60)}N</text>`; }
      for (let m = Math.ceil(lon(0) * 12) * 5; m <= lon(W) * 60; m += 5) { const x = X(m / 60); if (x > 60 && x < W - 60) g += `<line x1="${x}" x2="${x}" y1="${H}" y2="${H - 8}"/><text x="${x + 3}" y="${H - 12}">${dm(m / 60)}E</text>`; }
      grat.setAttribute("viewBox", `0 0 ${W} ${H}`); grat.innerHTML = g;
      (document.querySelector(".hero__stick") as HTMLElement).style.setProperty("--fade", `${text + 40}px`);
      fig.dataset.fit = "1";
    };
    new ResizeObserver(fit).observe(fig); fit();
    // ② 달 막대 — 큰 숫자·전년 대비·점이 같이 움직인다
    const D = JSON.parse(document.getElementById("now-data")!.textContent || "[]");
    const m = document.getElementById("now-m") as HTMLInputElement, $ = (id: string) => document.getElementById(id)!;
    m.addEventListener("input", () => {
      const s = D[Number(m.value)];
      $("now-ym").textContent = s.ym; $("now-v").textContent = String(s.v);
      const y = $("now-yoy"); y.textContent = s.yoy === null ? "—" : `${s.yoy > 0 ? "+" : s.yoy < 0 ? "−" : ""}${Math.abs(s.yoy)}%`; y.className = s.yoy !== null && s.yoy < 0 ? "s-signal" : "";
      const dot = $("now-dot"); dot.style.left = `${(s.x / 10).toFixed(2)}%`; dot.style.top = `${((s.y / 220) * 100).toFixed(2)}%`;
      $("now-rule").setAttribute("x1", String(s.x)); $("now-rule").setAttribute("x2", String(s.x));
    });
  </script>
</Studio>
<style>
  .hero { height: 190vh; position: relative; }
  .hero__stick { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .hero__text { position: absolute; top: 0; left: 0; right: 0; padding-top: var(--s-6); padding-bottom: var(--s-6); z-index: 2; pointer-events: none; }
  /* 글자 뒤는 종이로 옅게 덮는다(상자 없이 · 아래로 사라지는 바림) */
  .hero__stick::before { content: ""; position: absolute; inset: 0 0 auto 0; height: var(--fade, 42%); background: linear-gradient(var(--s-paper) 55%, rgba(245, 242, 235, 0)); z-index: 1; pointer-events: none; }
  .hero__text h1 { font-size: clamp(32px, 4.8vw, 64px); text-shadow: 0 0 12px var(--s-paper), 0 0 4px var(--s-paper); }
  .hero__text .s-lead { margin-top: var(--s-4); text-shadow: 0 0 8px var(--s-paper); }
  .hero__cap { position: absolute; left: 0; right: 0; bottom: 30px; z-index: 2; text-shadow: 0 0 6px var(--s-paper), 0 0 3px var(--s-paper); }
  .chart { position: absolute; inset: 0; margin: 0; }
  .chart svg#sea { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* 종이 해도처럼 — 땅은 옅은 황토, 바다는 종이 그대로, 등심선은 배경으로 물러난다 */
  .land { fill: #ebe4d3; stroke: #ebe4d3; stroke-width: 0.6; vector-effect: non-scaling-stroke; }
  .ct { fill: none; stroke: #ddd5c4; stroke-width: 0.6; vector-effect: non-scaling-stroke; }
  .cs { fill: none; stroke: #b5ac9a; stroke-width: 0.8; vector-effect: non-scaling-stroke; }
  .road { fill: none; stroke: #cdc3ae; stroke-width: 0.9; vector-effect: non-scaling-stroke; }
  .route { fill: none; stroke: var(--s-signal); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .pt { fill: var(--s-ink); fill-opacity: 0.85; stroke: var(--s-paper); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .pt.top { fill: var(--s-signal); }
  .to { fill: var(--s-paper); stroke: var(--s-signal); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .labels { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .lb { position: absolute; transform: translate(12px, -50%); white-space: nowrap; font-size: 14px; line-height: 1.2; text-shadow: 0 0 3px var(--s-paper), 0 0 3px var(--s-paper), 0 0 2px var(--s-paper); }
  .lb b { font-weight: 600; }
  .lb i { font-style: italic; color: var(--s-ink-2); margin-left: 6px; font-variant-numeric: tabular-nums; }
  .lb--to b { color: var(--s-signal); }
  .grat { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .grat :global(line) { stroke: var(--s-ink-2); }
  .grat :global(text) { font: 400 11px var(--s-font); fill: var(--s-ink-3); }
  .now-h { font-weight: 400; letter-spacing: 0; margin-bottom: var(--s-3); }
  .spark { margin: 48px 0 0; }
  .spark-box { position: relative; padding: 28px 0; }
  .spark-in { position: relative; }
  .spark svg { display: block; width: 100%; height: 180px; }
  .dot { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--s-signal); }
  .mark { position: absolute; transform: translateX(-50%); font-size: var(--s-t-cap); color: var(--s-ink-3); white-space: nowrap; line-height: 1; }
  .mark.hi { top: 0; } .mark.lo { bottom: 0; }
  .scrub { display: grid; gap: var(--s-1); margin-top: var(--s-4); }
  .scrub input { width: 100%; accent-color: var(--s-signal); min-height: 44px; margin: 0; }
  .contact { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  @media (max-width: 560px) {
    .hero { height: 170vh; }
    .spark svg { height: 120px; } .mark { transform: none; left: 0 !important; } .mark.hi { top: 4px; }
    .lb { font-size: 13px; }
  }
</style>
