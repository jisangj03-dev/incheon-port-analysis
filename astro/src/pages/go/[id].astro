---
// 바깥 링크 이동 지면(개편 기준 22·29) — 이 지면의 방문 수 = 그 링크의 클릭 수(Cloudflare 분석 · 쿠키 0).
// [2026-10-15 P1 ⑤] 뉴스레터 「차단됨」 — 미리보기(샌드박스 틀) 안에서 beehiiv 로 넘어가면 beehiiv 가 틀 안 표시를 거부해 「차단됨」이 떴다. 공개판은 최상위 창이라 넘어간다.
//   그래서 바닥글 구독 링크는 새 창으로 열고(target=_blank · rel=noopener), 이 지면의 손 링크는 최상위 창(_top)으로 연다. 자동 이동(meta refresh)은 그대로 — 방문 수 = 클릭 수.
// LIVE 가 꺼진 링크(크몽 판매 동선 · 2026-10-14 걷음)는 주소만 살리고 첫 화면으로 돌려보낸다(기존 주소 유지).
import Base from "../../layouts/Base.astro";
import Redirect from "../../layouts/Redirect.astro";
import { OUT } from "../../lib/site";
export function getStaticPaths() {
  return Object.entries(OUT).filter(([, v]) => v.url).map(([id, v]) => ({ params: { id }, props: { to: v.url, label: v.label, live: v.live } }));
}
const { to, label, live } = Astro.props;
const { id } = Astro.params;
// 조사 — 이름의 마지막 한글 음절에 받침이 있으면(ㄹ 받침 빼고) 「으로」, 아니면 「로」(10/22 B8 화면 판정 경미: 「(으)로」 틀이 그대로 보였다)
const ro = (() => { const ch = [...label].reverse().find((c) => c >= "가" && c <= "힣"); if (!ch) return "(으)로"; const jong = (ch.charCodeAt(0) - 0xac00) % 28; return jong === 0 || jong === 8 ? "로" : "으로"; })();
---
{live ? (
<Base title={`${label}로 이동`} description={`측심에서 ${label}${ro} 이동합니다.`} path={`/go/${id}.html`} noindex studio>
  <Fragment slot="head"><meta http-equiv="refresh" content={`1;url=${to}`} /></Fragment>
  <div class="s-wrap" style="padding-top:64px;padding-bottom:64px">
    <p class="s-cap">바깥 링크</p>
    <h1 class="s-prose">{label}{ro} 이동합니다</h1>
    <p class="s-lead s-prose">바로 넘어가지 않으면 <a href={to} rel="noopener" target="_top">여기를 누르세요</a>. 측심 밖의 지면입니다.</p>
  </div>
</Base>
) : (
<Redirect path={`/go/${id}.html`} to="/" label="첫 화면" why="이 링크는 더 이상 쓰지 않습니다." />
)}
