---
// 공유 카드 틀(B6) — 보고서마다 1200×630. 빌드 뒤 tests/capture/og-cards.mjs 가 이 지면을 찍어 og/<id>.jpg 로 바꾸고
// 이 HTML 은 지운다(공개 배포물에 틀이 남지 않는다). 수치를 새로 만들지 않는다 — 발행본의 제목·한 줄 결론 그대로.
import { getCollection } from "astro:content";
import { title, splitTitle, conclusion, lede } from "../../lib/content";
import { u, BRAND } from "../../lib/site";
export async function getStaticPaths() {
  return (await getCollection("reports")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const body = entry.body ?? "";
const { no, text } = splitTitle(title(body));
let line = conclusion(body) || lede(body);
if (line.length > 120) line = line.slice(0, 118) + "…";
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="robots" content="noindex" /><title>{text}</title>
  <link rel="stylesheet" href={u("/fonts/pretendard/pretendard.css")} />
  <style>
    /* 2026-10-20 — 옛 남색 「SOUNDING」 틀을 도구·홈 카드와 같은 바탕(종이·붉은 윗줄)으로 */
    html, body { margin: 0; }
    body { width: 1200px; height: 630px; overflow: hidden; background: #f5f2eb; color: #191714; font-family: "Pretendard Variable", Pretendard, "Noto Sans CJK KR", "Noto Sans KR", sans-serif; word-break: keep-all; }
    .c { position: relative; box-sizing: border-box; width: 1200px; height: 630px; padding: 56px 72px 48px; display: flex; flex-direction: column; border-top: 10px solid #b3361e; }
    .grid { position: absolute; inset: 0; opacity: .5; pointer-events: none; }
    .eb, h1, p, .foot { position: relative; }
    .eb { font-size: 22px; font-weight: 600; color: #5b554c; letter-spacing: .02em; }
    h1 { margin: 14px 0 0; font-size: 52px; line-height: 1.22; letter-spacing: -0.03em; font-weight: 800; max-width: 1050px;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    p { margin: 22px 0 0; font-size: 25px; line-height: 1.5; color: #3a352e; max-width: 1050px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .foot { margin-top: auto; display: flex; justify-content: space-between; font-size: 19px; color: #5b554c; }
    .foot strong { color: #191714; font-weight: 800; font-size: 22px; }
  </style>
</head>
<body>
  <div class="c" data-og-ready>
    <svg class="grid" viewBox="0 0 1200 630" preserveAspectRatio="none" aria-hidden="true">
      {Array.from({ length: 7 }, (_, k) => <path d={`M${560 + k * 90} 640 C ${700 + k * 70} 420, ${820 + k * 50} 260, 1210 ${120 + k * 40}`} fill="none" stroke="#191714" stroke-opacity="0.07" stroke-width="1.5" />)}
    </svg>
    <div class="eb">{no ? `보고서 ${no}` : "정리형 스냅샷"}</div>
    <h1>{text}</h1>
    {line && <p>{line}</p>}
    <div class="foot"><span><strong>{BRAND.name}</strong> · 공공 1차 데이터로 움직이는 SCM 작업실</span><span>기준은 데이터보다 먼저 커밋</span></div>
  </div>
</body>
</html>
