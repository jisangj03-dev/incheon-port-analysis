---
// 도구 · 환율 파도 + 수입원가 계산기(2차 · 실무 질문 Q5) — 과세환율이 바뀌면 같은 물건의 수입 원가(과세가격 + 관세 + 부가세)가 얼마나 바뀌나.
// 원천 = 관세청 고시 과세환율(수입 · 주간) · 파생 = data/derived/import_cost.json(tools-build/v3/fx_derive.py · 첫 화면 예시도 거기서 계산).
// 운임지수(KCCI 등)는 이용 조건을 원문으로 확인하지 못해 싣지 않는다(선커밋 §3) — 운임은 직접 넣는다. 참고용 · 자문 아님(지면 안에 적는다).
import Studio from "../../layouts/Studio.astro";
import ToolShell from "../../components/scene/ToolShell.astro";
import { u } from "../../lib/site";
import { sourceLine } from "../../lib/sources";
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";
const D = JSON.parse(readFileSync(join(repoRoot(), "data/derived/import_cost.json"), "utf-8"));
// 관세율표 스냅샷(있을 때만) — HS 코드 → 기본·WTO·FTA 세율 자동 채움(P1 ② · tools-build/tariff_fetch.py --build)
const TC = existsSync(join(repoRoot(), "data/derived/tariff_codes.json")) ? JSON.parse(readFileSync(join(repoRoot(), "data/derived/tariff_codes.json"), "utf-8")) : null;
const E = D.example, Wk = D.weeks as (string | number)[][];
const day = (s: string) => `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}`;
const won = (v: number) => v.toLocaleString("ko-KR");
const sign = (v: number) => (v > 0 ? "+" : v < 0 ? "−" : "");
// 환율 선(USD) — 서버에서 그린다(정지 화면 먼저)
const VW = 1000, VH = 260, P = { l: 46, r: 10, t: 16, b: 26 };
const us = Wk.map((w) => Number(w[1])), lo = Math.floor(Math.min(...us) / 20) * 20, hi = Math.ceil(Math.max(...us) / 20) * 20;
const X = (i: number) => P.l + (i / (Wk.length - 1)) * (VW - P.l - P.r), Y = (v: number) => P.t + (1 - (v - lo) / (hi - lo)) * (VH - P.t - P.b);
const path = us.map((v, i) => `${i ? "L" : "M"}${X(i).toFixed(1)} ${Y(v).toFixed(1)}`).join("");
const iAgo = Wk.findIndex((w) => w[0] === E.ago.week), iNow = Wk.length - 1;
const ticks: number[] = []; for (let v = lo; v <= hi; v += 40) ticks.push(v);
// 운임 파도 — KCCI(한국해양진흥공사 · 지수 · 달러 운임 아님). 없으면 칸을 그리지 않는다
const K = D.kcci as any;
const kLine = (ci: number) => { if (!K) return ""; const v = K.weeks.map((w: any[]) => Number(w[ci + 1])).filter((x: number) => x > 0), mx = Math.max(...v), mn = Math.min(...v);
  return K.weeks.map((w: any[], i: number) => `${i ? "L" : "M"}${((i / (K.weeks.length - 1)) * 1000).toFixed(1)} ${(8 + (1 - (Number(w[ci + 1]) - mn) / (mx - mn || 1)) * 104).toFixed(1)}`).join(""); };
const lastK = K ? K.weeks[K.weeks.length - 1] : null;
// 운임 차트 축(화면 판정 10/20 — 선만 있어 크기를 못 읽었다): 세로 = 그 항로의 최고·최저 지수 · 가로 = 처음·마지막 주
const kRange = (ci: number) => { const v = K.weeks.map((w: any[]) => Number(w[ci + 1])).filter((x: number) => x > 0); return [Math.max(...v), Math.min(...v)].map((x) => Math.round(x).toLocaleString("ko-KR")); };
---
<Studio title="환율 파도와 수입원가 — 환율이 바뀌면 원가가 얼마나 바뀌나" description="관세청 과세환율(주간)과 품목번호별 관세율표로 같은 물건의 수입 원가(과세가격·관세·내국세·부가세)를 주마다 다시 계산한다 — HS 코드를 넣으면 관세율이 채워진다. 참고용 · 자문 아님." current="tools" ogImage="/og/tool-import-cost.jpg" lateFonts>
  <ToolShell id="cost" who="수입 담당 · 셀러 · 구매" asOf={day(D.asof)} advice
    q="환율이 바뀌면 내 수입 원가가 얼마나 바뀌나?"
    lead={`같은 1만 달러(CIF) 물건을 최근 공시 주(${day(E.now.week)}) 과세환율로 들이면 원가(부가세 제외) ${won(E.now.cost)}원 — ${E.ago_weeks}주 전 주보다 ${sign(E.diff)}${won(Math.abs(E.diff))}원(${E.pct > 0 ? "+" : ""}${E.pct}%). 관세 ${E.duty_pct}% · 부가세 ${E.vat_pct}% 예시.`}
    updated={D.fetched} source={[sourceLine("kcs-exchange"), K && sourceLine("kobc-kcci"), TC && sourceLine("kcs-tariff")].filter(Boolean).join(" · ")} csv={u("/data/import-cost.csv")} csvName="kcs-customs-fx-weekly.csv" note="수입 · 주간 · 원/통화 1단위(JPY 1엔)"
    how="적용 환율 = 수입신고일이 속한 주의 관세청 고시 과세환율(관세법 제18조 · 매주 고시 · 지난주 기준환율 평균). 과세가격 = CIF 가격 × 과세환율(원 미만 버림) · 관세 = 과세가격 × 관세율 · 개별소비세·주세 = (과세가격 + 관세) × 세율 · 교육세 = 개별소비세 × 30%(일부 15%) + 주세 × 10%(주세율 70% 초과 30%) · 농어촌특별세 = 개별소비세 × 세율 · 부가가치세 = (과세가격 + 관세 + 개별소비세 + 주세 + 교육세 + 농특세) × 10%. 세액마다 10원 미만 버림(국고금 관리법 제47조). FOB 를 고르면 넣은 운임·보험료를 더해 CIF 로 바꾼다."
    limits={`원가는 부가세를 뺀 값이다 — 수입 부가세는 사업자가 매입세액으로 공제받는다(간이과세·면세 사업자·개인 수입은 다르다). 통관 때 실제로 내는 돈은 「납부 합계」 줄이다. 내국세(개별소비세·주세·교육세·농특세)는 대상 품목일 때만 세율을 넣는다 — 기본값 0(일반 공산품) · 맥주·탁주 같은 종량세 주류는 이 식 밖이다. ${TC ? "HS 코드를 넣으면 관세청 품목번호별 관세율표(유효분)에서 기본·WTO·FTA 세율을 찾아 낮은 쪽을 넣는다 — FTA 협정세율은 원산지증명이 있을 때만. 할당·조정·덤핑방지관세·감면은 넣지 않았다. " : "FTA 협정세율·감면·할당관세는 넣지 않았다. 관세율은 품목(HS)마다 다르므로 직접 넣어야 한다 — 8% 는 예시다. "}운임·보험료·국내 운송·통관비의 기본값은 0 이다 — 공공 기준값을 확인하지 못해 임의 값을 넣지 않았다(보험료는 보험증권, 통관 수수료는 관세사 견적을 넣는다). 끝수 규칙(과세가격 원 미만 · 세액 10원 미만 버림)은 법령 원문을 이 세션에서 열지 못해 검색으로 확인한 것이다. 관세사 실제 신고 건과 원 단위 대조는 아직 하지 않았다. ${K ? "운임 파도(KCCI)는 지수(포인트)라 달러 운임이 아니다 — 운임 칸 제안은 지수 변동률만 곱한다. 마지막 반영 주는 원천의 마지막 주 그대로다. " : "운임지수는 아직 싣지 않았다(운임은 직접 넣는다). "}실제 납부액은 수입신고 때 세관이 정한다.`}>
    <div slot="answer" class="cost">
      <p class="cost__big"><b id="cs-diff" data-og-num={`원가 차이 · 1만 달러 물건 · ${day(E.ago.week)} 주 대비`} class={E.diff > 0 ? "up" : "dn"}>{sign(E.diff)}{won(Math.abs(E.diff))}<small>원</small></b>
        <span>1만 달러 물건 원가 · <span id="cs-wk">{day(E.ago.week)}</span> 주 대비 최근 공시 주</span></p>
      <figure class="cost__fig" id="cs-fig">
        <div class="cost__plot">
        <div class="ax" data-furniture>{ticks.map((v) => <span class="ax__y" style={`top:${((Y(v) / VH) * 100).toFixed(2)}%`}>{v}</span>)}{Wk.map((w, i) => String(w[0]).slice(4, 6) === "01" && Number(String(w[0]).slice(6, 8)) <= 7 && <span class="ax__x" style={`left:${((X(i) / VW) * 100).toFixed(2)}%`}>{String(w[0]).slice(0, 4)}</span>)}</div>
        <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" class="cost__svg" aria-hidden="true">

          <path d={path} class="ln" pathLength="1" />
          <line id="cs-ago" x1={X(iAgo).toFixed(1)} x2={X(iAgo).toFixed(1)} y1={P.t} y2={VH - P.b} class="mk" />
          <circle cx={X(iNow).toFixed(1)} cy={Y(us[iNow]).toFixed(1)} r="5" class="now" />
          <circle id="cs-dot" cx={X(iAgo).toFixed(1)} cy={Y(us[iAgo]).toFixed(1)} r="6" class="dot" />
          {ticks.map((v) => <line x1={P.l} x2={VW - P.r} y1={Y(v).toFixed(1)} y2={Y(v).toFixed(1)} class="g" />)}
        </svg>
        </div>
        <figcaption class="s-cap">과세환율(수입) 원/달러 · 주마다 · 최근 공시 주 {day(D.asof)} {E.now.fx}원 · {E.ago_weeks}주 전 {E.ago.fx}원 · 가장 높았던 주 {day(D.usd_hi.week)} {D.usd_hi.fx}원</figcaption>
      </figure>
    </div>
    <div slot="controls" class="cost__ctl">
      <form id="cs-form" class="cost__form" onsubmit="return false">
        <label>통화 <select name="cur">{D.currencies.map((c: string) => <option value={c}>{c === "JPY" ? "JPY(1엔)" : c}</option>)}</select></label>
        <label>물품 가격 <input name="goods" type="number" inputmode="decimal" min="0" step="any" value={E.goods} /></label>
        <label>조건 <select name="incoterm"><option value="CIF">CIF(운임·보험 포함)</option><option value="FOB">FOB(운임·보험 따로)</option></select></label>
        <label>운임(같은 통화) <input name="freight" type="number" inputmode="decimal" min="0" step="any" value="0" /></label>
        <label>보험료(같은 통화) <input name="insurance" type="number" inputmode="decimal" min="0" step="any" value="0" /></label>
        {TC && <div class="cost__hs">
          <label>HS 코드(10자리) <input name="hs" type="text" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="예: 8471300000" autocomplete="off" /></label>
          <label class="cost__co"><input name="co" type="checkbox" aria-describedby="cs-co-note" /> FTA 협정세율로 보기</label>
          <p class="s-cap cost__co-note" id="cs-co-note">원산지증명서 등 원산지증빙서류를 갖추고 협정관세 적용을 신청한 경우(FTA 관세특례법) — 이 칸은 요건을 갖췄다고 보고 세율만 바꿉니다.</p>
          <label>적용 세율 <select name="rate_pick" disabled><option>HS 코드를 넣으면 고를 수 있습니다</option></select></label>
          <p class="s-cap cost__hs-note" id="cs-hs-note">관세청 품목번호별 관세율표({TC.asof.slice(0, 4)}-{TC.asof.slice(4, 6)}-{TC.asof.slice(6, 8)} 기준 유효분)에서 찾아 관세율 칸을 채웁니다.</p>
        </div>}
        <label>관세율 % <input name="duty_pct" type="number" inputmode="decimal" min="0" max="1000" step="any" value={E.duty_pct} /></label>
        <label>국내 운송·통관비(원) <input name="inland" type="number" inputmode="numeric" min="0" step="1000" value="0" /></label>
        <details class="cost__more"><summary>＋ 내국세 넣기 <small>개별소비세·주세 대상 품목만 · 기본 0%</small></summary>
          <div class="cost__more-g">
            <label>개별소비세율 % <input name="excise_pct" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" /></label>
            <label>교육세율 %(개소세분) <input name="edu_pct" type="number" inputmode="decimal" min="0" max="100" step="any" value="30" /></label>
            <label>농어촌특별세율 %(개소세분) <input name="rural_pct" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" /></label>
            <label>주세율 %(종가세 주류) <input name="liquor_pct" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" /></label>
            <label>교육세율 %(주세분) <input name="liquor_edu_pct" type="number" inputmode="decimal" min="0" max="100" step="any" value="10" /></label>
          </div>
        </details>
        <label class="cost__wk">견줄 주 <input name="wk" type="range" min="0" max={Wk.length - 1} value={iAgo} step="1" aria-label="견줄 주 고르기" /></label>
      </form>
      <table class="cost__tbl" aria-live="polite">
        <thead><tr><th></th><th id="cs-h-a">견줄 주</th><th id="cs-h-b">최근 공시 주</th></tr></thead>
        <tbody id="cs-body"></tbody>
      </table>
      <p class="s-cap">입력은 이 브라우저 안에서만 계산합니다(어디에도 보내지 않습니다).</p>
    </div>
    {K && <section class="wave" id="wave" aria-labelledby="wave-h">
      <h2 class="s-cap" id="wave-h">운임 파도 · {K.names[K.routes[0]] ? "KCCI" : ""} 컨테이너 운임지수(부산 기점) · 마지막 반영 주 <b class="wave__asof">{K.last_week}</b>{K.lag_weeks > 0 && <span class="wave__lag"> · 발표 예정 주보다 {K.lag_weeks}주 늦음</span>}</h2>
      <div class="wave__row">
        <label>항로 <select id="wave-r">{K.routes.map((r: string, i: number) => <option value={i}>{K.names[r]}</option>)}</select></label>
        <p class="wave__now"><b id="wave-v">{lastK[1].toLocaleString("ko-KR")}</b><small>포인트</small> · 52주 전 대비 <b id="wave-c">{K.chg_52w_pct[K.routes[0]] > 0 ? "+" : ""}{K.chg_52w_pct[K.routes[0]]}%</b></p>
        <button type="button" class="s-btn s-btn--ghost" id="wave-apply">운임 칸에 변동률 적용 제안</button>
      </div>
      <div class="wave__plot">
        <p class="wave__y" aria-hidden="true"><span id="wave-max">{kRange(0)[0]}</span><span id="wave-min">{kRange(0)[1]}</span></p>
        <svg viewBox="0 0 1000 120" preserveAspectRatio="none" class="wave__svg" aria-hidden="true"><line x1="0" x2="1000" y1="8" y2="8" /><line x1="0" x2="1000" y1="112" y2="112" /><path id="wave-l" d={kLine(0)} /></svg>
        <p class="wave__x" aria-hidden="true"><span>{K.first_week}</span><span>{K.last_week}</span></p>
      </div>
      <p class="s-cap wave__note" id="wave-note"><b>지수는 달러 운임이 아닙니다.</b> 제안은 견줄 주 → 마지막 반영 주의 지수 변동률을 지금 운임 칸 값에 곱한 것뿐입니다. 출처 한국해양진흥공사 KCCI(공공데이터포털) · {K.first_week}~{K.last_week} 주간.</p>
    </section>}
  </ToolShell>
  <span id="cs-tariff-base" hidden data-u={u("/data/tariff/")}></span>
  <script type="application/json" id="cs-kcci" set:html={JSON.stringify(K ? { routes: K.routes, names: K.names, weeks: K.weeks } : null)}></script>
  <script type="application/json" id="cs-data" set:html={JSON.stringify({ weeks: Wk, cur: D.currencies, iAgo, box: { VW, VH, P, lo, hi } })}></script>
  <script>
    import { pace, paused } from "../../lib/motion";
    import { landedCost } from "../../lib/import-cost";
    const C = JSON.parse(document.getElementById("cs-data")!.textContent!), $ = (id: string) => document.getElementById(id)!;
    const f = $("cs-form") as HTMLFormElement, W = C.weeks as any[][], B = C.box, last = W.length - 1;
    const day = (s: string) => `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}`;
    const won = (v: number) => Math.round(v).toLocaleString("ko-KR");
    const X = (i: number) => B.P.l + (i / last) * (B.VW - B.P.l - B.P.r), Y = (v: number) => B.P.t + (1 - (v - B.lo) / (B.hi - B.lo)) * (B.VH - B.P.t - B.P.b);
    const val = (n: string) => Number((f.elements.namedItem(n) as HTMLInputElement).value) || 0;
    const calc = (i: number) => { const ci = 1 + C.cur.indexOf((f.elements.namedItem("cur") as HTMLSelectElement).value);
      return { fx: Number(W[i][ci]), ...landedCost({ goods: val("goods"), freight: val("freight"), insurance: val("insurance"), incoterm: (f.elements.namedItem("incoterm") as HTMLSelectElement).value as any, fx: Number(W[i][ci]), duty_pct: val("duty_pct"), inland_krw: val("inland"),
        excise_pct: val("excise_pct"), edu_pct: val("edu_pct"), rural_pct: val("rural_pct"), liquor_pct: val("liquor_pct"), liquor_edu_pct: val("liquor_edu_pct") }) }; };
    const render = (i: number) => {
      const a = calc(i), b = calc(last), d = b.cost - a.cost;
      $("cs-diff").innerHTML = `${d > 0 ? "+" : d < 0 ? "−" : ""}${won(Math.abs(d))}<small>원</small>`; $("cs-diff").className = d > 0 ? "up" : "dn";
      $("cs-wk").textContent = day(W[i][0]); $("cs-h-a").textContent = `${day(W[i][0])} 주`; $("cs-h-b").textContent = `${day(W[last][0])} 주`;
      const inner: [string, number, number][] = ([["개별소비세", a.excise, b.excise], ["주세", a.liquor, b.liquor], ["교육세", a.edu, b.edu], ["농어촌특별세", a.rural, b.rural]] as [string, number, number][]).filter((r) => r[1] || r[2]);
      const rows: [string, number, number][] = [["과세환율", a.fx, b.fx], ["과세가격", a.customs_value, b.customs_value], ["관세", a.duty, b.duty], ...inner, ["부가가치세", a.vat, b.vat], ["납부 합계(세금 포함)", a.landed, b.landed], ["원가(부가세 제외)", a.cost, b.cost]];
      $("cs-body").innerHTML = rows.map(([k, x, y]) => `<tr${k.startsWith("원가") ? ' class="sum"' : k.startsWith("납부") ? ' class="paid"' : ""}><th>${k}</th><td>${k === "과세환율" ? x : won(x)}</td><td>${k === "과세환율" ? y : won(y)}</td></tr>`).join("");
      const dot = $("cs-dot"), ago = $("cs-ago"), usd = Number(W[i][1]);
      dot.setAttribute("cx", X(i).toFixed(1)); dot.setAttribute("cy", Y(usd).toFixed(1)); ago.setAttribute("x1", X(i).toFixed(1)); ago.setAttribute("x2", X(i).toFixed(1));
    };
    const wk = f.elements.namedItem("wk") as HTMLInputElement;
    // HS 코드 → 관세율표(류별 파일 · 같은 사이트) — 기본(A)·WTO(C)는 낮은 쪽이 원칙(관세법 제50조) · FTA 협정세율은 원산지증명이 있을 때만 고를 수 있다
    const hsIn = f.elements.namedItem("hs") as HTMLInputElement | null;
    if (hsIn) {
      const pick = f.elements.namedItem("rate_pick") as HTMLSelectElement, co = f.elements.namedItem("co") as HTMLInputElement, note = $("cs-hs-note");
      const base = (document.getElementById("cs-tariff-base") as HTMLElement).dataset.u!;
      const cache: Record<string, any> = {};
      // 관세율구분 코드 → 읽을 이름 — 코드 끝의 나라 약어로 붙인다(관세청 원문 코드를 괄호에 같이 · FRC = RCEP · FCE = 한-중미 · FEF = EFTA · FAS = 아세안)
      const CC: Record<string, string> = { US: "미국", CN: "중국", VN: "베트남", AU: "호주", CA: "캐나다", NZ: "뉴질랜드", PE: "페루", CL: "칠레", CO: "콜롬비아", TR: "튀르키예", IL: "이스라엘", KH: "캄보디아", PH: "필리핀", ID: "인도네시아", IN: "인도", SG: "싱가포르", JP: "일본", AS: "아세안", EU: "EU", GB: "영국", NI: "니카라과", PA: "파나마", CR: "코스타리카", HN: "온두라스", SV: "엘살바도르", EF: "EFTA" };
      const ftaName = (k: string) => { const m = k.match(/^F(RC|CE|EF)?([A-Z]{2})?/); const grp = m?.[1] === "RC" ? "RCEP" : m?.[1] === "CE" ? "한-중미 FTA" : m?.[1] === "EF" ? "EFTA FTA" : "FTA"; const c = m?.[2] && CC[m[2]]; return `${grp}${c ? `·${c}` : ""}(${k})`; };
      const fill = async () => {
        const hs = hsIn.value.replace(/\D/g, "");
        if (hs.length !== 10) return;
        const ch = hs.slice(0, 2);
        try { cache[ch] ??= await fetch(`${base}${ch}.json`).then((r) => (r.ok ? r.json() : {})); } catch { cache[ch] = {}; }
        const R = cache[ch][hs];
        if (!R) { pick.disabled = true; pick.innerHTML = "<option>관세율표에 없는 번호</option>"; note.textContent = `${hs} — 관세율표(유효분)에서 찾지 못했습니다. 관세율 칸에 직접 넣으세요.`; return; }
        const pct = (v: any) => (typeof v === "number" ? `${v}%` : "종량세(계산 밖)");
        const num = (v: any) => (typeof v === "number" ? v : Infinity);
        const opts: [string, string, number][] = [];
        if ("A" in R) opts.push(["A", `기본세율 ${pct(R.A)}`, num(R.A)]);
        if ("C" in R) opts.push(["C", `WTO 협정세율 ${pct(R.C)}`, num(R.C)]);
        const fta = Object.entries(R).filter(([k]) => k.startsWith("F")).sort((a, b) => num(a[1]) - num(b[1]));
        for (const [k, v] of fta) opts.push([k, `${ftaName(k)} ${pct(v)}${co.checked ? "" : " — 원산지증명 필요"}`, num(v)]);
        const ok = opts.filter(([k]) => !k.startsWith("F") || co.checked).filter((o) => isFinite(o[2]));
        const best = ok.sort((a, b) => a[2] - b[2])[0];
        pick.disabled = false;
        pick.innerHTML = opts.map(([k, t, v]) => `<option value="${k}" data-v="${v}"${k.startsWith("F") && !co.checked ? " disabled" : ""}${best && k === best[0] ? " selected" : ""}>${t}</option>`).join("");
        if (best) { (f.elements.namedItem("duty_pct") as HTMLInputElement).value = String(best[2]); }
        note.textContent = `${hs} — ${best ? `가장 낮은 적용 가능 세율 ${best[2]}%(${best[0] === "A" ? "기본" : best[0] === "C" ? "WTO 협정" : `FTA ${best[0]}`})를 관세율 칸에 넣었습니다.` : "종가세 세율이 없습니다(종량세)."} 할당·조정·덤핑방지관세는 반영하지 않았습니다.`;
        render(Number(wk.value));
      };
      hsIn.addEventListener("input", fill); co.addEventListener("change", fill);
      pick.addEventListener("change", () => { const o = pick.selectedOptions[0]; if (o && isFinite(Number(o.dataset.v))) { (f.elements.namedItem("duty_pct") as HTMLInputElement).value = o.dataset.v!; render(Number(wk.value)); } });
    }
    f.addEventListener("input", () => render(Number(wk.value)));
    // 3초 답 — 선이 그어지고, 점이 2024년 첫 주부터 52주 전 주까지 환율 파도를 탄다(원가 차이가 같이 바뀐다)
    const boot = () => {
      render(C.iAgo); $("cs-fig").classList.add("go");
      if (paused()) return; // 멈춤을 골랐으면 그대로 · 동작 줄이기 = 천천히(품질기준 Q7)
      let i = 0; const t = setInterval(() => { render(i); wk.value = String(i); i += 2; if (i >= C.iAgo) { clearInterval(t); render(C.iAgo); wk.value = String(C.iAgo); } }, 40 / pace());
      (window as any).__cost = { render };
    };
    document.readyState === "complete" ? setTimeout(boot, 200) : addEventListener("load", () => setTimeout(boot, 200), { once: true });
    // 운임 파도 — 항로를 고르면 선·숫자가 바뀌고, 「제안」은 견줄 주(환율 막대와 같은 날 무렵) → 마지막 반영 주 변동률을 운임 칸에 곱한다
    const KW = JSON.parse(document.getElementById("cs-kcci")!.textContent!);
    if (KW) {
      const sel = $("wave-r") as HTMLSelectElement;
      const col = () => Number(sel.value) + 1;
      const near = (ymd: string) => { const d = `${ymd.slice(0, 4)}-${ymd.slice(4, 6)}-${ymd.slice(6, 8)}`; let b = 0; KW.weeks.forEach((w: any[], i: number) => { if (w[0] <= d) b = i; }); return b; };
      const drawK = () => {
        const c = col(), v = KW.weeks.map((w: any[]) => Number(w[c])), mx = Math.max(...v), mn = Math.min(...v), n = v.length;
        $("wave-l").setAttribute("d", v.map((y: number, i: number) => `${i ? "L" : "M"}${((i / (n - 1)) * 1000).toFixed(1)} ${(8 + (1 - (y - mn) / (mx - mn || 1)) * 104).toFixed(1)}`).join(""));
        const last = v[n - 1], a = v[Math.max(0, n - 53)];
        $("wave-max").textContent = Math.round(mx).toLocaleString("ko-KR"); $("wave-min").textContent = Math.round(mn).toLocaleString("ko-KR");
        $("wave-v").textContent = Math.round(last).toLocaleString("ko-KR"); $("wave-c").textContent = `${last >= a ? "+" : ""}${(100 * (last / a - 1)).toFixed(1)}%`;
      };
      sel.addEventListener("change", drawK);
      $("wave-apply").addEventListener("click", () => {
        const c = col(), i0 = near(String(W[Number(wk.value)][0])), v0 = Number(KW.weeks[i0][c]), v1 = Number(KW.weeks[KW.weeks.length - 1][c]);
        const fr = f.elements.namedItem("freight") as HTMLInputElement, cur = Number(fr.value) || 0, r = v0 ? v1 / v0 : 1;
        if (!cur) { $("wave-note").firstElementChild!.textContent = "운임 칸에 먼저 견줄 주의 운임을 넣으세요."; return; }
        fr.value = String(Math.round(cur * r)); (f.elements.namedItem("incoterm") as HTMLSelectElement).value = "FOB";
        $("wave-note").firstElementChild!.textContent = `${KW.names[KW.routes[c - 1]]} 지수 ${KW.weeks[i0][0]} → ${KW.weeks[KW.weeks.length - 1][0]} ${r >= 1 ? "+" : ""}${(100 * (r - 1)).toFixed(1)}% 를 운임 칸에 곱했습니다(지수는 달러 운임이 아닙니다).`;
        render(Number(wk.value));
      });
    }
  </script>
