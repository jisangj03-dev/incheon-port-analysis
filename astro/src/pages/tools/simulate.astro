---
// 셀러 물류비 몬테카를로(개편 2단계 · 시뮬레이션 1) — 계산기 입력(?s=)을 그대로 받아, 물량 변동과 '모름' 칸의 폭만큼 흔들어 본다.
// 계산 = assets/js/cost-check.js(split·perUnitAt) + assets/js/cost-sim.js(흔들기). 바깥 숫자(업계 평균·요율) 0 · 외부 요청 0.
import Base from "../../layouts/Base.astro";
import Updated from "../../components/Updated.astro";
import { lastUpdated } from "../../lib/content";
import { u } from "../../lib/site";
const updated = lastUpdated("assets/js/cost-sim.js");
---
<Base title="물류비 시뮬레이션 — 견적이 흔들리면 누가 싼가" description="3PL 견적 셋을 물량 변동과 견적서의 '모름' 칸 폭만큼 4,000번 흔들어, 어느 견적이 가장 쌀 확률과 건당 비용의 폭(P10~P90)을 본다. 입력값은 서버로 가지 않는다." path="/tools/simulate.html" surface="light">
  <div class="sim wrap">
    <p class="eyebrow">셀러 물류 도구 · 시뮬레이션</p>
    <h1>견적이 흔들리면, 누가 싼가</h1>
    <p class="lede">계산기는 한 가지 물량·한 가지 금액으로 답합니다. 여기서는 <strong>월 출고가 오르내리고</strong>, 견적서에 없는 <strong>'모름' 칸이 0원부터 상한까지</strong> 어디든 될 수 있다고 보고 4,000번 다시 계산합니다. 바깥 숫자(업계 평균·요율)는 넣지 않습니다 — 흔드는 폭도 당신이 정합니다.</p>

    <section class="panel" aria-labelledby="h-in">
      <h2 id="h-in">흔드는 폭</h2>
      <p class="note" id="src-note">계산기에서 넣은 값이 없으면 <a href={u("/tools/logistics-cost.html")}>계산기</a>에서 먼저 넣거나, 가상 예시로 봅니다.</p>
      <div class="row">
        <div>
          <label for="swing">월 출고 변동폭(±%)</label>
          <select id="swing"><option value="0">0% — 물량 고정</option><option value="0.1">±10%</option><option value="0.2" selected>±20%</option><option value="0.3">±30%</option><option value="0.5">±50%</option></select>
        </div>
        {[0, 1, 2].map((b) => (
          <div>
            <label for={`cap-${b}`}><span data-name={b}>견적</span> '모름' 상한(원/건)</label>
            <input id={`cap-${b}`} inputmode="numeric" autocomplete="off" placeholder="비우면 자동" />
          </div>
        ))}
      </div>
      <p class="note">상한을 비우면 그 견적의 '모름' 칸들이 <em>순위가 뒤집히는 금액의 두 배</em>까지 갈 수 있다고 봅니다(계산기의 「뒤집히는 선」에서 나온 값 · '모름' 칸이 없으면 0).</p>
      <div class="btns"><button type="button" id="run" class="primary">4,000번 돌리기</button> <button type="button" id="sample">가상 예시로 보기</button></div>
    </section>

    <section class="panel" aria-labelledby="h-out" data-chart="sim">
      <h2 id="h-out">결과</h2>
      <p id="verdict" class="verdict" aria-live="polite">아직 안 돌렸습니다.</p>
      <div class="tbl"><table>
        <thead><tr><th scope="col">견적</th><th scope="col" class="num">가장 쌀 확률</th><th scope="col" class="num">건당 P10</th><th scope="col" class="num">P50</th><th scope="col" class="num">P90</th></tr></thead>
        <tbody id="rows"></tbody>
      </table></div>
      <div id="hist" class="hist" role="img" aria-label="견적별 건당 비용 분포"></div>
      <Updated date={updated} source="계산식 · 씨앗 고정(같은 입력 = 같은 결과)" />
    </section>

    <section class="after">
      <h2>읽는 법</h2>
      <ul>
        <li><strong>가장 쌀 확률</strong>이 한 견적에 몰려 있으면 흔들어도 답이 안 바뀝니다. 반반이면 '모름' 칸을 업체에 물어보는 것이 계약보다 먼저입니다.</li>
        <li>P10~P90 은 4,000번 중 가운데 80%가 들어간 건당 비용의 폭입니다. 폭이 넓은 견적은 청구서가 달마다 출렁일 수 있습니다.</li>
        <li>이 결과는 「당신이 모르는 폭이 이만하면」의 답이지, 업체의 실제 청구액 예측이 아닙니다. 계약·세무 판단의 근거가 아닙니다.</li>
      </ul>
      <p><a href={u("/tools/logistics-cost.html")} id="back">← 계산기로 돌아가기</a></p>
    </section>
  </div>
  <script is:inline defer src={u("/assets/js/cost-check.js")}></script>
  <script is:inline defer src={u("/assets/js/cost-sim.js")}></script>
  <script>
    import { initSim } from "../../lib/sim-ui";
    initSim();
  </script>
</Base>
<style>
  .sim { padding-top: 2rem; }
  .sim h1 { margin-top: 0.2em; }
  .lede { max-width: 64ch; }
  .panel { background: var(--hull); border: 1px solid var(--hair); border-radius: var(--r-md); padding: 1.1rem 1.2rem; margin: 1.2rem 0; }
  .panel h2 { font-size: 1.1rem; margin: 0 0 0.6rem; }
  .row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
  label { display: block; font-size: 0.84rem; font-weight: 650; color: var(--ink); margin-bottom: 0.25rem; }
  input, select { width: 100%; min-height: 44px; font: inherit; font-size: 16px; color: var(--ink); background: var(--deep); border: 1px solid var(--hair-strong); border-radius: var(--r-sm); padding: 0.4rem 0.55rem; }
  input { text-align: right; font-variant-numeric: tabular-nums; }
  .note { font-size: 0.85rem; color: var(--mist); margin: 0.5rem 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
  button { min-height: 44px; font: inherit; font-weight: 700; font-size: 0.92rem; border-radius: 999px; border: 1px solid var(--sonar); background: var(--hull); color: var(--sonar); padding: 0.4rem 1rem; cursor: pointer; }
  button.primary { background: var(--sonar); color: var(--sonar-ink); }
  .verdict { font-size: 1.05rem; font-weight: 700; color: var(--ink); }
  .tbl { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; min-width: 420px; }
  th, td { border-bottom: 1px solid var(--hair); padding: 0.5rem 0.6rem; text-align: left; }
  .num, :global(td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  .hist { margin-top: 0.8rem; overflow: hidden; }
  .hist :global(svg) { max-width: 100%; height: auto; }
  .after { max-width: 760px; }
  @media (max-width: 720px) { .row { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 400px) { .row { grid-template-columns: 1fr; } }
</style>
