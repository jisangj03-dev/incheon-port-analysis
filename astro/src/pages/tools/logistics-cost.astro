---
// 셀러 물류비 자가진단 v2(2026-10-12) — 개편 기준 3·4·5·6·7·8.
//  3 첫 답 5칸 이하: 월 출고 건수 + 빠른 칸 넷(출고 단가·보관비·포장재·월 고정비). 정밀 10항목은 펼침.
//  4 결과가 입력과 같은 화면: 넓은 화면은 오른쪽 고정, 모바일은 아래 고정 띠(건당 세 값).
//  5 세 견적 동시 비교 + 손익분기 그래프(월 출고 건수 → 건당 비용).
//  6 계산은 assets/js/cost-check.js 하나(엑셀 가상 샘플 4,044/2,805/2,960 · tests/cost.spec.mjs COST_ADAPTER=v2).
//  7 '모름' 칸·숨은 비용은 결과 카드 바로 옆 경고.
//  8 입력값은 주소(?s=)에만 — 서버 저장 0. 외부 요청 0(분석 비컨 하나는 기준 17 예외).
import Base from "../../layouts/Base.astro";
import Updated from "../../components/Updated.astro";
import { createRequire } from "node:module";
import { join } from "node:path";
import { repoRoot, lastUpdated } from "../../lib/content";
import { u, go, OUT, abs } from "../../lib/site";

const C = createRequire(import.meta.url)(join(repoRoot(), "assets/js/cost-check.js"));
const ITEMS: [string, string, string, string][] = C.ITEMS;
const OPTS: string[] = C.OPTS;
const BLOCKS: string[] = C.BLOCKS;
const HIDDEN: { key: string; name: string; slot: number; how: string }[] = C.HIDDEN;
const HIDDEN_OPTS: string[] = C.HIDDEN_OPTS;
// 빠른 칸 넷 — 정밀 10항목 중 견적서에 가장 먼저 적히는 것(칸 번호는 0부터). unit = 화면에 적는 단위.
const QUICK = [
  { i: 0, label: "출고 단가", unit: "원/건", hint: "택배비 포함 여부는 견적서 표기대로" },
  { i: 2, label: "보관비", unit: "원/월", hint: "한 달 보관료 합계" },
  { i: 3, label: "포장재", unit: "원/건", hint: "박스·완충재" },
  { i: 6, label: "월 고정비", unit: "원/월", hint: "기본료·시스템 이용료" },
];
const updated = lastUpdated("assets/js/cost-check.js");
const path = "/tools/logistics-cost.html";
const links = ["criteria", "sheet", "kmong-829076", "kmong-824011"].filter((k) => OUT[k].live);
const jsonld = [{
  "@context": "https://schema.org", "@type": "WebApplication", name: "셀러 물류비 자가진단 — 3PL 견적 비교 계산기",
  applicationCategory: "BusinessApplication", operatingSystem: "Web", inLanguage: "ko", isAccessibleForFree: true, url: abs(path),
  offers: { "@type": "Offer", price: 0, priceCurrency: "KRW" },
}];
---
<Base title="셀러 물류비 자가진단 — 3PL 견적 비교 계산기" description="3PL·풀필먼트 견적서 세 장을 한 화면에서 비교한다. 5칸이면 건당 총비용이 나오고, 월 몇 건부터 어느 쪽이 싼지 그래프로 본다. 입력값은 서버로 가지 않는다." path={path} surface="light" jsonld={jsonld}>
  <div class="cc wrap" id="cc">
    <header class="cc-head">
      <p class="eyebrow">셀러 물류 도구</p>
      <h1>3PL 견적, 건당 얼마인가</h1>
      <p class="lede">출고 단가만 나란히 놓으면 견적이 비교되지 않습니다. 월 출고 건수와 빠른 칸 넷이면 <strong>건당 총비용</strong>이 나오고, 견적 셋을 한 화면에서 비교합니다. 입력값은 이 화면 밖으로 나가지 않습니다(주소에만 담깁니다).</p>
    </header>

    <div class="cc-grid">
      <div class="cc-in">
        <section class="cc-panel" aria-labelledby="h-base">
          <h2 id="h-base" class="cc-h">1. 내 물량</h2>
          <div class="cc-row2">
            <div>
              <label for="ship">월 출고 건수 <span class="req">필수</span></label>
              <input id="ship" inputmode="numeric" autocomplete="off" placeholder="예: 1,000" />
            </div>
            <div>
              <label for="ret">월 반품 건수</label>
              <input id="ret" inputmode="numeric" autocomplete="off" placeholder="모르면 비워 두기" />
            </div>
          </div>
          <div class="cc-btns">
            <button type="button" id="sample">가상 예시 넣기</button>
            <button type="button" id="clear">모두 비우기</button>
          </div>
          <p class="cc-note" id="sample-note" hidden><strong>가상값</strong>입니다 — 실제 업체 견적이 아닙니다(출고 1,000건·반품 30건 셀러가 견적 두 곳을 받은 경우).</p>
        </section>

        <section class="cc-panel" aria-labelledby="h-quick">
          <h2 id="h-quick" class="cc-h">2. 견적서에서 네 칸만</h2>
          <p class="cc-note">비워 둔 칸은 0원이 아니라 「아직 안 적음」입니다. 견적서에 그 항목이 없으면 정밀 10항목에서 「없음」·「모름」을 고르세요.</p>
          <div class="qk" role="group" aria-label="빠른 입력 — 견적 셋 동시">
            <div class="qk__hd" aria-hidden="true"><span></span>{BLOCKS.map((b) => <span>{b}</span>)}</div>
            {QUICK.map((q) => (
              <div class="qk__row">
                <div class="qk__lab"><strong>{q.label}</strong><span>{q.unit} · {q.hint}</span></div>
                {BLOCKS.map((b, bi) => (
                  <div class="qk__cell">
                    <label class="sr" for={`q-${bi}-${q.i}`}>{b} {q.label}({q.unit})</label>
                    <input id={`q-${bi}-${q.i}`} data-b={bi} data-i={q.i} data-quick inputmode="numeric" autocomplete="off" placeholder={b} />
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>

        <details class="fold cc-precise" id="precise">
          <summary>3. 정밀 10항목 · 숨은 비용 4종 펼치기 (견적서 표기 그대로)</summary>
          <div class="fold__body">
            <p class="cc-note">칸마다 견적서 표기를 넷 중 하나로 고릅니다. <strong>별도</strong> = 따로 청구(단가·수량) · <strong>단가에 포함</strong> = 출고 단가 안에 있음 · <strong>없음</strong> = 청구 안 함 · <strong>모름</strong> = 견적서에 안 적힘(업체에 물어볼 칸). 수량을 비우면 출고·반품 건수를 따라갑니다.</p>
            <div class="seg" role="tablist" aria-label="정밀 입력할 견적">
              {BLOCKS.map((b, bi) => <button type="button" role="tab" id={`pt-${bi}`} aria-controls={`pp-${bi}`} aria-selected={bi === 0 ? "true" : "false"} tabindex={bi === 0 ? 0 : -1}>{b}</button>)}
            </div>
            {BLOCKS.map((b, bi) => (
              <div class="pp" id={`pp-${bi}`} role="tabpanel" aria-labelledby={`pt-${bi}`} hidden={bi !== 0}>
                {ITEMS.map((it, i) => (
                  <div class="pr">
                    <p class="pr__t"><strong>{i + 1}. {it[0]}</strong> <span>청구 단위: {it[1]}</span></p>
                    <div class="pr__g">
                      <div><label for={`p-${bi}-${i}-m`}>표기</label>
                        <select id={`p-${bi}-${i}-m`} data-b={bi} data-i={i} data-k="0"><option value="">고르기</option>{OPTS.map((o) => <option>{o}</option>)}</select></div>
                      <div><label for={`p-${bi}-${i}-p`}>단가(원)</label>
                        <input id={`p-${bi}-${i}-p`} data-b={bi} data-i={i} data-k="1" inputmode="numeric" autocomplete="off" /></div>
                      <div><label for={`p-${bi}-${i}-q`}>월 수량</label>
                        <input id={`p-${bi}-${i}-q`} data-b={bi} data-i={i} data-k="2" inputmode="numeric" autocomplete="off" placeholder={it[2] === "ship" ? "출고 건수" : it[2] === "ret" ? "반품 건수" : it[2] === "one" ? "1" : ""} /></div>
                    </div>
                  </div>
                ))}
                <h3 class="cc-h3">계약 전 확인 — 숨은 비용 4종</h3>
                <p class="cc-note">화주가 청구서를 받고 놀라는 넷(3PL 운영 실무자 답신의 구조만 옮겼고 금액은 받지 않았습니다). 있으면 금액을 9·10번 칸에, 모르면 질문 목록에 들어갑니다.</p>
                {HIDDEN.map((x) => (
                  <div class="pr">
                    <label for={`h-${bi}-${x.key}`}><strong>{x.name}</strong> <span class="cc-note">(금액은 {x.slot}번 칸)</span></label>
                    <p class="cc-note">{x.how}</p>
                    <select id={`h-${bi}-${x.key}`} data-b={bi} data-h={x.key}><option value="">고르기</option>{HIDDEN_OPTS.map((o) => <option>{o}</option>)}</select>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </details>
      </div>

      <aside class="cc-out" aria-labelledby="h-res">
        <div class="cc-sticky">
          <h2 id="h-res" class="cc-h">결과 — 건당 총비용</h2>
          <div id="cards" class="cards" aria-live="polite">
            {BLOCKS.map((b, bi) => (
              <div class="rc" id={`res-${bi}`} data-block={bi}>
                <p class="rc__n">{b}</p>
                <p class="rc__big"><span data-per>—</span></p>
                <p class="rc__sub" data-monthly-line>아직 비어 있음</p>
                <p class="rc__sub" data-diff hidden></p>
                <p class="rc__warn" data-unknown hidden></p>
                <p class="rc__warn" data-gaps hidden></p>
              </div>
            ))}
          </div>
          <p id="flip" class="cc-flip"></p>
          <div class="be">
            <h3 class="cc-h3">손익분기 — 월 몇 건부터 어느 쪽이 싼가</h3>
            <p id="be-text" class="be__text">견적 둘 이상을 채우면 나옵니다.</p>
            <div id="be-chart" class="be__chart" role="img" aria-labelledby="be-text"></div>
            <Updated date={updated} source="계산식" />
          </div>
          <div class="cc-btns">
            <button type="button" id="share" class="primary">공유 링크 복사</button>
            <button type="button" id="copyq" hidden>업체에 물어볼 것 복사</button>
            <a class="simlink" id="simlink" href={u("/tools/simulate.html")}>흔들어 보기(시뮬레이션) →</a>
          </div>
          <p class="cc-note" id="status" role="status"></p>
        </div>
      </aside>
    </div>

    <section class="cc-panel" id="qs-box" hidden aria-labelledby="h-qs">
      <h2 id="h-qs" class="cc-h">업체에 물어볼 것</h2>
      <div id="qs"></div>
    </section>

    <section class="cc-after">
      <h2>결과를 읽는 법</h2>
      <p>건당 합계는 판정 기준 넷 가운데 첫째(건당 총물류비)만 맞춥니다. 출고에 드는 시간, 비슷한 셀러들 사이에서 내 단가 위치, 옮기는 비용(입고 작업·옮긴 뒤 오출고 책임)까지 보면 결론이 &lsquo;옮긴다&rsquo;가 아니라 &lsquo;지금 업체와 재협상&rsquo;일 때도 많습니다. 손익분기 선은 칸마다 수량을 비워 둔 칸(출고·반품 건수를 따라가는 칸)만 물량에 비례한다고 보고 그립니다.</p>
      {links.length > 0 && (
        <ul class="cc-next">
          {links.map((k) => <li><a href={go(k)}>{OUT[k].label}</a></li>)}
        </ul>
      )}
      <h2>표기</h2>
      <table class="cc-table">
        <thead><tr><th scope="col">항목</th><th scope="col">내용</th></tr></thead>
        <tbody>
          <tr><td>계산</td><td><code>assets/js/cost-check.js</code> 하나 — 엑셀 「3PL 견적 비교표」 가상 샘플과 같은 답(4,044 / 2,805 / 2,960원)을 자동 시험이 고정한다(<code>tests/cost.spec.mjs</code>).</td></tr>
          <tr><td>칸 목록 출처</td><td>셀러 설문 문항 선택지 8개 + 출고 기본 단가 + 3PL 운영 실무자 답신(2026-10-07, 이름 비공개)의 숨은 비용 구조. 금액·요율은 담지 않았다 — 숫자는 전부 쓰는 사람이 넣는다.</td></tr>
          <tr><td>개인정보</td><td>입력값은 브라우저 안에서만 계산되고 주소(<code>?s=</code>)에만 담긴다. 서버 저장 0 · 쿠키 0.</td></tr>
          <tr><td>자문 아님</td><td>계약·세무 판단의 근거가 아니라 견적 비교를 돕는 계산이다.</td></tr>
          <tr><td>판정 기준</td><td><a href={u("/docs/물류사업_갈래_판정기준_선커밋_20261009.html")}>갈래 기준</a> · <a href={u("/docs/측심_전면개편_판정기준_선커밋_20261010.html")}>개편 기준</a></td></tr>
        </tbody>
      </table>
    </section>
  </div>

  <div class="dock" id="dock" aria-hidden="true">
    {BLOCKS.map((b, bi) => <div><span>{b}</span><strong data-dock={bi}>—</strong></div>)}
  </div>

  <script is:inline defer src={u("/assets/js/cost-check.js")}></script>
  <script>
    import { initCalc } from "../../lib/calc-ui";
    initCalc();
  </script>
</Base>

<style>
  .cc { padding-top: 2rem; padding-bottom: 6rem; }
  .cc-head h1 { margin: 0.2em 0 0.4em; }
  .cc-head .lede { max-width: 62ch; }
  .cc-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; margin-top: 1.5rem; }
  .cc-panel { background: var(--hull); border: 1px solid var(--hair); border-radius: var(--r-md); padding: 1.1rem 1.2rem; margin-bottom: 1rem; }
  .cc-h { font-size: 1.05rem; margin: 0 0 0.6rem; }
  .cc-h3 { font-size: 0.98rem; margin: 1.2rem 0 0.4rem; }
  .cc label { display: block; font-size: 0.86rem; font-weight: 650; color: var(--ink); margin-bottom: 0.25rem; }
  .cc input, .cc select { width: 100%; min-height: 44px; font: inherit; font-size: 16px; color: var(--ink); background: var(--deep); border: 1px solid var(--hair-strong); border-radius: var(--r-sm); padding: 0.4rem 0.55rem; }
  .cc input[inputmode="numeric"] { text-align: right; font-variant-numeric: tabular-nums; }
  .cc input:focus-visible, .cc select:focus-visible, .cc button:focus-visible { outline: 3px solid var(--sonar); outline-offset: 1px; }
  .cc button { min-height: 44px; font: inherit; font-weight: 700; font-size: 0.92rem; border-radius: 999px; border: 1px solid var(--sonar); background: var(--hull); color: var(--sonar); padding: 0.4rem 0.95rem; cursor: pointer; }
  .cc button.primary { background: var(--sonar); color: var(--sonar-ink); }
  .cc-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .cc-note { font-size: 0.85rem; color: var(--mist); margin: 0.4rem 0; }
  .req { font-size: 0.72rem; color: var(--sonar); font-weight: 700; margin-left: 0.25rem; }
  .cc-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .sr { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .qk { display: grid; gap: 0.5rem; }
  .qk__hd, .qk__row { display: grid; grid-template-columns: minmax(0, 1.1fr) repeat(3, minmax(0, 1fr)); gap: 0.45rem; align-items: center; }
  .qk__hd span { font-size: 0.8rem; font-weight: 700; color: var(--mist); text-align: center; }
  .qk__lab strong { display: block; color: var(--ink); font-size: 0.92rem; }
  .qk__lab span { display: block; font-size: 0.74rem; color: var(--mist); line-height: 1.35; }
  .qk__cell input::placeholder { color: var(--mist); opacity: 0.75; font-size: 0.8rem; text-align: right; }

  .seg { display: flex; gap: 0.25rem; margin: 0.75rem 0; border-bottom: 1px solid var(--hair-strong); }
  .seg button { flex: 1; border: 0; border-radius: var(--r-sm) var(--r-sm) 0 0; background: transparent; color: var(--mist); }
  .seg button[aria-selected="true"] { color: var(--ink); background: var(--hull-2); box-shadow: inset 0 -3px 0 var(--sonar); }
  .pr { border-bottom: 1px solid var(--hair); padding: 0.7rem 0; }
  .pr__t { margin: 0 0 0.4rem; font-size: 0.9rem; color: var(--ink); }
  .pr__t span { font-size: 0.78rem; color: var(--mist); font-weight: 400; }
  .pr__g { display: grid; grid-template-columns: 1.2fr 1fr 0.8fr; gap: 0.45rem; }
  .pr__g label { font-size: 0.74rem; font-weight: 500; color: var(--mist); }

  .cc-sticky { position: sticky; top: 76px; background: var(--hull); border: 1px solid var(--hair-strong); border-radius: var(--r-lg); padding: 1.1rem 1.2rem; box-shadow: 0 10px 40px rgba(11, 26, 38, 0.08); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
  .rc { border: 1px solid var(--hair); border-radius: var(--r-md); padding: 0.7rem 0.65rem; background: var(--deep); min-width: 0; }
  .rc.is-best { border-color: var(--pass); box-shadow: inset 0 0 0 1px var(--pass); }
  .rc__n { margin: 0; font-size: 0.8rem; font-weight: 700; color: var(--mist); }
  .rc__big { margin: 0.15rem 0; font-size: clamp(1.25rem, 2.4vw, 1.75rem); font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; line-height: 1.2; }
  .rc__big small { font-size: 0.7rem; font-weight: 600; color: var(--mist); }
  .rc__sub { margin: 0.1rem 0; font-size: 0.76rem; color: var(--text); font-variant-numeric: tabular-nums; line-height: 1.4; }
  .rc__warn { margin: 0.35rem 0 0; font-size: 0.76rem; font-weight: 650; color: var(--fail); line-height: 1.4; }
  .simlink { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 0.92rem; }
  .cc-flip { font-size: 0.85rem; color: var(--text); margin: 0.6rem 0 0; }
  .be { margin-top: 0.8rem; border-top: 1px solid var(--hair); padding-top: 0.4rem; }
  .be__text { font-size: 0.9rem; color: var(--ink); font-weight: 600; margin: 0.2rem 0 0.5rem; }
  .be__chart { min-height: 40px; overflow: hidden; }
  .be__chart :global(svg) { max-width: 100%; height: auto; }
  .cc-after { max-width: 760px; margin-top: 2.5rem; }
  .cc-next li { margin: 0.4rem 0; }
  .cc-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; display: block; overflow-x: auto; }
  .cc-table th, .cc-table td { border: 1px solid var(--hair); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }

  .dock { display: none; }
  @media (max-width: 900px) {
    .cc-grid { grid-template-columns: 1fr; }
