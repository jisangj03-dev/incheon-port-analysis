---
// 도구 · 인천항 일일 맥박(1차 · 실무 질문 Q1) — [2026-10-20 품질기준 Q4] PortWatch 는 약 열흘 늦게 공개된다 → 「지금」이 아니라 「공개된 마지막 일주일」. 인천항에 배가 평소보다 많이 들어오나 · 부산·평택과 견주면.
// 원천 = IMF PortWatch 일별 입항(AIS 추정) · 파생 = data/derived/port_pulse.json(tools-build/v3/pulse_derive.py · 「평소」 = 선커밋 §4).
// 첫 그림 = 서버에서 그린 SVG(정지 화면) · 움직임 = 막대가 자라고 이동평균 선이 그어지는 CSS · 조작 뒤에는 같은 함수로 다시 그린다.
import Studio from "../../layouts/Studio.astro";
import ToolShell from "../../components/scene/ToolShell.astro";
import { u } from "../../lib/site";
import { sourceLine } from "../../lib/sources";
import { pulseSvg, sparkSvg, ranges } from "../../lib/pulse-chart";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";
const D = JSON.parse(readFileSync(join(repoRoot(), "data/derived/port_pulse.json"), "utf-8"));
const P = D.ports, I = P.Incheon, J = I.judge;
const order = ["Incheon", "Busan", "Pyeongtaek"].filter((k) => P[k]?.judge);
const sign = (x: number) => (x > 0 ? `+${x}` : x < 0 ? `−${-x}` : `${x}`); // 마이너스는 U+2212(하이픈은 숫자와 떨어져 보인다 · 화면 판정 10/20)
const md = (d: string) => `${Number(d.slice(5, 7))}월 ${Number(d.slice(8, 10))}일`;
const tops = D.types.map((t: any) => ({ ...t, r: J.by_type[t.id], b: J.base_by_type[t.id] })).filter((t: any) => t.b > 0.5);
const big = [...tops].sort((a: any, b: any) => Math.abs(b.r - b.b) - Math.abs(a.r - a.b))[0];
const oddOf = (k: string) => (P[k].check?.odd || []) as string[];
const odds = order.filter((k) => oddOf(k).length).map((k) => `${P[k].ko} ${ranges(oddOf(k))}`);
// 어긋난 달이 「평소」 판정 구간(평소 첫날 ~ 최근 끝날)에 드는가 — 들면 판정 옆에 그대로 적는다
const inJudge = order.filter((k) => oddOf(k).some((m) => m >= P[k].judge.base_from.slice(0, 7) && m <= P[k].judge.recent_to.slice(0, 7))).map((k) => P[k].ko);
const client = { types: D.types, rule: D.rule, ports: Object.fromEntries(order.map((k) => [k, { ko: P[k].ko, days: P[k].days, odd: oddOf(k), stale_to: P[k].stale_to }])) };
---
<Studio title="인천항 일일 맥박 — 마지막 공개 일주일, 배가 평소보다 많이 들어왔나" description="IMF PortWatch 일별 입항으로 인천항의 최근 7일을 직전 13주 평소와 견주고, 부산·평택과 나란히 본다." current="tools" ogImage="/og/tool-port-pulse.jpg" lateFonts>
  <ToolShell id="pulse" who="포워더 · 선사 · 터미널" asOf={D.asof} q="PortWatch가 공개한 마지막 일주일, 인천항에 배가 평소보다 많이 들어왔나?"
    lead={`${md(J.recent_from)}~${md(J.recent_to)} 하루 평균 ${J.recent_avg}척 — 평소(직전 13주) ${J.base_avg}척보다 ${sign(J.pct)}%, ${J.word}.`}
    updated={D.fetched} source={sourceLine("imf-portwatch")} csv={u("/data/port-pulse.csv")} csvName="port-pulse-incheon-busan-pyeongtaek.csv" note="일별 · AIS 기반 추정 · 며칠 늦게 갱신"
    how={`IMF PortWatch 가 선박 위치 신호(AIS)로 항만마다 하루 입항 척수를 센 값을 받아, 원천의 마지막 날짜까지 7일 평균을 그 앞 91일(13주) 평균과 견줬다. ±${D.rule.threshold_pct}% 를 넘으면 「많다·적다」, 그 안이면 「평소 수준」 — 이 문턱은 숫자를 보기 전에 정했다.`}
    limits="오늘이 아니라 원천의 마지막 날짜(머리의 「○일 기준」)까지다. AIS 를 끈 배·작은 배는 빠질 수 있고, 연안 여객선은 세지 않는다. 추정 교역량(톤)은 PortWatch 의 모델 추정치라 관세청 통계와 다르다.">
    <div slot="answer" class="pulse">
      <p class="pulse__word"><b class={J.pct > D.rule.threshold_pct ? "up" : J.pct < -D.rule.threshold_pct ? "dn" : ""} id="pl-pct" data-og-num={`${J.word} · 인천항 마지막 공개 7일 입항`}>{sign(J.pct)}%</b> <span id="pl-word">{J.word}</span>
        <small id="pl-sub">마지막 7일 {J.recent_avg}척/일 · 평소 {J.base_avg}척/일{big && ` · 하루 척수가 가장 크게 바뀐 선종(차이 기준) = ${big.ko}(${big.r} ← ${big.b})`}</small></p>
      <figure class="pulse__fig" id="pl-fig" data-port="Incheon">
        <div id="pl-chart" set:html={pulseSvg(I.days, "all", 182, D.rule.recent, D.rule.base, oddOf("Incheon"))} />
        <figcaption class="s-cap"><span class="k k--bar"></span>일별 입항 척수 <span class="k k--line"></span>7일 평균 <span class="k k--avg"></span>평소(직전 13주 평균) <span class="k k--rec"></span>최근 7일 · {D.asof} 기준</figcaption>
      </figure>
      <ol class="pulse__cmp" aria-label="부산·평택과 견줌(각자의 평소 대비)">
        {order.map((k) => { const j = P[k].judge; return <li data-port={k} class={k === "Incheon" ? "on" : ""}><button type="button" data-port={k} aria-pressed={k === "Incheon" ? "true" : "false"}>
          <b>{P[k].ko}</b><i class={j.pct > D.rule.threshold_pct ? "up" : j.pct < -D.rule.threshold_pct ? "dn" : ""}>{sign(j.pct)}%</i><span>{j.recent_avg}척/일 · 평소 {j.base_avg}{P[k].stale_to && <em class="stale"> · {P[k].stale_to}까지</em>}</span>
          <Fragment set:html={sparkSvg(P[k].days)} /></button></li>; })}
      </ol>
      {inJudge.length > 0 && <p class="s-cap pulse__odd">{inJudge.join("·")}은 원천 수집이 흔들린 달이 「평소」 구간에 들어 이 판정을 덜 믿어야 합니다(아래 「원천 점검」).</p>}
    </div>
    <div slot="controls" class="pulse__ctl">
      <label>선종 <select id="pl-type"><option value="all">전체</option>{D.types.map((t: any) => <option value={t.id}>{t.ko}</option>)}</select></label>
      <div class="seg" role="group" aria-label="기간">{[[91, "13주"], [182, "6개월"], [365, "1년"]].map(([n, l]) => <button type="button" class={n === 182 ? "s-btn" : "s-btn s-btn--ghost"} data-span={n} aria-pressed={n === 182 ? "true" : "false"}>{l}</button>)}</div>
      <p class="s-cap pulse__trade" id="pl-trade">인천 추정 교역량(마지막 7일 하루 평균 · 모델 추정치) — 수입 {J.imp_avg ? J.imp_avg.toLocaleString("ko-KR") : "—"}톤 · 수출 {J.exp_avg ? J.exp_avg.toLocaleString("ko-KR") : "—"}톤</p>
    </div>
    {odds.length > 0 && <p slot="more" class="pulse__odd" data-odd>원천 점검 — 해양수산부 월 외항 입항과 견줘 PortWatch 가 {D.ports.Incheon.check.threshold_pct}% 넘게 어긋난 달(그래프에서 흐리게): {odds.join(" / ")}. 해수부 통계에는 같은 변동이 없어 원천의 수집·집계 변동으로 보입니다(원인 미확인). {inJudge.length ? `${inJudge.join("·")}은 그 달이 「평소」 판정 구간에 들어 판정을 덜 믿어야 합니다.` : "어긋난 달은 지금 「평소」 판정 구간에 들지 않습니다."}</p>}
  </ToolShell>
  <script type="application/json" id="pl-data" set:html={JSON.stringify(client)}></script>
  <script>
    import { pulseSvg, judgeOf, mean } from "../../lib/pulse-chart";
    const C = JSON.parse(document.getElementById("pl-data")!.textContent!), $ = (id: string) => document.getElementById(id)!;
    const R = C.rule, st = { port: "Incheon", type: "all", span: 182 };
    const sign = (x: number) => (x > 0 ? "+" : x < 0 ? "−" : "") + Math.abs(x).toFixed(1);
    const fmt = (v: number) => Math.round(v).toLocaleString("ko-KR");
    const draw = (anim = true) => {
      const p = C.ports[st.port], j = judgeOf(p.days, st.type, R.recent, R.base, R.threshold_pct);
      const fig = $("pl-fig"); fig.dataset.port = st.port; fig.classList.toggle("go", false);
      const box = $("pl-chart"); box.innerHTML = pulseSvg(p.days, st.type, st.span, R.recent, R.base, p.odd, Math.max(320, Math.round(box.clientWidth)), Math.round(Math.max(200, Math.min(320, innerHeight * 0.34))));
      const tk = st.type === "all" ? "" : `${C.types.find((t: any) => t.id === st.type).ko} `;
      $("pl-pct").textContent = `${sign(j.pct)}%`; $("pl-pct").className = j.pct > R.threshold_pct ? "up" : j.pct < -R.threshold_pct ? "dn" : "";
      $("pl-word").textContent = `${p.ko} ${tk}${j.word}`;
      $("pl-sub").textContent = `마지막 7일 ${j.r.toFixed(1)}척/일 · 평소 ${j.b.toFixed(1)}척/일` + (p.stale_to ? ` · ${p.stale_to}까지(원천 질의 실패로 지난 자료)` : "");
      const im = mean(p.days.slice(-7).map((x: any) => x.imp)), ex = mean(p.days.slice(-7).map((x: any) => x.exp));
      $("pl-trade").textContent = `${p.ko} 추정 교역량(마지막 7일 하루 평균 · 모델 추정치) — 수입 ${im ? fmt(im) : "—"}톤 · 수출 ${ex ? fmt(ex) : "—"}톤`;
      if (anim && !matchMedia("(prefers-reduced-motion: reduce)").matches) requestAnimationFrame(() => requestAnimationFrame(() => fig.classList.add("go"))); else fig.classList.add("go", "still");
    };
    for (const b of document.querySelectorAll<HTMLButtonElement>(".pulse__cmp button")) b.addEventListener("click", () => {
      st.port = b.dataset.port!; for (const x of document.querySelectorAll<HTMLButtonElement>(".pulse__cmp button")) { x.setAttribute("aria-pressed", String(x === b)); x.parentElement!.classList.toggle("on", x === b); } draw();
    });
    ($("pl-type") as HTMLSelectElement).addEventListener("change", (e) => { st.type = (e.target as HTMLSelectElement).value; draw(); });
    for (const b of document.querySelectorAll<HTMLButtonElement>(".seg button")) b.addEventListener("click", () => {
      st.span = Number(b.dataset.span); for (const x of document.querySelectorAll<HTMLButtonElement>(".seg button")) { const on = x === b; x.setAttribute("aria-pressed", String(on)); x.classList.toggle("s-btn--ghost", !on); } draw();
    });
    let rz: any; addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(() => draw(false), 200); });
    // 3초 답 — 첫 그림(서버 SVG)은 이미 보인다. 다 뜬 뒤 막대가 자라고 선이 그어진다(다시 재생).
    const go = () => { $("pl-fig").classList.add("ready"); draw(true); (window as any).__pulse = st; };
    document.readyState === "complete" ? setTimeout(go, 150) : addEventListener("load", () => setTimeout(go, 150), { once: true });
  </script>
</Studio>
<style>
  .pulse { display: grid; gap: var(--s-4); }
  .pulse__word { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .pulse__word b { font-size: clamp(38px, 5vw, 64px); font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .pulse__word b.up { color: var(--s-signal); } .pulse__word b.dn { color: #3f6476; }
  .pulse__word span { font-size: clamp(18px, 2vw, 24px); font-weight: 600; }
  .pulse__word small { flex-basis: 100%; color: var(--s-ink-2); font-size: 14.5px; font-variant-numeric: tabular-nums; }
  .pulse__fig { margin: 0; }
  .pulse__fig :global(.pulse__svg) { display: block; width: 100%; height: clamp(200px, 34vh, 320px); }
  .pulse__fig :global(.pg) { stroke: var(--s-rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .pulse__fig :global(.pt) { font: 500 11px var(--s-font); fill: var(--s-ink-3); }
  .pulse__fig :global(.pr) { fill: rgba(179, 54, 30, 0.07); }
  .pulse__fig :global(.pb rect) { fill: #b8b0a0; transform-box: fill-box; transform-origin: 50% 100%; }
  .pulse__fig :global(.pb rect.on) { fill: var(--s-signal); }
  .pulse__fig :global(.pb rect.odd) { fill: #ddd6c8; }
  .pulse__odd { margin: 0; max-width: 52rem; }
  .pulse__cmp .stale { font-style: normal; color: var(--s-signal); }
  .pulse__fig :global(.pa) { stroke: #191714; stroke-width: 1.4; stroke-dasharray: 5 4; vector-effect: non-scaling-stroke; }
  .pulse__fig :global(.pa-t) { fill: #191714; font-weight: 600; }
  .pulse__fig :global(.pl) { fill: none; stroke: #191714; stroke-width: 2; vector-effect: non-scaling-stroke; }
  /* 움직임 — 준비되면 0 에서 자라 오른다(스크립트가 없으면 정지 화면 그대로) */
  .pulse__fig.ready:not(.go) :global(.pb rect) { transform: scaleY(0); }
  .pulse__fig.ready:not(.go) :global(.pl) { clip-path: inset(0 100% 0 0); }
  .pulse__fig.go:not(.still) :global(.pb rect) { animation: pl-grow 0.7s cubic-bezier(.3,.7,.2,1) both; animation-delay: calc(var(--i) * 6ms); }
  .pulse__fig.go:not(.still) :global(.pl) { animation: pl-draw 1.6s 0.4s ease-out both; }
  @keyframes pl-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes pl-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .pulse__fig figcaption { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
  .k { display: inline-block; width: 14px; height: 10px; margin-right: -6px; }
  .k--bar { background: #b8b0a0; } .k--line { height: 2px; background: #191714; } .k--avg { height: 0; border-top: 2px dashed #191714; } .k--rec { background: var(--s-signal); }
  .pulse__cmp { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .pulse__cmp button { width: 100%; text-align: left; display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; align-items: baseline; padding: 10px 12px; border: 1px solid var(--s-rule); background: var(--s-paper); cursor: pointer; font: inherit; color: inherit; min-height: 44px; }
  .pulse__cmp li.on button { border-color: #191714; box-shadow: inset 0 0 0 1px #191714; }
  .pulse__cmp b { font-size: 17px; } .pulse__cmp i { font-style: normal; font-weight: 700; font-size: 20px; font-variant-numeric: tabular-nums; justify-self: end; }
  .pulse__cmp i.up { color: var(--s-signal); } .pulse__cmp i.dn { color: #3f6476; }
  .pulse__cmp span { grid-column: 1 / -1; font-size: 12.5px; color: var(--s-ink-3); font-variant-numeric: tabular-nums; }
  .pulse__cmp :global(.pulse__spark) { grid-column: 1 / -1; width: 100%; height: 44px; }
  .pulse__cmp :global(.pulse__spark .pa) { stroke: var(--s-ink-3); stroke-width: 1; stroke-dasharray: 3 3; }
  .pulse__cmp :global(.pulse__spark .pl) { fill: none; stroke: #191714; stroke-width: 1.6; }
  .pulse__ctl { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: end; }
  .pulse__ctl label { display: grid; gap: 4px; font-size: var(--s-t-cap); color: var(--s-ink-3); }
  .pulse__ctl select { min-height: 44px; font: inherit; color: var(--s-ink); padding: 0 10px; border: 1px solid var(--s-rule); background: var(--s-paper); }
  .seg { display: flex; } .seg .s-btn { min-height: 44px; }
  .pulse__trade { flex-basis: 100%; margin: 0; }
  @media (max-width: 720px) { .pulse__cmp { grid-template-columns: 1fr 1fr 1fr; gap: 6px; } .pulse__cmp button { padding: 8px; } .pulse__cmp b { font-size: 14px; } .pulse__cmp i { font-size: 16px; } .pulse__cmp span { font-size: 11px; } }
</style>
