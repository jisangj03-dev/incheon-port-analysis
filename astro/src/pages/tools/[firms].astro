---
// 도구 · 인천 물류기업 카드(③-나 · OpenDART) — 공시 수치를 옮길 뿐 계산·평가하지 않는다. 고르는 규칙 = 선커밋 ③-나 상세(여기서 바꾸지 않는다).
// 표본이 5곳 미만이면(data/derived/incheon_firms.json ok=false) 지면을 만들지 않는다 — 그래서 고정 주소 대신 getStaticPaths 로 연다.
// 대표자·임원·전화·홈페이지·상세 주소는 수집 단계에서 이미 버렸다. 정렬은 가나다 순만(순위·추천처럼 읽히지 않게).
import Studio from "../../layouts/Studio.astro";
import ToolShell from "../../components/scene/ToolShell.astro";
import { u } from "../../lib/site";
import { sourceLine } from "../../lib/sources";
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";

export function getStaticPaths() {
  const p = join(repoRoot(), "data/derived/incheon_firms.json");
  const D = existsSync(p) ? JSON.parse(readFileSync(p, "utf-8")) : null;
  return D?.ok ? [{ params: { firms: "incheon-firms" }, props: { D } }] : [];
}
const { D } = Astro.props as { D: any };
const F = D.firms as any[];
const divs = Object.values(D.rule.ksic2) as string[];
const cnt = Object.fromEntries(divs.map((d) => [d, F.filter((f) => f.division === d).length]));
const shown = divs.filter((d) => cnt[d]);
const top = Math.max(1, ...shown.map((d) => cnt[d]));
const won = (v: number | null | undefined) => (v == null ? "—" : `${v.toLocaleString("ko-KR")}원`);
const ROWS: [string, string][] = [["revenue", "매출액"], ["op", "영업이익"], ["net", "당기순이익"], ["assets", "자산총계"]];
const snap = D.snapshot.slice(0, 10);
---
<Studio title="인천 물류기업 카드 — 인천 본점 운수·창고 법인의 공시 수치" description="최근 사업보고서를 낸 법인 가운데 본점이 인천이고 업종이 운수·창고인 곳의 주요계정을 OpenDART 공시 그대로 옮깁니다. 투자 권유 아님." current="tools" ogImage="/og/tool-incheon-firms.jpg" lateFonts>
  <ToolShell id="incheon-firms" who="물류·SCM 실무 · 채용 담당 · 기자" asOf={`${snap} 스냅샷`}
    q="인천에 본점을 둔 물류 법인은 공시에 어떤 숫자를 냈나?"
    lead={`지난 12개월 사업보고서를 낸 법인 ${D.filers.toLocaleString("ko-KR")}곳 가운데 본점이 인천이고 업종이 운수·창고(KSIC 49~52)인 곳 ${D.n}곳. 공시 수치를 그대로 옮겼습니다 — 투자 권유가 아니며 정본은 공시 원문입니다.`}
    updated={snap} source={sourceLine("opendart")} csv={u("/data/incheon-firms.csv")} csvName="incheon-firms.csv" note={`${snap} 스냅샷 · 가나다 순`}
    how={`빌드 전에 Actions 가 OpenDART 에서 지난 12개월 사업보고서 접수 목록을 3개월 창 넷으로 받고, 법인마다 기업개황의 본점 주소와 업종코드로 골랐다(인천 ∩ KSIC 49·50·51·52). 고른 곳은 최근 사업보고서의 단일회사 주요계정(연결이 있으면 연결)을 옮겼다. 규칙은 데이터를 보기 전에 적었다.`}
    limits="업종코드만으로 고른다 — 지주회사나 물류 자회사를 둔 다른 업종 법인은 빠지고, 업종코드가 운수·창고여도 사업 내용은 다를 수 있다. 사업보고서를 내지 않는 법인(외감만 하는 곳 등)은 없다. 수치는 사업연도 결산 기준이라 지금 상태가 아니다. 대표자·임원 이름·전화·홈페이지·상세 주소는 받지도 싣지도 않는다. 투자 판단의 근거로 쓰지 말고 공시 원문을 확인하세요.">
    <div slot="answer" class="fm">
      <p class="fm__big"><b id="fm-n" data-og-num="곳 · 인천 본점 운수·창고 법인(사업보고서 제출)">{D.n}</b><span>곳 · 인천 본점 운수·창고 법인<br /><small>지난 12개월 사업보고서 제출 법인 {D.filers.toLocaleString("ko-KR")}곳 중 · {snap} 스냅샷</small></span></p>
      <figure class="fm__fig" id="fm-fig">
        <ol class="fm__bars">{shown.map((d) => <li><span>{d}</span><i style={`--w:${((cnt[d] / top) * 100).toFixed(1)}%`}></i><b>{cnt[d]}</b></li>)}</ol>
        <figcaption class="s-cap">업종(KSIC 중분류)별 곳 수 · 기업개황 업종코드 기준</figcaption>
      </figure>
    </div>
    <div slot="controls" class="fm__ctl">
      <div class="seg" role="group" aria-label="업종 고르기">
        <button type="button" class="s-btn" data-d="" aria-pressed="true">전체</button>
        {shown.map((d) => <button type="button" class="s-btn s-btn--ghost" data-d={d} aria-pressed="false">{d}</button>)}
      </div>
    </div>
    <section class="fm__list" aria-labelledby="fm-list-h">
      <h2 id="fm-list-h" class="fm__h">법인 카드 <span class="fm__note">공시 수치 그대로 · 가나다 순 · 투자 권유 아님</span></h2>
      <p class="s-cap" aria-live="polite">보이는 법인 <b id="fm-shown">{D.n}</b>곳</p>
      <ol id="fm-items">
        {F.map((f) => {
          const A = f.accounts;
          return (
            <li data-d={f.division}>
              <h3>{f.name}</h3>
              <p class="fm__meta">{f.cls}{f.stock_code && <> · 종목코드 {f.stock_code}</>} · {f.division}({f.induty_code}){f.gu && <> · 인천 {f.gu}</>} · {f.acc_mt}월 결산</p>
              {A ? (
                <table class="fm__t">
                  <caption>{f.period_end} 사업보고서 · {A.fs} 기준</caption>
                  <thead><tr><th scope="col">계정</th><th scope="col">{A.revenue?.now_term || "당기"}</th><th scope="col">{A.revenue?.prev_term || "전기"}</th></tr></thead>
                  <tbody>{ROWS.map(([k, n]) => <tr><th scope="row">{A[k]?.label || n}</th><td>{won(A[k]?.now)}</td><td>{won(A[k]?.prev)}</td></tr>)}</tbody>
                </table>
              ) : <p class="fm__none">주요계정을 받지 못했다 — 공시 원문을 보세요.</p>}
              <p class="fm__src"><a href={f.url} rel="noopener noreferrer">공시 원문 — {f.report}</a> · 접수 {f.rcept_dt}</p>
            </li>
          );
        })}
      </ol>
      <details class="fm__rule">
        <summary>고르는 규칙(선커밋 · 데이터 보기 전)</summary>
        <p><b>모집단</b> {D.universe} {D.filers.toLocaleString("ko-KR")}곳</p>
        <p><b>인천</b> 기업개황 본점 주소가 「인천」으로 시작</p>
        <p><b>물류</b> 업종코드 앞 두 자리 {Object.entries(D.rule.ksic2).map(([k, v]) => `${k} ${v}`).join(" · ")}</p>
        <p><b>싣지 않음</b> 5곳 미만이면 지면을 만들지 않는다 · 대표자·임원·전화·홈페이지·상세 주소는 받은 즉시 버린다</p>
      </details>
    </section>
  </ToolShell>
  <script>
    const items = [...document.querySelectorAll<HTMLLIElement>("#fm-items li")], shown = document.getElementById("fm-shown")!;
    for (const b of document.querySelectorAll<HTMLButtonElement>(".fm__ctl .seg button")) b.addEventListener("click", () => {
      for (const y of document.querySelectorAll<HTMLButtonElement>(".fm__ctl .seg button")) { const on = y === b; y.setAttribute("aria-pressed", String(on)); y.classList.toggle("s-btn--ghost", !on); }
      const d = b.dataset.d || "";
      for (const li of items) li.hidden = !!d && li.dataset.d !== d;
      shown.textContent = String(items.filter((li) => !li.hidden).length);
    });
  </script>
</Studio>
<style>
  .fm { display: grid; gap: var(--s-3); }
  .fm__big { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .fm__big > b { font-size: clamp(38px, 5vw, 64px); font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--s-signal); }
  .fm__big > span { color: var(--s-ink-2); } .fm__big small { color: var(--s-ink-3); font-size: var(--s-t-cap); }
  .fm__fig { margin: 0; }
  .fm__bars { list-style: none; margin: 0 0 var(--s-2); padding: 0; display: grid; gap: 6px; font-variant-numeric: tabular-nums; max-width: 40rem; }
  .fm__bars li { display: grid; grid-template-columns: 12rem 1fr 3rem; gap: 8px; align-items: center; }
  .fm__bars i { display: block; height: 10px; background: var(--s-ink-3); width: var(--w); transform-origin: left; animation: fm-bar 0.8s 0.2s ease-out both; }
  .fm__bars b { text-align: right; font-weight: 600; }
  @keyframes fm-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .fm__ctl .seg { display: flex; flex-wrap: wrap; } .fm__ctl .s-btn { min-height: 44px; }
  .fm__list { max-width: 52rem; }
  .fm__h { font-size: var(--s-t-h3); margin: 0 0 var(--s-2); display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .fm__note { font-size: var(--s-t-cap); font-weight: 500; color: var(--s-ink-2); border: 1px solid var(--s-rule); padding: 2px 8px; }
  #fm-items { list-style: none; margin: var(--s-3) 0 0; padding: 0; display: grid; }
  #fm-items li { border-top: 1px solid var(--s-rule); padding: var(--s-4) 0; }
  #fm-items h3 { font-size: 19px; margin: 0 0 2px; }
  .fm__meta, .fm__src, .fm__none { margin: 0; font-size: var(--s-t-cap); color: var(--s-ink-2); overflow-wrap: anywhere; }
  .fm__t { margin: var(--s-2) 0; border-collapse: collapse; font-variant-numeric: tabular-nums; width: 100%; max-width: 36rem; font-size: 15px; }
  .fm__t caption { text-align: left; font-size: var(--s-t-cap); color: var(--s-ink-3); padding-bottom: 4px; }
  .fm__t th, .fm__t td { padding: 4px 8px 4px 0; border-bottom: 1px solid var(--s-rule); text-align: right; }
  .fm__t th[scope="row"], .fm__t thead th:first-child { text-align: left; font-weight: 500; }
  .fm__rule { margin-top: var(--s-4); font-size: var(--s-t-cap); color: var(--s-ink-2); } .fm__rule summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; }
  @media (max-width: 720px) { .fm__bars li { grid-template-columns: 8.5rem 1fr 2rem; } .fm__t { font-size: 13px; } }
  @media (prefers-reduced-motion: reduce) { .fm__bars i { animation: none; } }
</style>
