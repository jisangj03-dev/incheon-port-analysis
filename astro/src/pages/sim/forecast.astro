---
// 인천항 수요예측 실험실 — 정체성 전환 §3-4 · 방법론 docs/수요예측_방법론_선커밋_20261014.md.
// 공개 지면(2026-10-14 공개 전환 · 종전 lab/forecast) · 메뉴 = 시뮬레이션.
// 화면 숫자는 원장·대상 계열 파일에서 빌드 때 읽고(§2-1), 채점은 analysis/forecast_teu.py 와 같은 식이다 — 시험이 둘을 대조한다.
import { aiMark } from "../../lib/profile";
import Studio from "../../layouts/Studio.astro";
import Updated from "../../components/Updated.astro";
import { sourceLine } from "../../lib/sources";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { repoRoot, lastUpdated } from "../../lib/content";
import L from "../../../../data/forecast/lab.json";

const root = repoRoot();
const csv = (p: string) => {
  const [head, ...rows] = readFileSync(join(root, p), "utf-8").replace(/^﻿/, "").split(/\r?\n/).filter(Boolean);
  const k = head.split(",");
  return rows.map((r) => Object.fromEntries(r.split(",").map((v, i) => [k[i], v])));
};
const y: Record<string, number> = {};
for (const r of csv(L.series.file)) if (r["터미널"] === "컨테이너 합계" && r["당월_천TEU"]) y[r["기준연월"]] = Number(r["당월_천TEU"]);
const ledger = csv("data/forecast/incheon_container_teu.csv");
const lastYm = Object.keys(y).sort().at(-1)!;
const back12 = (ym: string) => `${Number(ym.slice(0, 4)) - 1}${ym.slice(4)}`;

// 목표월·발행별로 B·M1 을 한 줄에
type Row = { issued: string; origin: string; target: string; h: string; B?: number; M1?: number };
const byKey = new Map<string, Row>();
for (const r of ledger) {
  const key = `${r.origin}|${r.target}`;
  const row = byKey.get(key) || { issued: r.issued, origin: r.origin, target: r.target, h: r.h };
  (row as any)[r.model] = Number(r.yhat);
  byKey.set(key, row);
}
const rows = [...byKey.values()].sort((a, b) => (a.origin + a.target < b.origin + b.target ? 1 : -1));
// 채점(방법론 §4): APE 평균(MAPE) · M1 방향 적중
const ape: Record<string, number[]> = {}, hit: number[] = [];
for (const r of ledger) {
  const a = y[r.target];
  if (a == null) continue;
  (ape[r.model] ||= []).push(Math.abs(Number(r.yhat) - a) / a);
  const p = y[back12(r.target)];
  if (r.model !== "B" && p != null && a !== p) hit.push(Number(Number(r.yhat) - p > 0 === a - p > 0));
}
const pct = (xs?: number[]) => (xs && xs.length ? ((xs.reduce((s, x) => s + x, 0) / xs.length) * 100).toFixed(1) : null);
const matured = Object.values(ape).reduce((s, xs) => s + xs.length, 0);
const firstTarget = rows.map((r) => r.target).sort()[0];
const updated = lastUpdated("data/forecast/incheon_container_teu.csv");
---
<Studio current="sim" title="인천항 수요예측 실험실" description="실제값이 나오기 전에 3개월 예측을 먼저 적어 두고, 매달 작년 같은 달을 쓰는 기준선과 오차를 나란히 잰다.">
  <div class="fc wrap" data-sim="forecast">
    <p class="eyebrow">실험실 · 시험 지면</p>
    <h1>인천항 수요예측 실험실</h1>
    <p class="lede">{L.series.label}의 다음 석 달을 실제값보다 먼저 적어 둡니다. 마지막 실제값은 <strong>{lastYm} · {y[lastYm]}{L.series.unit}</strong>입니다.</p>

    <section class="panel" aria-labelledby="h-score" data-chart="forecast-score">
      <h2 id="h-score">적중 기록</h2>
      {matured === 0 ? (
        <p class="say" data-score="none">아직 채점할 달이 없습니다 — 첫 채점은 {firstTarget} 실제값이 들어온 뒤입니다.</p>
      ) : (
        <table><thead><tr><th scope="col">모델</th><th scope="col" class="num">MAPE(%)</th><th scope="col" class="num">방향 적중(%)</th></tr></thead>
          <tbody>
            {Object.keys(L.models).map((m) => (
              <tr data-model={m}><th scope="row">{m} — {(L.models as any)[m]}</th><td class="num" data-mape>{pct(ape[m]) ?? "—"}</td><td class="num" data-dir>{m === "B" ? "해당 없음" : hit.length ? ((hit.reduce((s, x) => s + x, 0) / hit.length) * 100).toFixed(0) : "—"}</td></tr>
            ))}
          </tbody></table>
      )}
      <Updated date={updated} source={`원장 data/forecast/incheon_container_teu.csv · ${L.series.source} · ${sourceLine("mof-incheon-port-stats")}`} />
    </section>

    <section class="panel" aria-labelledby="h-ledger">
      <h2 id="h-ledger">예측 원장(덧붙이기만)</h2>
      <div class="tbl"><table>
        <thead><tr><th scope="col">발행</th><th scope="col">기준월</th><th scope="col">목표월</th><th scope="col" class="num">B</th><th scope="col" class="num">M1</th><th scope="col" class="num">실제</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.issued}</td><td>{r.origin}</td><td>{r.target}</td><td class="num">{r.B ?? "—"}</td><td class="num">{r.M1 ?? "—"}</td><td class="num">{y[r.target] ?? "아직"}</td></tr>
          ))}
        </tbody>
      </table></div>
      <p class="note">{Object.entries(L.models).map(([k, v]) => `${k} = ${v}`).join(" · ")}. 단위 {L.series.unit}.</p>
    </section>

    <section class="maker" aria-labelledby="h-maker">
      <h2 id="h-maker">만든 사람 노트</h2>
      <dl data-maker-note>
        <div><dt>왜</dt><dd data-note="why">{L.notes.why}</dd></div>
        <div><dt>어떻게</dt><dd data-note="how">{L.notes.how}</dd></div>
        <div><dt>한계</dt><dd data-note="limits">{L.notes.limits}</dd></div>
      </dl>
      <p class="ai" data-ai-mark>{aiMark()}</p>
    </section>
  </div>
</Studio>
<style>
  .fc { padding-top: 2rem; }
  .lede { max-width: 64ch; }
  .panel { background: var(--hull); border: 1px solid var(--hair); border-radius: var(--r-md); padding: 1.1rem 1.2rem; margin: 1.2rem 0; }
  .panel h2 { font-size: 1.1rem; margin: 0 0 0.6rem; }
  .say { font-weight: 700; color: var(--ink); }
  .tbl { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { border-bottom: 1px solid var(--hair); padding: 0.5rem 0.6rem; text-align: left; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .note { font-size: 0.85rem; color: var(--mist); }
  .maker { max-width: 760px; }
  .maker dl div { margin: 0 0 0.6rem; }
  .maker dd { margin: 0; }
  .ai { font-size: 0.8rem; color: var(--mist); }
</style>
