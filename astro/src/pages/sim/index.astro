---
// 시뮬레이션(구조 넷 ②) — 손으로 움직여 보는 공급망. 목록은 콘텐츠 목록(data/rooms.json · sim 방)에서 자동.
// 3PL 계산기는 메뉴에서 뺐다(정체성 §3-6 — 흡수 판정 전) · 주소(/tools/…)는 계속 열려 있다.
import Studio from "../../layouts/Studio.astro";
import { room } from "../../lib/rooms";
import { u } from "../../lib/site";
const R = room("sim");
---
<Studio title="시뮬레이션 — 측심" description={R.lead} current="sim" path="/sim/">
  <article class="s-wrap hub" data-content="sim">
    <p class="s-cap">시뮬레이션</p>
    <h1 class="s-prose">{R.title}</h1>
    <p class="s-lead s-prose">{R.lead}</p>
    <ol class="s-index">
      {(R.items || []).map((r) => <li><div><h2 class="h3"><a href={u(r.href)}>{r.title}</a></h2><p>{r.lead}</p></div></li>)}
    </ol>
  </article>
</Studio>
<style>
  .hub { padding-top: var(--s-8); padding-bottom: var(--s-8); }
  .hub h1 { margin: var(--s-3) 0 var(--s-4); }
  .hub .s-index { margin-top: var(--s-7); }
  .hub .h3 { font-size: var(--s-t-h3); margin: 0; }
</style>
