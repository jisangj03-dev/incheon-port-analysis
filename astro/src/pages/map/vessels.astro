---
// 외항선 입항 추이(옛 이름 「선박 리플레이」 — 실무에서 AIS 항적 재생으로 읽혀 바꿨다 · 5차 사실 대조 · 정체성 §3-3) — 월 집계 — 개별 선박 아님. 원천 = 해양수산부 항만별 선박입출항실적(Actions 수집 · 키는 시크릿 · 달마다 자동 갱신은 아직 없다).
// 숫자 = data/derived/vessel_replay.json(tools-build/vessel_derive.py). 달 막대 하나 + 재생 — 2015년부터 지금까지 외항선 입항이 흐른다.
import AiMark from "../../components/scene/AiMark.astro";
import Studio from "../../layouts/Studio.astro";
import Trust from "../../components/scene/Trust.astro";
import { sourceLine } from "../../lib/sources";
import { lastUpdated, repoRoot } from "../../lib/content";
import { u } from "../../lib/site";
import { readFileSync } from "node:fs";
import { join } from "node:path";

const V = JSON.parse(readFileSync(join(repoRoot(), "data/derived/vessel_replay.json"), "utf-8"));
const L = V.latest;
const upd = lastUpdated("data/derived/vessel_replay.json");
const n = V.months.length;
---
<Studio title="외항선 입항 추이 — 항만별, 2015년부터" description="해양수산부 항만별 선박입출항실적으로 인천·부산·평택당진·경인항의 외항선 입항을 달마다 다시 돌려 본다. 월 집계 — 개별 선박 아님." current="map">
  <article class="s-wrap vr" data-content="ds-vessels">
    <p class="s-cap">도구 · 외항선 입항 추이 · 항만별 월 집계</p>
    <h1 class="s-prose">인천항에 외항선이 한 달 {L.incheon}척 들어왔습니다.</h1>
    <p class="s-lead s-prose">{L.ym} 기준, 전국 외항선 입항의 <b>{L.incheon_share_pct}%</b>. 작년 같은 달보다 <b class={L.incheon_yoy_pct < 0 ? "s-signal" : ""}>{L.incheon_yoy_pct}%</b>.</p>

    <figure class="replay" id="replay" aria-label={`${V.months[0]}부터 ${V.months[n - 1]}까지 항만별 외항선 입항 척수`}>
      {/* [2026-10-20 화면 판정] 큰 숫자가 재생 중인 옛 달(599척 · 2016-02)을 따라가 머리 문장(523척)과 어긋났다 →
           큰 숫자는 최신 달에 고정 · 흐르는 달은 차트 안 커서(달·척수)가 든다 */}
      <div class="replay__now"><span class="vr-ym">{L.ym}</span><span class="vr-v"><i>{L.incheon}</i><small>척 · 인천</small></span><span class="vr-b">부산 <i>{L.busan}</i>척</span></div>
      <div id="vr-chart" class="replay__chart"></div>
      <div class="replay__ctl">
        <button type="button" id="vr-play" class="s-btn s-btn--ghost" aria-pressed="false">재생</button>
        <input id="vr-m" type="range" min="0" max={n - 1} value={n - 1} step="1" aria-label="달 고르기" />
      </div>
      <Trust updated={upd} source={sourceLine("mof-vessel")} csv={u("/data/vessel-replay.csv")} csvName="vessel-replay.csv" note="월 집계 · 입항 척수" />
    </figure>
    <p class="counter s-prose"><b>반대 지표</b> — {V.counter}: 같은 달 부산 <b>{L.busan}</b>척, 인천의 <b class="s-signal">{L.busan_to_incheon}</b>배.</p>
    <script type="application/json" id="vr-data" set:html={JSON.stringify({ months: V.months, s: V.ocean_arrivals })}></script>

    <details class="vr-more"><summary class="s-cap">왜 · 어떻게 · 한계</summary>
    <dl class="s-maker" data-maker-note>
      <dt>왜</dt><dd data-note="why">「인천항이 바쁘다」를 배가 실제로 들어온 횟수로, 다른 항만과 같은 자로 재 보려고.</dd>
      <dt>어떻게</dt><dd data-note="how" data-v1>{V.source_months[0].slice(0, 4)}-{V.source_months[0].slice(4)}~{V.source_months[1].slice(0, 4)}-{V.source_months[1].slice(4)} 원천 표 {Number(V.source_rows).toLocaleString("ko-KR")}줄을 모두 받아 셈 · 외항 = 국적선 + 외국선 · 연안선은 따로 뺐다. 해양수산부 항만별 선박입출항실적(공공데이터포털 조회 서비스)을 받아 항만·선종별 월 합계에서 국적선과 외국선을 더해 외항선으로 본다.</dd>
      <dt>한계</dt><dd data-note="limits">개별 선박의 항적이 아니다 — 원천이 월 합계만 준다. 척수는 배의 크기를 보지 않는다(큰 배 한 척 = 작은 배 한 척). 「경인」은 경인항으로, 인천항과 따로 집계된다.</dd>
    </dl>
    </details>
    <AiMark k="map/vessels" />
  </article>
  <script>
    import { pace, paused, setPaused } from "../../lib/motion";
    const D = JSON.parse(document.getElementById("vr-data")!.textContent || "{}");
    const host = document.getElementById("vr-chart")!, slider = document.getElementById("vr-m") as HTMLInputElement, play = document.getElementById("vr-play") as HTMLButtonElement;
    // 인천이 주인공 — 주홍 굵은 선을 맨 마지막(맨 앞)에 · 부산은 회색 대비선(2026-10-14 채팅 검수: 부산 선만 보이고 인천이 안 보였다)
    const LINES = [["부산", "var(--s-ink-3)", 1.25], ["평택.당진", "var(--s-sea)", 1.25], ["경인", "var(--s-sea-2)", 1.25], ["인천", "var(--s-signal)", 3.5]] as const;
    const max = Math.max(...Object.values(D.s as Record<string, number[]>).flat());
    // 오른쪽 여백 R 은 끝 이름표(「평택·당진 421」)가 칸 안에 들어오는 폭
    const draw = (i: number) => {
      const W = Math.max(300, host.clientWidth), H = W < 600 ? 220 : Math.round(Math.max(200, Math.min(280, innerHeight * 0.3))), // 1280×720 에서 인천 선이 접힘선에 눌렸다(2차 화면 판정)
        Lp = 4, R = W < 600 ? 96 : 112, T = 26 /* 위 26px = 커서 날짜 자리(선·이름표 위 · 8차 화면 판정: 390 에서 날짜가 「부산」 이름표에 가렸다) */, B = 26, n = D.months.length;
      const x = (k: number) => Lp + (k * (W - Lp - R)) / (n - 1), y = (v: number) => H - B - (v * (H - T - B)) / max;
      let g = `<line x1="${Lp}" x2="${W - R}" y1="${H - B}" y2="${H - B}" stroke="var(--s-rule)"/>`;
      // 연도 눈금(화면 판정 10/20 — 양끝만 있어 언제인지 못 읽었다) · 좁으면 두 해마다
      const yStep = W < 600 ? 2 : 1;
      D.months.forEach((m: string, k: number) => { if (m.endsWith("-01") && Number(m.slice(0, 4)) % yStep === 0 && x(k) > 18 && x(k) < W - R - 18) g += `<line x1="${x(k).toFixed(1)}" x2="${x(k).toFixed(1)}" y1="${H - B}" y2="${H - B + 4}" stroke="var(--s-ink-3)"/><text x="${x(k).toFixed(1)}" y="${H - 6}" font-size="11.5" text-anchor="middle" fill="var(--s-ink-3)">${m.slice(0, 4)}</text>`; });
      // 흐르는 달 커서 — 지금 그리는 달과 그 달 인천 척수
      g += `<line x1="${x(i).toFixed(1)}" x2="${x(i).toFixed(1)}" y1="${T}" y2="${H - B}" stroke="var(--s-ink-3)" stroke-dasharray="2 3"/><text x="${Math.min(Math.max(x(i), 30), W - R - 30).toFixed(1)}" y="14" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--s-ink-2)" style="paint-order:stroke;stroke:var(--s-paper);stroke-width:7px;stroke-linejoin:round">${D.months[i]}</text>`;
      const ends: { y: number; t: string; c: string; b: boolean }[] = [];
      for (const [p, c, w] of LINES) {
        const v = D.s[p] as number[];
        g += `<polyline fill="none" stroke="${c}" stroke-width="${w}" stroke-opacity="0.25" points="${v.map((a, k) => `${x(k).toFixed(1)},${y(a).toFixed(1)}`).join(" ")}"/>`;
        g += `<polyline fill="none" stroke="${c}" stroke-width="${w}" stroke-linejoin="round"${p === "인천" ? ' data-main="인천"' : ""} points="${v.slice(0, i + 1).map((a, k) => `${x(k).toFixed(1)},${y(a).toFixed(1)}`).join(" ")}"/>`;
        g += `<circle cx="${x(i)}" cy="${y(v[i])}" r="${p === "인천" ? 4 : 3}" fill="${c}"/>`;
        ends.push({ y: y(v[i]), t: `${p === "평택.당진" ? "평택·당진" : p} ${v[i]}`, c, b: p === "인천" });
      }
      ends.sort((a, b) => a.y - b.y);
      for (let k = 1; k < ends.length; k++) if (ends[k].y - ends[k - 1].y < 15) ends[k].y = ends[k - 1].y + 15;
      for (const e of ends) g += `<text x="${x(i) + 8}" y="${(e.y + 4).toFixed(1)}" font-size="13" font-weight="${e.b ? 700 : 500}" fill="${e.c === "var(--s-sea-2)" ? "var(--s-sea-2-t)" : e.c === "var(--s-sea)" ? "var(--s-sea-t)" : e.c}" style="paint-order:stroke;stroke:var(--s-paper);stroke-width:7px;stroke-linejoin:round">${e.t}</text>`;
      host.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="${D.months[0]}부터 ${D.months[i]}까지 항만별 외항선 입항 척수 — 인천 ${D.s["인천"][i]}척 · 부산 ${D.s["부산"][i]}척">${g}</svg>`;
      host.dataset.month = D.months[i];
    };
    // [2026-10-15 공개 전 개편 P0] 들어오자마자 돈다 — 끝 달에서 2.5초 쉬고 처음부터 다시. 만지면(달 막대) 멈췄다가 6초 뒤 다시 ·
    // 「멈춤」 단추로 멈춘 것(held)은 그대로 · 동작 줄이기면 돌지 않는다(마지막 달 그대로)
    // [2026-10-20 · 품질기준 Q7] 동작 줄이기 = 천천히 계속 돈다 · 멈춤은 단추(기억)
    let timer: any = null, rt: any = 0, endT: any = 0, held = paused();
    (window as any).__vrPlay = { get on() { return !!timer; }, get held() { return held; } };
    const stop = () => { clearInterval(timer); clearTimeout(endT); timer = null; play.textContent = "재생"; play.setAttribute("aria-pressed", "false"); };
    const start = () => {
      if (Number(slider.value) >= D.months.length - 1) { slider.value = "0"; draw(0); }
      play.textContent = "멈춤"; play.setAttribute("aria-pressed", "true");
      clearInterval(timer);
      timer = setInterval(() => {
        const k = Number(slider.value) + 1;
        if (k >= D.months.length) { clearInterval(timer); endT = setTimeout(() => { if (timer && !held) start(); }, 2500); return; }
        slider.value = String(k); draw(k);
      }, 120 / pace());
    };
    const touch = () => { stop(); clearTimeout(rt); if (!held) rt = setTimeout(() => { if (!timer && !held) start(); }, 6000); };
    play.addEventListener("click", () => { clearTimeout(rt); if (timer) { held = true; setPaused(true); stop(); } else { held = false; setPaused(false); start(); } });
    slider.addEventListener("input", () => { touch(); draw(Number(slider.value)); });
    if (!held) setTimeout(() => { if (!timer && !held) start(); }, 900);
    new ResizeObserver(() => draw(Number(slider.value))).observe(host);
    draw(Number(slider.value));
  </script>
</Studio>
<style>
  /* [2026-10-20 화면 판정] 1280·1520 접힘선 위에 인천 선이 안 걸렸다 → 머리 여백·차트 위 간격을 줄인다 */
  .vr { padding-top: var(--s-5); padding-bottom: var(--s-8); }
  .vr h1 { margin: var(--s-2) 0 var(--s-3); max-width: 18em; }
  .vr .s-lead { margin: 0; }
  .vr-more { margin-top: var(--s-7); max-width: 46rem; } .vr-more summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
  .counter { border-left: 3px solid var(--s-signal); padding-left: var(--s-4); margin-top: var(--s-5); }
  .replay { margin: var(--s-4) 0 0; }
  .replay__now { display: flex; align-items: baseline; gap: var(--s-5); flex-wrap: wrap; margin-bottom: var(--s-3); }
  .vr-ym { font-style: italic; color: var(--s-ink-2); min-width: 5.5em; }
  .vr-v i { font-size: clamp(40px, 6vw, 72px); font-weight: 600; font-style: italic; color: var(--s-signal); letter-spacing: -0.03em; }
  .vr-v small { margin-left: 6px; color: var(--s-ink-2); }
  .vr-b { color: var(--s-ink-2); } .vr-b i { font-style: italic; color: var(--s-ink); }
  .replay__chart { min-height: 220px; }
  .replay__chart :global(svg) { display: block; max-width: 100%; }
  .replay__ctl { display: flex; gap: var(--s-4); align-items: center; margin: var(--s-3) 0; }
  .replay__ctl input { flex: 1; accent-color: var(--s-signal); min-height: 44px; margin: 0; }
  .vr .s-maker { margin-top: var(--s-3); }
</style>
