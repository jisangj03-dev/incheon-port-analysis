---
// 공급망 따라가기(정체성 §3-2) — 전기기기(HS 85) 하나가 해외에서 인천을 거쳐 수도권으로. 해도는 멈춰 있고(첫 화면 = 정지 그림) 스크롤이 단계를 넘긴다.
// 숫자 = data/derived/supply_hs85.json(tools-build/supply_derive.py 가 원천 CSV 에서 계산) · 원천 없는 구간은 「이 구간 데이터 없음」(S1).
import { aiMark } from "../../lib/profile";
import Studio from "../../layouts/Studio.astro";
import Haedo from "../../components/scene/Haedo.astro";
import Trust from "../../components/scene/Trust.astro";
import { mapSeries } from "../../lib/data";
import { route } from "../../lib/rooms";
import { u } from "../../lib/site";
import { curve, px, py } from "../../lib/haedo-geo";
import { sourceLine } from "../../lib/sources";
import { lastUpdated, repoRoot } from "../../lib/content";
import { readFileSync } from "node:fs";
import { join } from "node:path";

const D = JSON.parse(readFileSync(join(repoRoot(), "data/derived/supply_hs85.json"), "utf-8"));
const step = (id: string) => D.steps.find((s: any) => s.id === id);
const [O, SEA, AIR, CU, FI, WH, LAST] = ["origin", "sea", "air", "customs", "firms", "warehouse", "last"].map(step);
const upd = lastUpdated("data/derived/supply_hs85.json");
const RT = route();
const M = mapSeries();
const P = M.places.map((p: any) => ({ id: p.id, lon: p.lon, lat: p.lat, v: null as number | null }));
const sinhang = P.find((p: any) => p.id === "신항")!, air = P.find((p: any) => p.kind === "air" || p.id === "인천공항")!;
const gateShare = (n: string) => CU.data.gates.find((g: any) => g.name === n)?.share_pct;
// 덧그림 — 해외에서 오는 화살(서쪽 바다 끝 → 신항) · 서울까지 「데이터 없음」 점선(개념선)
const fromSea: [number, number] = [126.05, 37.27];
const arrowD = curve(fromSea, [sinhang.lon, sinhang.lat], [-0.1, 0.05]);
const lastD = curve([sinhang.lon, sinhang.lat], [RT.to.lon, RT.to.lat]);
const pts = P.map((p: any) => ({ ...p, cls: p.id === "신항" ? "top" : "" })).concat([{ id: "to", label: RT.to.label, lon: RT.to.lon, lat: RT.to.lat, v: null, cls: "to" }]);
const fit: [number, number][] = pts.map((p: any) => [p.lon, p.lat]); // 해외 화살 시작점은 맞춤에서 뺀다 — 화면 밖에서 들어온다
const inland: [number, number] = [126.72, 37.47]; // 「인천 전체 집계」 꼬리표 자리(위치가 아니라 이름표 자리)
---
<Studio title="공급망 따라가기 — 전기기기 하나가 인천을 지나는 길" description="전기기기(HS 85) 하나가 해외에서 인천을 거쳐 수도권으로 오는 길을 구간마다 공공 데이터로 잰다. 데이터가 없는 구간은 없다고 적는다." current="map">
  <div class="story" data-step="intro" data-content="ds-follow">
    <div class="story__map">
      <Haedo id="follow-map" points={pts} fit={fit} pad={{ t: 40, b: 70, l: 0.42, r: 70 }}>
        <path slot="over" d={arrowD} class="f-arrow" data-wpx="2.5" pathLength="1" />
        <path slot="over" d={lastD} class="f-last" data-wpx="2" />
        <span slot="labels" class="f-tag" data-show="origin sea" data-x={px(fromSea[0]).toFixed(1)} data-y={py(fromSea[1]).toFixed(1)} data-off="4">← {O.data.top} 방면 · 해외</span>
        <span slot="labels" class="f-tag" data-show="air" data-x={px(air.lon).toFixed(1)} data-y={(py(air.lat) - 22).toFixed(1)} data-off="-40">항공 화물 — 이 구간 데이터 없음</span>
        <span slot="labels" class="f-tag f-big" data-show="customs" data-x={px(air.lon).toFixed(1)} data-y={(py(air.lat) + 26).toFixed(1)} data-off="-30"><i>{gateShare("인천국제공항")}</i>% 인천공항</span>
        <span slot="labels" class="f-tag f-big" data-show="customs" data-x={px(sinhang.lon).toFixed(1)} data-y={(py(sinhang.lat) + 26).toFixed(1)} data-off="-20"><i>{gateShare("인천항")}</i>% 인천항</span>
        <span slot="labels" class="f-tag" data-show="firms warehouse" data-x={px(inland[0]).toFixed(1)} data-y={py(inland[1]).toFixed(1)} data-off="0">인천 전체 집계 — 한 곳의 위치가 아님</span>
        <span slot="labels" class="f-tag" data-show="last" data-x={px(RT.to.lon).toFixed(1)} data-y={(py(RT.to.lat) + 24).toFixed(1)} data-off="-60">수도권 배송 — 이 구간 데이터 없음</span>
      </Haedo>
    </div>

    <div class="story__steps">
      <section class="st st--intro" data-s="intro">
        <p class="s-cap">지도 · 공급망 따라가기</p>
        <h1 class="s-prose">전기기기 한 상자가 수도권에 닿기까지.</h1>
        <p class="s-lead">{D.item.name}(HS {D.item.hs})를 따라 해외 출발부터 수도권 문 앞까지 {D.steps.length}구간을 걷습니다. 공개 원천이 있는 구간만 숫자를 적고, 없는 구간은 없다고 적습니다.</p>
        <p class="s-cap">아래로 내려 보세요.</p>
      </section>

      <section class="st" data-s="origin">
        <p class="s-cap">1 · {O.title} · {O.data.ym.slice(0, 4)}-{O.data.ym.slice(4)}</p>
        <h2>들어오는 전기기기의 절반은 {O.data.top}에서.</h2>
        <p>수집한 {O.data.n_countries}개국 가운데 {O.data.top} 몫이 <b class="s-signal">{O.data.top_share_pct}%</b>입니다.</p>
        <ol class="bars">{O.data.countries.slice(0, 5).map((c: any) => <li><span>{c.name}</span><i style={`--w:${c.share_pct}%`}>{c.share_pct}%</i><small>{c.musd}{O.data.unit === "백만 달러" ? "백만 달러" : ""}</small></li>)}</ol>
        <p class="s-cap">{O.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(O.source)} />
      </section>

      <section class="st" data-s="sea">
        <p class="s-cap">2 · {SEA.title} · {SEA.data.ym}</p>
        <h2>배는 인천항 컨테이너 부두로.</h2>
        <p>{SEA.data.ym} 한 달 인천항 컨테이너는 <b>{SEA.data.kteu}</b>천TEU, 작년 같은 달보다 <b class={SEA.data.yoy_pct < 0 ? "s-signal" : ""}>{SEA.data.yoy_pct}%</b>.</p>
        <p class="s-cap">{SEA.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(SEA.source)} />
      </section>

      <section class="st" data-s="air">
        <p class="s-cap">3 · {AIR.title}</p>
        <h2>비행기로 오는 몫 — 이 구간 데이터 없음.</h2>
        <p>{AIR.why}. 지어낸 값은 넣지 않습니다.</p>
      </section>

      <section class="st" data-s="customs">
        <p class="s-cap">4 · {CU.title} · {CU.data.ym.slice(0, 4)}-{CU.data.ym.slice(4)}</p>
        <h2>수입 신고 금액으로 보면, 인천 관문은 둘입니다.</h2>
        <ol class="bars">{CU.data.gates.map((g: any) => <li><span>{g.name}</span><i style={`--w:${g.share_pct * 2}%`}>{g.share_pct}%</i></li>)}</ol>
        <p class="counter"><b>반대 지표</b> — {D.counter.text}: 부산 <b>{D.counter.busan_pct}%</b> · 인천항 <b>{D.counter.incheon_port_pct}%</b>.</p>
        <p class="s-cap">{CU.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(CU.source)} />
      </section>

      <section class="st" data-s="firms">
        <p class="s-cap">5 · {FI.title} · {FI.data.ym.slice(0, 4)}-{FI.data.ym.slice(4)}</p>
        <h2>인천 수입의 {FI.data.share_of_incheon_imports_pct}%가 전기기기.</h2>
        <p>인천에 사업장을 둔 수입자가 들여온 전기기기는 <b>{FI.data.imp_kusd.toLocaleString("ko-KR")}</b>천 달러입니다.</p>
        <p class="s-cap">{FI.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(FI.source)} />
      </section>

      <section class="st" data-s="warehouse">
        <p class="s-cap">6 · {WH.title}</p>
        <h2>인천 물류창고 {WH.data.sites}곳, 보세는 {WH.data.bonded_sites}곳.</h2>
        <p>관세법에 따라 등록된 창고가 <b>{WH.data.bonded_pct}%</b>. 가장 많은 구는 {WH.data.top_gu}({WH.data.top_gu_sites}곳).</p>
        <p class="s-cap">{WH.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(WH.source)} />
      </section>

      <section class="st" data-s="last">
        <p class="s-cap">7 · {LAST.title}</p>
        <h2>마지막 구간 — 이 구간 데이터 없음.</h2>
        <p>{LAST.why}. 점선은 개념선입니다 — 실제 운송 경로가 아닙니다.</p>
      </section>

      <section class="st st--end" data-s="end">
        <dl class="s-maker" data-maker-note>
          <dt>왜</dt><dd data-note="why">「인천을 지난다」는 말을 상품 하나의 길로 쪼개, 어느 구간이 숫자로 잡히고 어느 구간이 비어 있는지 보이려고.</dd>
          <dt>어떻게</dt><dd data-note="how">관세청·해양수산청·국토교통부 공개 통계를 구간마다 하나씩 붙였다. 구간마다 집계 단위가 달라(전국·인천항·관문·인천 소재지·인천 창고) 숫자를 서로 더하거나 잇지 않는다. 계산 = {D.command}.</dd>
          <dt>한계</dt><dd data-note="limits">한 상자를 실제로 추적한 것이 아니다. 항공·마지막 배송 구간은 원천이 없다. 「인천 소재 수입자」는 통관 항구가 아니라 사업장 주소 기준이다.</dd>
        </dl>
        <p class="s-cap" data-ai-mark>{aiMark()}</p>
      </section>
    </div>
  </div>
  <script>
    import { initHaedo } from "../../lib/haedo";
    const story = document.querySelector(".story") as HTMLElement;
    const fig = document.getElementById("follow-map") as HTMLElement;
    // 왼쪽 여백 비율(pad.l 0.42)은 글 기둥 자리 — 좁은 화면은 위쪽 지도만 쓰므로 부품 기본값을 쓴다
    const refit = initHaedo(fig);
    // 단계가 바뀌면 그 단계 꼬리표까지 넣어 이름표를 다시 놓는다(겹침 0)
    const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting && story.dataset.step !== (e.target as HTMLElement).dataset.s) { story.dataset.step = (e.target as HTMLElement).dataset.s!; refit(); } }, { rootMargin: "-45% 0px -45% 0px" });
    for (const s of document.querySelectorAll(".st")) io.observe(s);
  </script>
</Studio>
<style>
  .story { position: relative; }
  .story__map { position: sticky; top: 0; height: 100vh; z-index: 0; overflow: hidden; }
  .story__steps { position: relative; z-index: 2; margin-top: -100vh; padding: 0 var(--s-gutter); }
  .st { min-height: 92vh; max-width: 30rem; padding: var(--s-9) 0; display: flex; flex-direction: column; justify-content: center; }
  .st > * { background: rgba(245, 242, 235, 0.94); margin: 0; padding: var(--s-2) var(--s-4); }
  .st h1, .st h2 { padding-top: var(--s-3); }
  .st h2 { font-size: var(--s-t-h3); }
  .st--intro { min-height: 100vh; }
  .st--intro h1 { font-size: clamp(32px, 4.4vw, 56px); }
  .bars { list-style: none; }
  .bars li { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: var(--s-3); align-items: center; padding: 4px 0; font-size: var(--s-t-sm); }
  .bars i { font-style: italic; font-variant-numeric: tabular-nums; color: var(--s-ink-2); position: relative; padding-left: 4px; }
  .bars i::before { content: ""; position: absolute; left: 0; top: 50%; height: 6px; width: var(--w); max-width: 100%; transform: translate(0, -50%); background: var(--s-sea-2); z-index: -1; }
  .bars li:first-child i::before { background: var(--s-signal); opacity: 0.6; }
  .bars small { color: var(--s-ink-3); font-size: var(--s-t-cap); }
  .counter { border-left: 3px solid var(--s-signal); }
  /* 지도 쪽 — 단계마다 보이는 것 */
  .f-arrow { fill: none; stroke: var(--s-ink-2); stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s var(--s-ease); }
  .f-last { fill: none; stroke: var(--s-ink-3); stroke-dasharray: 6 6; opacity: 0; transition: opacity 0.6s; }
  .story :global(.f-tag) { position: absolute; transform: translate(0, -50%); font-size: 13px; color: var(--s-ink-2); white-space: nowrap; opacity: 0; transition: opacity 0.5s; text-shadow: 0 0 3px var(--s-paper), 0 0 3px var(--s-paper); }
  .story :global(.f-big) { font-size: 15px; color: var(--s-ink); font-weight: 600; }
  .story :global(.f-big i) { font-style: italic; font-size: 22px; color: var(--s-signal); margin-right: 2px; }
  .story[data-step="origin"] .f-arrow, .story[data-step="sea"] .f-arrow, .story[data-step="customs"] .f-arrow { stroke-dashoffset: 0; }
  .story[data-step="last"] .f-last, .story[data-step="end"] .f-last { opacity: 1; }
  .story[data-step="origin"] :global([data-show~="origin"]), .story[data-step="sea"] :global([data-show~="sea"]), .story[data-step="air"] :global([data-show~="air"]),
  .story[data-step="customs"] :global([data-show~="customs"]), .story[data-step="firms"] :global([data-show~="firms"]), .story[data-step="warehouse"] :global([data-show~="warehouse"]),
  .story[data-step="last"] :global([data-show~="last"]) { opacity: 1; }
  .story[data-step="air"] :global(.h-pt[data-pt="인천공항"]) { fill: var(--s-paper); stroke: var(--s-ink-2); stroke-dasharray: 2 2; }
  .story[data-step="sea"] :global(.h-pt[data-pt="남항"]), .story[data-step="sea"] :global(.h-pt[data-pt="국제여객부두"]) { fill: var(--s-signal); fill-opacity: 0.6; }
  @media (max-width: 720px) {
    .story__map { height: 55vh; z-index: 3; border-bottom: 1px solid var(--s-rule); background: var(--s-paper); }
    .story__steps { margin-top: 0; z-index: 0; }
    .st { min-height: 70vh; max-width: none; padding: var(--s-6) 0; }
    .st--intro { min-height: 60vh; }
  }
</style>
