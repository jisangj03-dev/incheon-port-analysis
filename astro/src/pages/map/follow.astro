---
// 공급망 따라가기(정체성 §3-2) — 전기기기(HS 85) 하나가 해외에서 인천을 거쳐 수도권으로.
// [2026-10-14 선장님 판정 뒤 · 채팅 위임 C] 지도 여행 — 스크롤이 카메라다. 상자 하나가 상하이에서 황해를 건너 신항·인천 창고·수도권으로 가고,
// 카메라가 그 상자를 따라 날아간다(lib/flowmap.ts · 홈과 같은 엔진 · 바탕에 월 통계 흐름이 옅게 흐른다). 첫 그림 = 정지 해도(같은 카메라).
// 숫자 = data/derived/supply_hs85.json(tools-build/supply_derive.py 가 원천 CSV 에서 계산) · 원천 없는 구간은 「이 구간 데이터 없음」(S1).
import { aiMark } from "../../lib/profile";
import Studio from "../../layouts/Studio.astro";
import Trust from "../../components/scene/Trust.astro";
import { mapSeries } from "../../lib/data";
import { route } from "../../lib/rooms";
import { u } from "../../lib/site";
import { PW, PH } from "../../lib/home-poster";
import { sourceLine } from "../../lib/sources";
import { lastUpdated, repoRoot } from "../../lib/content";
import { readFileSync } from "node:fs";
import { join } from "node:path";

const D = JSON.parse(readFileSync(join(repoRoot(), "data/derived/supply_hs85.json"), "utf-8"));
const step = (id: string) => D.steps.find((s: any) => s.id === id);
const [O, SEA, AIR, CU, FI, WH, LAST] = ["origin", "sea", "air", "customs", "firms", "warehouse", "last"].map(step);
const upd = lastUpdated("data/derived/supply_hs85.json");
const RT = route();
const M = mapSeries();
const P = M.places.map((p: any) => ({ id: p.id, lon: p.lon, lat: p.lat, v: null as number | null }));
const sinhang = P.find((p: any) => p.id === "신항")!, air = P.find((p: any) => p.kind === "air" || p.id === "인천공항")!;
const gateShare = (n: string) => CU.data.gates.find((g: any) => g.name === n)?.share_pct;
const F = JSON.parse(readFileSync(join(repoRoot(), "data/derived/home_flows.json"), "utf-8"));
const D0 = (id: string) => F.dests.find((d: any) => d.id === id);
// 여행 길(개념선) — 상하이 → 황해 → 신항 · 신항 → 인천 창고(가장 많은 구) · 그 구 → 서울
const CN = F.partners.find((p: any) => p.id === "CN"), SG = F.sea_gates.find((g: any) => g.id === "신항");
const topGu = D0(WH?.data?.top_gu) || D0("제물포구");
const TRIP = {
  sea: [...CN.sea, ...SG.approach, [SG.lon, SG.lat]],
  firms: [[SG.lon, SG.lat], [(SG.lon + topGu.lon) / 2 + 0.03, (SG.lat + topGu.lat) / 2], [topGu.lon, topGu.lat]],
  last: [[topGu.lon, topGu.lat], [(topGu.lon + RT.to.lon) / 2, (topGu.lat + RT.to.lat) / 2 + 0.03], [RT.to.lon, RT.to.lat]],
  air: { lon: air.lon, lat: air.lat }, port: { lon: SG.lon, lat: SG.lat }, gu: { id: topGu.id, lon: topGu.lon, lat: topGu.lat }, to: RT.to,
  origin: { lon: CN.sea[0][0], lat: CN.sea[0][1], name: CN.name, at: CN.at },
};
---
<Studio title="공급망 따라가기 — 전기기기 하나가 인천을 지나는 길" description="전기기기(HS 85) 하나가 해외에서 인천을 거쳐 수도권으로 오는 길을 구간마다 공공 데이터로 잰다. 데이터가 없는 구간은 없다고 적는다." current="map" lateFonts>
  <div class="story" data-step="intro" data-content="ds-follow">
    <div class="story__map" id="trip-stage">
      <img class="trip__poster" src={u("/assets/home-poster.svg")} alt="" width={PW} height={PH} decoding="async" />
      <canvas id="trip" class="trip__cv" role="img" aria-label={`지도 여행 — 상자 하나가 ${TRIP.origin.at}에서 황해를 건너 인천 신항, 인천 창고, 서울 쪽으로 가는 길(개념선). 배경의 점은 월 통계를 그린 교역 흐름.`}></canvas>
      <div class="trip__labels" aria-hidden="true">
        <span class="f-tag" data-show="intro origin" data-ll={`${TRIP.origin.lon},${TRIP.origin.lat}`} data-dx="10" data-dy="-26">{TRIP.origin.name} · {TRIP.origin.at} 자리에서 출발</span>
        <span class="f-tag" data-show="sea" data-ll={`${TRIP.port.lon},${TRIP.port.lat}`} data-dx="12" data-dy="8">신항 · 인천항 컨테이너 부두</span>
        <span class="f-tag" data-show="air" data-ll={`${TRIP.air.lon},${TRIP.air.lat}`} data-dx="-40" data-dy="-58">항공 화물 — 이 구간 데이터 없음</span>
        <span class="f-tag f-big" data-show="customs" data-ll={`${TRIP.air.lon},${TRIP.air.lat}`} data-dx="-70" data-dy="-54"><i>{gateShare("인천국제공항")}</i>% 인천공항</span>
        <span class="f-tag f-big" data-show="customs" data-ll={`${TRIP.port.lon},${TRIP.port.lat}`} data-dx="14" data-dy="12"><i>{gateShare("인천항")}</i>% 인천항</span>
        <span class="f-tag" data-show="firms warehouse" data-ll={`${TRIP.gu.lon},${TRIP.gu.lat}`} data-dx="14" data-dy="-30">인천 전체 집계 — 한 곳의 위치가 아님</span>
        <span class="f-tag" data-show="last" data-ll={`${TRIP.to.lon},${TRIP.to.lat}`} data-dx="-120" data-dy="18">수도권 배송 — 이 구간 데이터 없음</span>
      </div>
      <p class="trip__cap s-cap">상자와 길은 개념선입니다 — 한 상자를 실제로 추적한 것이 아닙니다. 옅은 점은 월 통계를 그린 교역 흐름입니다.</p>
    </div>

    <div class="story__steps">
      <section class="st st--intro" data-s="intro">
        <p class="s-cap">지도 · 공급망 따라가기</p>
        <h1 class="s-prose">전기기기 한 상자가 수도권에 닿기까지.</h1>
        <p class="s-lead">{D.item.name}(HS {D.item.hs})를 따라 해외 출발부터 수도권 문 앞까지 {D.steps.length}구간을 걷습니다. 공개 원천이 있는 구간만 숫자를 적고, 없는 구간은 없다고 적습니다.</p>
        <p class="s-cap">아래로 내려 보세요.</p>
      </section>

      <section class="st" data-s="origin">
        <p class="s-cap">1 · {O.title} · {O.data.ym.slice(0, 4)}-{O.data.ym.slice(4)}</p>
        <h2>들어오는 전기기기의 절반은 {O.data.top}에서.</h2>
        <p>수집한 {O.data.n_countries}개국 가운데 {O.data.top} 몫이 <b class="s-signal">{O.data.top_share_pct}%</b>입니다.</p>
        <ol class="bars">{O.data.countries.slice(0, 5).map((c: any) => <li><span>{c.name}</span><i style={`--w:${c.share_pct}%`}>{c.share_pct}%</i><small>{c.musd}{O.data.unit === "백만 달러" ? "백만 달러" : ""}</small></li>)}</ol>
        <p class="s-cap">{O.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(O.source)} />
      </section>

      <section class="st" data-s="sea">
        <p class="s-cap">2 · {SEA.title} · {SEA.data.ym}</p>
        <h2>배는 인천항 컨테이너 부두로.</h2>
        <p>{SEA.data.ym} 한 달 인천항 컨테이너는 <b>{SEA.data.kteu}</b>천TEU, 작년 같은 달보다 <b class={SEA.data.yoy_pct < 0 ? "s-signal" : ""}>{SEA.data.yoy_pct}%</b>.</p>
        <p class="s-cap">{SEA.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(SEA.source)} />
      </section>

      <section class="st" data-s="air">
        <p class="s-cap">3 · {AIR.title}</p>
        <h2>비행기로 오는 몫 — 이 구간 데이터 없음.</h2>
        <p>{AIR.why}. 지어낸 값은 넣지 않습니다.</p>
      </section>

      <section class="st" data-s="customs">
        <p class="s-cap">4 · {CU.title} · {CU.data.ym.slice(0, 4)}-{CU.data.ym.slice(4)}</p>
        <h2>수입 신고 금액으로 보면, 인천 관문은 둘입니다.</h2>
        <ol class="bars">{CU.data.gates.map((g: any) => <li><span>{g.name}</span><i style={`--w:${g.share_pct * 2}%`}>{g.share_pct}%</i></li>)}</ol>
        <p class="counter"><b>반대 지표</b> — {D.counter.text}: 부산 <b>{D.counter.busan_pct}%</b> · 인천항 <b>{D.counter.incheon_port_pct}%</b>.</p>
        <p class="s-cap">{CU.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(CU.source)} />
      </section>

      <section class="st" data-s="firms">
        <p class="s-cap">5 · {FI.title} · {FI.data.ym.slice(0, 4)}-{FI.data.ym.slice(4)}</p>
        <h2>인천 수입의 {FI.data.share_of_incheon_imports_pct}%가 전기기기.</h2>
        <p>인천에 사업장을 둔 수입자가 들여온 전기기기는 <b>{FI.data.imp_kusd.toLocaleString("ko-KR")}</b>천 달러입니다.</p>
        <p class="s-cap">{FI.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(FI.source)} />
      </section>

      <section class="st" data-s="warehouse">
        <p class="s-cap">6 · {WH.title}</p>
        <h2>인천 물류창고 {WH.data.sites}곳, 보세는 {WH.data.bonded_sites}곳.</h2>
        <p>관세법에 따라 등록된 창고가 <b>{WH.data.bonded_pct}%</b>. 가장 많은 구는 {WH.data.top_gu}({WH.data.top_gu_sites}곳).</p>
        <p class="s-cap">{WH.data.scope}</p>
        <Trust updated={upd} csv={u("/data/supply-hs85.csv")} csvName="supply-hs85.csv" source={sourceLine(WH.source)} />
      </section>

      <section class="st" data-s="last">
        <p class="s-cap">7 · {LAST.title}</p>
        <h2>마지막 구간 — 이 구간 데이터 없음.</h2>
        <p>{LAST.why}. 점선은 개념선입니다 — 실제 운송 경로가 아닙니다.</p>
      </section>

      <section class="st st--end" data-s="end">
        <dl class="s-maker" data-maker-note>
          <dt>왜</dt><dd data-note="why">「인천을 지난다」는 말을 상품 하나의 길로 쪼개, 어느 구간이 숫자로 잡히고 어느 구간이 비어 있는지 보이려고.</dd>
          <dt>어떻게</dt><dd data-note="how">관세청·해양수산청·국토교통부 공개 통계를 구간마다 하나씩 붙였다. 구간마다 집계 단위가 달라(전국·인천항·관문·인천 소재지·인천 창고) 숫자를 서로 더하거나 잇지 않는다. 계산 = {D.command}.</dd>
          <dt>한계</dt><dd data-note="limits">한 상자를 실제로 추적한 것이 아니다. 항공·마지막 배송 구간은 원천이 없다. 「인천 소재 수입자」는 통관 항구가 아니라 사업장 주소 기준이다.</dd>
        </dl>
        <p class="s-cap" data-ai-mark>{aiMark()}</p>
      </section>
    </div>
  </div>
  <script type="application/json" id="trip-data" set:html={JSON.stringify(TRIP)}></script>
  <script define:vars={{ src: u("/data/flowmap.json") }}>window.__fmsrc = src;</script>
  <script>
    import { FlowMap, VIEWS, VIEWS_M, mx, my, type Cam } from "../../lib/flowmap";
    const story = document.querySelector(".story") as HTMLElement, stage = document.getElementById("trip-stage") as HTMLElement, cv = document.getElementById("trip") as HTMLCanvasElement;
    const T = JSON.parse(document.getElementById("trip-data")!.textContent || "{}");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches, lite = matchMedia("(max-width: 720px)").matches;
    // 단계 = 화면 한가운데 줄이 걸친 단계 · 그 단계 안에서 얼마나 내려왔나(0~1) — 스크롤마다 직접 센다(한 프레임에 한 번).
    // [2026-10-14] IntersectionObserver 로 하던 때 느린 CI 에서 크게 건너뛴 스크롤의 콜백이 늦거나 빠져 단계가 안 넘어갔다.
    const steps = [...document.querySelectorAll<HTMLElement>(".st[data-s]")];
    let prog = 0, raf = 0;
    const pick = () => {
      raf = 0;
      const mid = innerHeight / 2;
      let cur = steps.find((el) => { const r = el.getBoundingClientRect(); return r.top <= mid && r.bottom > mid; });
      if (!cur) cur = steps[0].getBoundingClientRect().top > mid ? steps[0] : steps[steps.length - 1];
      const r = cur.getBoundingClientRect();
      prog = Math.min(1, Math.max(0, (mid - r.top) / Math.max(1, r.height)));
      const id = cur.dataset.s!;
      if (story.dataset.step !== id) story.dataset.step = id;
      if (fm && !fm.running) fm.draw();
    };
    addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(pick); }, { passive: true });
    (window as any).__followPick = pick; // 시험 손잡이 — CI 합성기가 굶으면 rAF 가 늦어 단계가 안 넘어간다(QA 147 · 2026-10-15). 시험이 직접 부른다
    addEventListener("resize", () => { if (!raf) raf = requestAnimationFrame(pick); if (fm) { fm.resize(); fm.draw(); } });
    pick();

    // 길 — 경위도 점열 → 메르카토르 · 누적 길이(진행 0~1 로 자리 찾기)
    const mk = (ll: number[][]) => { const p = ll.map(([a, b]) => [mx(a), my(b)]); const c = [0]; for (let i = 1; i < p.length; i++) c.push(c[i - 1] + Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1])); return { p, c, L: c[c.length - 1] }; };
    const at = (P: any, t: number) => { const s = t * P.L; let i = 1; while (i < P.c.length - 1 && P.c[i] < s) i++; const f = (s - P.c[i - 1]) / Math.max(1e-12, P.c[i] - P.c[i - 1]); return [P.p[i - 1][0] + (P.p[i][0] - P.p[i - 1][0]) * f, P.p[i - 1][1] + (P.p[i][1] - P.p[i - 1][1]) * f]; };
    const SEA = mk(T.sea), FIRMS = mk(T.firms), LAST = mk(T.last);
    const ll = (X: number, Y: number) => [X * 360 - 180, (Math.atan(Math.sinh(Math.PI * (1 - 2 * Y))) * 180) / Math.PI];
    // 단계마다 상자 자리와 카메라 — 바다 구간은 카메라가 상자를 따라 날아간다
    const V = lite ? VIEWS_M : VIEWS, oxs = lite ? 0 : 0.18;
    const plan = (id: string, t: number): { box: number[]; cam: Cam; path?: any; upto?: number; dashed?: boolean } => {
      const port = [mx(T.port.lon), my(T.port.lat)], gu = [mx(T.gu.lon), my(T.gu.lat)];
      const C = (X: number, Y: number, zoom: number, pitch: number, bearing: number): Cam => { const [lon, lat] = ll(X, Y); return { lon, lat, zoom, pitch, bearing, ox: oxs, oy: lite ? 0.08 : 0.05 }; };
      switch (id) {
        case "intro": return { box: SEA.p[0], cam: { ...V.asia } };
        case "origin": return { box: SEA.p[0], cam: C(SEA.p[0][0] + 0.004, SEA.p[0][1] - 0.006, 4.8, 48, -12) };
        case "sea": { const b = at(SEA, t); return { box: b, cam: C(b[0], b[1], 5.2 + 3.2 * t * t, 50 + 6 * t, -12 + 20 * t), path: SEA, upto: t }; }
        case "air": return { box: port, cam: C(mx(T.air.lon), my(T.air.lat), 9.3, 54, 8), path: SEA, upto: 1 };
        case "customs": return { box: port, cam: C((port[0] + mx(T.air.lon)) / 2, (port[1] + my(T.air.lat)) / 2, 9.9, 46, 0), path: SEA, upto: 1 };
        case "firms": { const b = at(FIRMS, t); return { box: b, cam: C(b[0], b[1], 10.3, 52, 10), path: FIRMS, upto: t }; }
        case "warehouse": return { box: gu, cam: C(gu[0], gu[1], 9.4, 50, 14), path: FIRMS, upto: 1 };
        case "last": { const b = at(LAST, t); return { box: b, cam: C(b[0], b[1], 9.2, 54, 18), path: LAST, upto: t, dashed: true }; }
        default: return { box: [mx(T.to.lon), my(T.to.lat)], cam: { ...V.incheon }, path: LAST, upto: 1, dashed: true };
      }
    };
    let fm: FlowMap | null = null;
    const ease = (a: number, b: number, k: number) => a + (b - a) * k;
    const camStep = (f: FlowMap, dt: number) => {
      const P = plan(story.dataset.step || "intro", prog), k = reduce ? 1 : 1 - Math.exp(-dt * 3.2), c = f.cam;
      const X = ease(mx(c.lon), mx(P.cam.lon), k), Y = ease(my(c.lat), my(P.cam.lat), k), [lon, lat] = ll(X, Y);
      let db = P.cam.bearing - c.bearing; if (db > 180) db -= 360; if (db < -180) db += 360;
      Object.assign(c, { lon, lat, zoom: ease(c.zoom, P.cam.zoom, k), pitch: ease(c.pitch, P.cam.pitch, k), bearing: c.bearing + db * k, ox: ease(c.ox || 0, P.cam.ox || 0, k), oy: ease(c.oy || 0, P.cam.oy || 0, k) });
    };
    // 덧그림 — 지나온 길(주홍) · 남은 길(옅게) · 상자(흰 테두리 주홍 네모 + 고리)
    const overlay = (ctx: CanvasRenderingContext2D, Pf: any) => {
      const P = plan(story.dataset.step || "intro", prog), o = [0, 0, 0];
      if (P.path) {
        const seg = (from: number, to: number, style: string, w: number, dash: number[]) => {
          ctx.beginPath(); ctx.setLineDash(dash);
          for (let i = 0; i <= 80; i++) { const t = from + ((to - from) * i) / 80, q = at(P.path, t); Pf(q[0], q[1], 0, o); i ? ctx.lineTo(o[0], o[1]) : ctx.moveTo(o[0], o[1]); }
          ctx.strokeStyle = style; ctx.lineWidth = w; ctx.stroke(); ctx.setLineDash([]);
        };
        seg(P.upto ?? 1, 1, "rgba(25,23,20,0.28)", 1.5, [4, 5]);
        seg(0, P.upto ?? 1, "#b3361e", 3.2, P.dashed ? [9, 7] : []);
      }
      Pf(P.box[0], P.box[1], 0, o);
      const pulse = (performance.now() % 1600) / 1600;
      ctx.beginPath(); ctx.arc(o[0], o[1], 9 + pulse * 18, 0, Math.PI * 2); ctx.strokeStyle = `rgba(179,54,30,${0.55 * (1 - pulse)})`; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = "#f5f2eb"; ctx.fillRect(o[0] - 9, o[1] - 7, 18, 14);
      ctx.fillStyle = "#b3361e"; ctx.fillRect(o[0] - 7, o[1] - 5, 14, 10);
      ctx.fillStyle = "rgba(245,242,235,0.85)"; ctx.fillRect(o[0] - 3.5, o[1] - 5, 1.2, 10); ctx.fillRect(o[0] + 2.3, o[1] - 5, 1.2, 10);
    };
    // 이름표 — 경위도 자리 + 화면 px 비킴(단계별 보이기는 CSS)
    const tags = [...document.querySelectorAll<HTMLElement>(".trip__labels .f-tag")];
    // 화면 가장자리에서 잘리지 않게 안쪽으로 붙잡는다(폭은 한 번 잰다 · 화면 크기가 바뀌면 다시)
    const tw = new Map<HTMLElement, number[]>();
    addEventListener("resize", () => tw.clear());
    const place = (f: FlowMap) => {
      for (const t of tags) {
        const [lon, lat] = t.dataset.ll!.split(",").map(Number), s = f.screen(lon, lat);
        if (!tw.has(t)) tw.set(t, [t.offsetWidth, t.offsetHeight]);
        const [w, h] = tw.get(t)!;
        const x = Math.max(6, Math.min(f.W - w - 6, s[0] + Number(t.dataset.dx))), y = Math.max(6, Math.min(f.H - h - 6, s[1] + Number(t.dataset.dy)));
        t.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;
      }
    };

    const boot = async () => {
      const D = await fetch((window as any).__fmsrc).then((r) => r.json());
      fm = new FlowMap(cv, D, { unit: lite ? 2.5 : 1.2, monthSec: 7, maxDpr: lite ? 1.5 : 2, lite, dim: 0.45, overlay, camStep, onFrame: place }, { ...plan(story.dataset.step || "intro", prog).cam });
      (window as any).__trip = fm;
      fm.warm(6); fm.draw();
      stage.dataset.ready = "1";
      if (!reduce) fm.start();
      new IntersectionObserver(([e]) => { if (!fm) return; if (e.isIntersecting && !reduce) fm.start(); else fm.stop(); }).observe(stage);
      document.addEventListener("visibilitychange", () => { if (!fm) return; if (document.hidden) fm.stop(); else if (!reduce) fm.start(); });
    };
    let booted = false;
    const kick = () => { if (booted) return; booted = true; boot().catch((e) => { stage.dataset.ready = "error"; console.error(e); }); };
    const go = () => {
      if (!lite) { "requestIdleCallback" in window ? (window as any).requestIdleCallback(kick, { timeout: 1500 }) : setTimeout(kick, 300); return; }
      for (const ev of ["touchstart", "pointerdown", "scroll", "keydown", "wheel"]) addEventListener(ev, kick, { once: true, passive: true });
    };
    document.readyState === "complete" ? go() : addEventListener("load", go, { once: true });
  </script>
</Studio>
