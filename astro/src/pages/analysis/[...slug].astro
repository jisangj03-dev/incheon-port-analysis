---
import { getCollection, render } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { title, lastUpdated } from "../../lib/content";
export async function getStaticPaths() {
  return (await getCollection("analysis")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const t = title(entry.body ?? "") || entry.id;
---
<Doc title={t} path={`/analysis/${entry.id}.html`} updated={lastUpdated(`analysis/${entry.id}.md`)} kind="재현 문서"><Content /></Doc>
