// 보고서 본문(/reports/<편>.html)도 내렸다 — 같은 노트 지면으로 넘긴다(2026-10-21 전수 사실 대조: 「본문 주소는 그대로」가 사실과 달랐다).
import Redirect from "../../layouts/Redirect.astro";
