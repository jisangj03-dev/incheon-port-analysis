---
// 보고서 지면 — 3층(기준 18): ① 한 줄 결론 + 시각 한 장 ② 직접 만지는 차트(없으면 「준비 중」) ③ 원문·근거·출처(접힘).
// 발행본 본문은 한 글자도 바꾸지 않는다 — 그릇만 바꾼다. 첫 H1 은 머리에 같은 글자로 올리고 본문에서는 뺀다(제목 둘 방지).
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Updated from "../../components/Updated.astro";
import { sourceLine } from "../../lib/sources";
import { profile } from "../../lib/profile";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";

import Interactive from "../../components/report/Interactive.astro";
import ReportChart from "../../components/report/ReportChart.astro";
import { REPORT_WIDGET } from "../../lib/report-data";
import { title, splitTitle, conclusion, written, firstImage, description, lastUpdated } from "../../lib/content";
import { u, abs, BRAND } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("reports");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const body = entry.body ?? "";
const t = title(body);
const { no, text } = splitTitle(t);
const concl = conclusion(body);
const img = firstImage(body);
const date = written(body);
const updated = lastUpdated(`reports/${entry.id}.md`);
const path = `/reports/${entry.id}.html`;
const { Content } = await render(entry);
const SRC = JSON.parse(readFileSync(join(repoRoot(), "data/sources.json"), "utf-8")).sources.filter((s: any) => (s.used_by || []).includes(entry.id)).map((s: any) => sourceLine(s.id));
const PF = profile();
const kind = no ? `보고서 ${no}` : "정리형 스냅샷";
const jsonld = [{
  "@context": "https://schema.org", "@type": "Report", headline: t, name: t, inLanguage: "ko",
  description: concl || undefined, datePublished: date || undefined, dateModified: updated || undefined,
  author: { "@type": "Person", name: PF.name }, publisher: { "@type": "Organization", name: BRAND.name },
  url: abs(path), isAccessibleForFree: true,
}];
---
<Base title={t} description={description(body, t)} path={path} jsonld={jsonld} ogImage={`/og/${entry.id}.jpg`}>
  <article class="rpt">
    <header class="rpt__head wrap">
      <p class="eyebrow">{kind}{date && <> · {date}</>}</p>
      <h1>{text}</h1>
      {concl && (
        <div class="rpt__concl">
          <p class="rpt__label">한 줄 결론</p>
          <p class="rpt__answer">{concl}</p>
        </div>
      )}
    </header>

    <section class="rpt__layer wrap" aria-labelledby="l1">
      <h2 id="l1" class="rpt__lh"><span>①</span> 한 장으로 보기</h2>
      {img ? (
        <figure class="rpt__fig">
          <img src={u(`/reports/${img.src.replace(/^\.\//, "")}`)} alt={img.alt || t} loading="eager" decoding="async" />
          <figcaption>{img.alt} <Updated date={updated} source="발행본 그림" /></figcaption>
        </figure>
      ) : <p class="muted">이 편은 대표 그림이 없다 — 표가 본문(③)에 있다. <Updated date={updated} /></p>}
    </section>

    <section class="rpt__layer wrap" aria-labelledby="l2">
      <h2 id="l2" class="rpt__lh"><span>②</span> 직접 만져 보기</h2>
      {REPORT_WIDGET[entry.id] ? <ReportChart id={entry.id} /> : <Interactive id={entry.id} />}
    </section>

    <section class="rpt__layer wrap" aria-labelledby="l3">
      <h2 id="l3" class="rpt__lh"><span>③</span> 원문 · 근거 · 출처</h2>
      <p class="muted" data-sources>출처와 이용허락 — {SRC.length ? SRC.join(" / ") : "출처 대장에 행이 없다"} · <a href={u("/data.html")}>출처 대장</a></p>
      <details class="fold" id="original">
        <summary>발행본 전문 펼치기 — 판정 기준·표·재현 방법·표기</summary>
        <div class="fold__body doc narrow-doc" data-pagefind-body>
          <Content />
        </div>
      </details>
    </section>
  </article>
  <style>
    .rpt__head { padding-top: clamp(2rem, 6vw, 4.5rem); }
    .rpt__head h1 { max-width: 22ch; margin-top: 0.2em; }
    .rpt__concl { margin-top: 1.5rem; padding: 1.3rem 1.5rem; border-radius: var(--r-lg); background: linear-gradient(135deg, var(--hull), var(--hull-2)); border: 1px solid var(--hair); max-width: 880px; }
    .rpt__label { margin: 0 0 0.3rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; color: var(--sodium); }
    .rpt__answer { margin: 0; font-size: clamp(1.1rem, 2.1vw, 1.45rem); font-weight: 650; color: var(--ink); line-height: 1.55; }
    .rpt__layer { margin-top: 2.5rem; }
    .rpt__lh { font-size: 1rem; letter-spacing: 0.04em; color: var(--mist); font-weight: 700; display: flex; gap: 0.5rem; align-items: center; }
    .rpt__lh span { color: var(--sonar); }
    .rpt__fig { margin: 0; background: #fff; border-radius: var(--r-lg); padding: clamp(0.5rem, 2vw, 1.25rem); max-width: 980px; }
    .rpt__fig img { display: block; width: 100%; height: auto; margin: 0 auto; }
    .rpt__fig figcaption { color: #334; font-size: 0.85rem; padding: 0.6rem 0.25rem 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; }
    .rpt__fig figcaption :global(.updated) { color: #3c4f5e; }
    .narrow-doc { max-width: 820px; }
    .narrow-doc :global(h1:first-child) { display: none; }
  </style>
</Base>
