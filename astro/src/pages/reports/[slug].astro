---
// [2026-10-20 내림 · docs/품질기준.md · 독립 화면 판정·사실 대조] 보고서 14편 — 기본 차트(matplotlib) · 「준비 중」 칸 · 내부 작업 용어(PASS/FAIL·코드명·파일 경로) ·
//   출처 문구가 본문 위 · 차트가 접힘선 아래. 이번에 사이트 기준으로 못 올려 내렸다. 원문(reports/*.md)·재현 코드·판정 기록은 저장소에 그대로 있다.
import { getCollection } from "astro:content";
import Redirect from "../../layouts/Redirect.astro";
export async function getStaticPaths() {
  return (await getCollection("reports")).map((entry) => ({ params: { slug: entry.id } }));
}
const { slug } = Astro.params;
---
<Redirect path={`/reports/${slug}.html`} to="/notes.html" label="노트" why="이 보고서는 사이트 기준(그림·용어·첫 화면)에 맞춰 다시 쓰는 중이라 내렸습니다. 원문과 재현 코드는 저장소(GitHub)에 그대로 있습니다." />
