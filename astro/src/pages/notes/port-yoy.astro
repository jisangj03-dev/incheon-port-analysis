---
// 노트 한 장 — 자라는 노트(디지털 가든 원리: 단계 · 심은 날/고친 날 · 이어지는 노트 · 되짚는 노트).
// 단계·연결은 콘텐츠 목록(data/rooms.json)이 들고, 날짜는 git 기록에서 자동. 숫자는 데이터 파일에서만(정체성 §2-1).
import { aiMark } from "../../lib/profile";
import Studio from "../../layouts/Studio.astro";
import Trust from "../../components/scene/Trust.astro";
import { notes, STAGES } from "../../lib/rooms";
import { portMonthly } from "../../lib/data";
import { u } from "../../lib/site";
import { sourceLine } from "../../lib/sources";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";

const N = notes();
const me = N.find((n) => n.id === "note-port-yoy")!;
const byId = (id: string) => N.find((n) => n.id === id);
const P = portMonthly();
const S = P.series.filter((s) => s.yoy !== null).slice(-24);
const last = S[S.length - 1];
const V = JSON.parse(readFileSync(join(repoRoot(), "data/derived/vessel_replay.json"), "utf-8")).latest;
const mark: Record<string, string> = { "초안": "○", "갱신 중": "◐", "정본": "●" };
// 막대 — 전년 같은 달 대비 %(0 위 = 먹 · 0 아래 = 주홍) · 범례 없이 끝 막대에 직접 이름
const W = 1000, H = 260, pad = 28;
const ymax = Math.max(...S.map((s) => Math.abs(s.yoy as number)), 1);
const bw = (W - 2 * pad) / S.length;
const y0 = H / 2;
const bars = S.map((s, i) => { const v = s.yoy as number, h = (Math.abs(v) / ymax) * (H / 2 - pad); return { x: pad + i * bw + 1, y: v >= 0 ? y0 - h : y0, h, neg: v < 0, ym: s.ym, v }; });
---
<Studio title={`${me.title} — 측심`} description="인천항 컨테이너 처리량을 작년 같은 달과 달마다 다시 견주는 노트. 숫자는 해양수산부 공표 계열에서." current="notes">
  <article class="s-wrap note" data-content="ds-note">
    <p class="s-cap stage-line"><b aria-hidden="true">{mark[me.stage]}</b> {me.stage} · 심은 날 {me.planted} · 고친 날 {me.tended}</p>
    <h1 class="s-prose">{me.title}</h1>
    <p class="s-lead s-prose">{last.ym} 인천항 컨테이너는 작년 같은 달보다 <strong class={(last.yoy as number) < 0 ? "s-signal" : ""}>{(last.yoy as number) > 0 ? "+" : (last.yoy as number) < 0 ? "−" : ""}{Math.abs(last.yoy as number)}%</strong>였습니다. 한 달 숫자로는 아무것도 말하지 않습니다 — 그래서 달마다 다시 잽니다.</p>

    <p class="counter s-prose"><b>반대 지표</b> — 배로 세면 인천은 부산에 한참 못 미칩니다. {V.ym} 외항선 입항 인천 <b>{V.incheon}</b>척, 부산 <b>{V.busan}</b>척(<b class="s-signal">{V.busan_to_incheon}</b>배) — <a href={u("/map/vessels.html")}>선박 리플레이</a>.</p>
    <p class="s-cap s-prose">반대 지표 출처 {sourceLine("mof-vessel")} · 월 집계(개별 선박 아님)</p>

    <figure class="yoy">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${S[0].ym}부터 ${last.ym}까지 전년 같은 달 대비 증감`}>
        <line x1={pad} x2={W - pad} y1={y0} y2={y0} stroke="var(--s-rule)" vector-effect="non-scaling-stroke" />
        {bars.map((b) => <rect x={b.x.toFixed(1)} y={b.y.toFixed(1)} width={(bw - 2).toFixed(1)} height={Math.max(1, b.h).toFixed(1)} fill={b.neg ? "var(--s-signal)" : "var(--s-ink-2)"}><title>{b.ym} {b.v}%</title></rect>)}
      </svg>
      <div class="yoy__axis s-cap"><span>{S[0].ym}</span><span>0 위 = 작년보다 많음 · 0 아래(주홍) = 작년보다 적음</span><span>{last.ym}</span></div>
      <Trust updated={P.updated} source={P.source} csv={u("/data/port-monthly.csv")} csvName="incheon-port-monthly.csv" note="전년 같은 달 대비 %" />
    </figure>

    <section class="grow">
      <h2>이 노트가 자라려면</h2>
      <ol class="s-prose">
        <li>터미널별로 나눠 같은 달에 누가 줄었는지 본다 — <a href={u(byId("report_11_터미널별_처리량")!.href)}>터미널별 처리량</a> 노트와 잇는다.</li>
        <li>줄어든 달이 이어지는지, 한 달짜리인지 가를 기준을 데이터를 받기 전에 먼저 적는다.</li>
        <li>그 기준을 통과하면 이 노트는 「정본」이 된다. 통과하지 못해도 지우지 않고 그 결과를 적는다.</li>
      </ol>
    </section>

    <section class="links">
      <div>
        <h2 class="s-cap">이어지는 노트</h2>
        <ul>{me.links.map((id) => byId(id)).filter(Boolean).map((n) => <li><b aria-hidden="true">{mark[n!.stage]}</b> <a href={u(n!.href)}>{n!.title}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="s-cap">이 노트로 오는 노트</h2>
        {me.backlinks.length ? <ul>{me.backlinks.map((id) => byId(id)).filter(Boolean).map((n) => <li><b aria-hidden="true">{mark[n!.stage]}</b> <a href={u(n!.href)}>{n!.title}</a></li>)}</ul> : <p class="s-cap">아직 없습니다 — 심은 지 얼마 안 된 노트입니다.</p>}
      </div>
    </section>
    <p class="s-cap legend">{STAGES.map((s) => <span><b aria-hidden="true">{mark[s]}</b> {s}</span>)} — 초안(심었다) · 갱신 중(달마다 숫자가 바뀐다) · 정본(먼저 적은 기준으로 판정을 마쳤다)</p>
    <p class="s-cap" data-ai-mark>{aiMark()}</p>
  </article>
</Studio>
<style>
  .counter { border-left: 3px solid var(--s-signal); padding-left: var(--s-4); margin-top: var(--s-5); }
  .note { padding-top: var(--s-8); padding-bottom: var(--s-8); }
  .stage-line b { color: var(--s-signal); font-weight: 400; }
  .note h1 { margin: var(--s-3) 0 var(--s-5); max-width: 18em; }
  .yoy { margin: var(--s-7) 0 0; }
  .yoy svg { display: block; width: 100%; height: 220px; }
  .yoy__axis { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-2); }
  .grow { margin-top: var(--s-8); border-top: 1px solid var(--s-rule); padding-top: var(--s-6); }
  .grow h2, .links h2 { font-size: var(--s-t-h3); margin-bottom: var(--s-4); }
  .grow li { margin-bottom: var(--s-3); }
  .links { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); margin-top: var(--s-7); border-top: 1px solid var(--s-rule); padding-top: var(--s-6); }
  .links h2.s-cap { font-size: var(--s-t-cap); font-weight: 400; letter-spacing: 0; }
  .links ul { list-style: none; padding: 0; margin: 0; }
  .links li { padding: var(--s-2) 0; }
  .links b, .legend b { font-weight: 400; color: var(--s-ink-2); }
  .legend { margin-top: var(--s-7); display: flex; gap: var(--s-4); flex-wrap: wrap; }
  @media (max-width: 560px) { .links { grid-template-columns: 1fr; gap: var(--s-5); } .yoy__axis span:nth-child(2) { display: none; } .yoy svg { height: 160px; } }
</style>
