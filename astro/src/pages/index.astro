---
// 홈 — 「해도」 한 장 위로 신항→수도권 주홍 선이 스크롤을 따라 그려진다(pudding·Reuters 의 스크롤 이야기 원리).
// 방·노트는 콘텐츠 목록 하나(data/rooms.json)에서 자동 배치. 숫자는 데이터 파일에서만(정체성 §2-1).
// 실명·소속·연락처는 data/profile.json 한 곳에서(정체성 §5-4 공개 전환 · 2026-10-14).
import Studio from "../layouts/Studio.astro";
import Scene from "../components/scene/Scene.astro";
import Trust from "../components/scene/Trust.astro";
import NoteList from "../components/scene/NoteList.astro";
import { portMonthly, mapSeries } from "../lib/data";
import { rooms, route } from "../lib/rooms";
import { u } from "../lib/site";
import Haedo from "../components/scene/Haedo.astro";
import Contact from "../components/scene/Contact.astro";
import { profile } from "../lib/profile";
import { curve } from "../lib/haedo-geo";
import { sourceLine } from "../lib/sources";

const P = portMonthly();
const S = P.series;
const last = S[S.length - 1];
const R = rooms();
const RT = route();
const PF = profile();

// ── 해도 한 장(부품 Haedo · 빌드 때 SVG · 외부 요청 0) — 보이는 범위는 화면 비율에 맞춰 신항·인천공항·서울을 한 장면으로
const M = mapSeries();
const places = M.places.map((p: any) => ({ id: p.id, lon: p.lon, lat: p.lat, v: p.values ? p.values[p.values.length - 1] : null }));
const vmax = Math.max(...places.map((p: any) => p.v || 0));
const from = places.find((p: any) => p.id === RT.from)!;
const routeD = curve([from.lon, from.lat], [RT.to.lon, RT.to.lat]);
const hpts = places.map((p: any) => ({ ...p, cls: p.v === vmax ? "top" : "" })).concat([{ id: "to", label: RT.to.label, lon: RT.to.lon, lat: RT.to.lat, v: null, cls: "to" }]);
const hfit: [number, number][] = hpts.map((p: any) => [p.lon, p.lat]);

// ── 숫자 장면(달 막대로 앞뒤로 움직인다) ──
const W = 1000, H = 220, pad = 10;
const vs = S.map((s) => s.v), lo = Math.min(...vs), hi = Math.max(...vs);
const sx = (i: number) => pad + (i * (W - 2 * pad)) / (S.length - 1);
const sy = (v: number) => H - pad - ((v - lo) * (H - 2 * pad)) / (hi - lo || 1);
const spark = S.map((s, i) => `${i ? "L" : "M"}${sx(i).toFixed(1)},${sy(s.v).toFixed(1)}`).join("");
const iHi = vs.indexOf(hi), iLo = vs.indexOf(lo);
const pct = (i: number) => `${((sx(i) / W) * 100).toFixed(2)}%`;
const series = S.map((s, i) => ({ ym: s.ym, v: s.v, yoy: s.yoy, x: +sx(i).toFixed(1), y: +sy(s.v).toFixed(1) }));
---
<Studio title="측심 — SCM 작업실" current="home" path="/">
  <div class="hero" data-content="ds-home-hero">
    <div class="hero__stick">
      <Haedo id="hero-map" points={hpts} fit={hfit} vmax={vmax} pad={{ tText: ".hero__text" }}>
        <path slot="over" d={routeD} class="route" id="route" pathLength="1" data-wpx="3" />
      </Haedo>
      <div class="s-wrap hero__text">
        <h1 class="s-prose"><span class="s-signal">인천</span>을 지나는 물건의 길을, 공공 1차 데이터로 잽니다.</h1>
        <p class="s-lead s-prose">{PF.name}의 SCM 작업실입니다. 항만·공항·창고를 잇는 수도권 공급망을 실제 숫자로 움직여 보여 줍니다.</p>
      </div>
      <p class="s-wrap s-cap hero__cap">주홍 선은 신항에서 {RT.to.label} 쪽으로 긋는 개념선입니다 — 실제 운송 경로가 아닙니다. 숫자는 {M.months[M.months.length - 1]} 컨테이너 처리량(천TEU) · 땅·고속도로 © OpenStreetMap 기여자(ODbL) · 등심선 NOAA ETOPO 2022(항해용 아님).</p>
    </div>
  </div>

  <div class="s-wrap" data-content="ds-home">
    <Scene kind="num" id="now">
      <h2 class="s-cap now-h"><span id="now-ym">{last.ym}</span> 한 달 동안 인천항으로 드나든 컨테이너</h2>
      <p class="s-num"><span id="now-v">{last.v}</span><span class="s-unit">천TEU</span></p>
      <p class="s-lead s-prose">작년 같은 달보다 <strong id="now-yoy" class={last.yoy !== null && last.yoy < 0 ? "s-signal" : ""}>{last.yoy === null ? "—" : `${last.yoy > 0 ? "+" : last.yoy < 0 ? "−" : ""}${Math.abs(last.yoy)}%`}</strong>. 주장에 불리한 숫자도 같은 자리에 둡니다.</p>
      <figure class="spark">
        <div class="spark-box">
          <div class="spark-in">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${S[0].ym}부터 ${last.ym}까지 월별 처리량`}>
            <path d={spark} fill="none" stroke="var(--s-ink-2)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            <line id="now-rule" x1={sx(S.length - 1)} x2={sx(S.length - 1)} y1="0" y2={H} stroke="var(--s-rule)" vector-effect="non-scaling-stroke" />
          </svg>
          <span id="now-dot" class="dot" style={`left:${pct(S.length - 1)};top:${((sy(last.v) / H) * 100).toFixed(2)}%`}></span>
          </div>
          <span class="mark hi" style={`left:${pct(iHi)}`}>가장 많은 달 {S[iHi].ym} · {hi}</span>
          <span class="mark lo" style={`left:${pct(iLo)}`}>가장 적은 달 {S[iLo].ym} · {lo}</span>
        </div>
        <label class="scrub"><span class="s-cap">달을 옮겨 보세요</span><input id="now-m" type="range" min="0" max={S.length - 1} value={S.length - 1} step="1" aria-label="달 고르기" /></label>
        <Trust updated={P.updated} source={sourceLine("mof-incheon-port-stats")} csv={u("/data/port-monthly.csv")} csvName="incheon-port-monthly.csv" note="월별 · 천TEU" />
      </figure>
      <script type="application/json" id="now-data" set:html={JSON.stringify(series)}></script>
    </Scene>

    <Scene kind="text" title="네 개의 방">
      <ol class="s-index">
        {R.map((r) => <li><div><h3><a href={r.href.startsWith("#") ? r.href : u(r.href)}>{r.title}</a></h3><p>{r.lead}</p>{r.items && r.items.length > 0 && <ul class="room-items">{r.items.map((it) => <li><a href={u(it.href)}>{it.title}</a></li>)}</ul>}</div></li>)}
      </ol>
    </Scene>

    <Scene kind="note" id="notes" title="노트" lead="심은 날과 고친 날을 박아 둡니다. 초안에서 정본으로 자랍니다.">
      <NoteList limit={6} />
    </Scene>

    <Scene kind="text" id="about" title="소개">
      <p class="s-lead s-prose">{PF.name} · {PF.affiliation}. {PF.credentials.join(" · ")}{PF.writing.length > 0 && ` · ${PF.writing.map((w) => w.title).join(" · ")}`}.</p>
      <p class="s-prose">공급망이 어디서 막히고 어디서 출렁이는지를 숫자로 보이는 일을 합니다. 틀린 곳을 알려 주시면 고쳐 적습니다. <a href={u("/about.html")}>소개 더 보기</a></p>
      <Contact />
    </Scene>
  </div>
  <script>
    import { initHaedo } from "../lib/haedo";
    // ① 스크롤을 따라 주홍 선이 그려진다(움직임 줄이기 설정이면 처음부터 다 그린 채)
    const hero = document.querySelector(".hero") as HTMLElement, path = document.getElementById("route") as unknown as SVGPathElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const draw = () => {
      const r = hero.getBoundingClientRect(), span = Math.max(1, hero.offsetHeight - innerHeight);
      const t = reduce ? 1 : Math.min(1, Math.max(0, (-r.top + innerHeight * 0.15) / span));
      path.style.strokeDashoffset = String(1 - t);
      hero.dataset.progress = t.toFixed(2);
    };
    addEventListener("scroll", draw, { passive: true }); addEventListener("resize", draw); draw();
    // ⓪ 화면 비율에 맞춘다(부품) — 글자 뒤 바림 높이도 같이
    const fig = document.getElementById("hero-map") as HTMLElement;
    initHaedo(fig, () => (document.querySelector(".hero__stick") as HTMLElement).style.setProperty("--fade", `${(document.querySelector(".hero__text") as HTMLElement).getBoundingClientRect().height + 40}px`));
    // ② 달 막대 — 큰 숫자·전년 대비·점이 같이 움직인다
    const D = JSON.parse(document.getElementById("now-data")!.textContent || "[]");
    const m = document.getElementById("now-m") as HTMLInputElement, $ = (id: string) => document.getElementById(id)!;
    m.addEventListener("input", () => {
      const s = D[Number(m.value)];
      $("now-ym").textContent = s.ym; $("now-v").textContent = String(s.v);
      const y = $("now-yoy"); y.textContent = s.yoy === null ? "—" : `${s.yoy > 0 ? "+" : s.yoy < 0 ? "−" : ""}${Math.abs(s.yoy)}%`; y.className = s.yoy !== null && s.yoy < 0 ? "s-signal" : "";
      const dot = $("now-dot"); dot.style.left = `${(s.x / 10).toFixed(2)}%`; dot.style.top = `${((s.y / 220) * 100).toFixed(2)}%`;
      $("now-rule").setAttribute("x1", String(s.x)); $("now-rule").setAttribute("x2", String(s.x));
    });
  </script>
</Studio>
<style>
  .room-items { list-style: none; margin: var(--s-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .room-items a { min-height: 44px; display: inline-flex; align-items: center; }
  .hero { height: 190vh; position: relative; }
  .hero__stick { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .hero__text { position: absolute; top: 0; left: 0; right: 0; padding-top: var(--s-6); padding-bottom: var(--s-6); z-index: 2; pointer-events: none; }
  /* 글자 뒤는 종이로 옅게 덮는다(상자 없이 · 아래로 사라지는 바림) */
  .hero__stick::before { content: ""; position: absolute; inset: 0 0 auto 0; height: var(--fade, 42%); background: linear-gradient(var(--s-paper) 55%, rgba(245, 242, 235, 0)); z-index: 1; pointer-events: none; }
  .hero__text h1 { font-size: clamp(32px, 4.8vw, 64px); text-shadow: 0 0 12px var(--s-paper), 0 0 4px var(--s-paper); }
  .hero__text .s-lead { margin-top: var(--s-4); text-shadow: 0 0 8px var(--s-paper); }
  .hero__cap { position: absolute; left: 0; right: 0; bottom: 30px; z-index: 2; text-shadow: 0 0 6px var(--s-paper), 0 0 3px var(--s-paper); }
  .route { fill: none; stroke: var(--s-signal); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .now-h { font-weight: 400; letter-spacing: 0; margin-bottom: var(--s-3); }
  .spark { margin: 48px 0 0; }
  .spark-box { position: relative; padding: 28px 0; }
  .spark-in { position: relative; }
  .spark svg { display: block; width: 100%; height: 180px; }
  .dot { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--s-signal); }
  .mark { position: absolute; transform: translateX(-50%); font-size: var(--s-t-cap); color: var(--s-ink-3); white-space: nowrap; line-height: 1; }
  .mark.hi { top: 0; } .mark.lo { bottom: 0; }
  .scrub { display: grid; gap: var(--s-1); margin-top: var(--s-4); }
  .scrub input { width: 100%; accent-color: var(--s-signal); min-height: 44px; margin: 0; }
  .contact { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  @media (max-width: 560px) {
    .hero { height: 170vh; }
    .spark svg { height: 120px; } .mark { transform: none; left: 0 !important; } .mark.hi { top: 4px; }

  }
</style>
