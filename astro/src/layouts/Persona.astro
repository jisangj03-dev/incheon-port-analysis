---
// 사람별 입구 지면(개편 기준 12 · A1) — 같은 보고서·도구를 그 사람이 찾는 순서로 다시 늘어놓는다. 새 숫자를 만들지 않는다.
import Base from "./Base.astro";
interface Props { who: string; title: string; description: string; path: string }
const { who, title, description, path } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <div class="narrow" style="padding-top:2.5rem">
    <p class="eyebrow">{who}</p>
    <h1>{title}</h1>
    <slot />
  </div>
</Base>
<style is:global>
  .pl { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .pl a { display: block; padding: 0.9rem 1.1rem; border-radius: var(--r-md); border: 1px solid var(--hair); background: color-mix(in srgb, var(--hull) 55%, transparent); text-decoration: none; color: var(--text); }
  .pl a:hover { border-color: var(--sonar); }
  .pl strong { display: block; color: var(--ink); }
  .pl span { font-size: 0.9rem; color: var(--mist); }
  .soon { border: 1px dashed var(--hair-strong); border-radius: var(--r-md); padding: 0.9rem 1.1rem; color: var(--mist); }
  .soon strong { color: var(--sodium); }
  dl.gl dt { font-weight: 800; color: var(--ink); margin-top: 0.9rem; }
  dl.gl dd { margin: 0.2rem 0 0; }
</style>
