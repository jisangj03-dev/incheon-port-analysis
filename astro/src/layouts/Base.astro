---
// 모든 지면의 그릇(기준 10 「레이아웃 없는 지면 0」). 머리: 제목·설명·OG·정본 주소·구조화 데이터(기준 9 · AI 검색 인용).
// 바닥: 신뢰 지면(기준 15) · 뉴스레터 구독(기준 24 · 물류로그 beehiiv) · 출처·라이선스 고지. 외부 요청은 Cloudflare 분석 하나(기준 17).
import "../styles/global.css";
import { BRAND, NAV, u, abs, REPO, ISSUES, CF_BEACON, newsletterHref, newsletterLabel } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path: string; // 기준주소 뺀 지면 경로. 예: "/tools/logistics-cost.html"
  ogImage?: string;
  surface?: "dark" | "light";
  type?: "website" | "article";
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  wide?: boolean;
  /** Pretendard 를 붙일까. 도구 지면(밝은 작업 화면)은 시스템 서체로 간다 — 글자 묶음 열몇 개를 안 받는다(기준 10 성능). */
  fonts?: boolean;
}
const { title, description = BRAND.description, path, ogImage = "/assets/og.jpg", surface = "dark", type = "article", noindex = false, jsonld = [], wide = false, fonts = surface !== "light" } = Astro.props;
const fullTitle = title ? `${title} · ${BRAND.name}` : `${BRAND.name} — ${BRAND.tagline}`;
const canonical = abs(path);
const cur = (href: string) => (href === "/" ? path === "/" || path === "/index.html" : path.startsWith(href.replace(/\.html$/, "")));
const ld = [
  { "@context": "https://schema.org", "@type": "WebSite", name: BRAND.name, alternateName: BRAND.latin, url: abs("/"), inLanguage: "ko", description: BRAND.description },
  ...jsonld,
];
const analytics = import.meta.env.PROD && process.env.SOUNDING_NO_ANALYTICS !== "1"; // 로컬 성능 측정 때만 끈다
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content={surface === "light" ? "#f6f9fb" : "#0b1a26"} />
  <link rel="icon" type="image/svg+xml" href={u("/assets/favicon.svg")} />
  <link rel="apple-touch-icon" href={u("/assets/apple-touch-icon.png")} />
  <!-- 글꼴 CSS(동적 부분집합 92묶음 · 56KB)는 첫 화면을 막지 않게 비동기로 붙인다. 스크립트가 없으면 noscript 로. -->
  {fonts && <link rel="preload" href={u("/fonts/pretendard/pretendard.css")} as="style" onload="this.onload=null;this.rel='stylesheet'" />}
  {fonts && <noscript><link rel="stylesheet" href={u("/fonts/pretendard/pretendard.css")} /></noscript>}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title ?? `${BRAND.name} — ${BRAND.tagline}`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={abs(ogImage)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={abs(ogImage)} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <slot name="head" />
  {analytics && (
    <Fragment set:html={`<!-- Cloudflare Web Analytics --><script type='module' src='${CF_BEACON.src}' data-cf-beacon='{"token": "${CF_BEACON.token}"}'></script><!-- End Cloudflare Web Analytics -->`} />
  )}
</head>
<body data-surface={surface}>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="mast">
    <div class="wrap mast__in">
      <a class="brand" href={u("/")} aria-label={`${BRAND.name} 첫 화면`}>
        <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square"><path d="M32 4v34M23 12h9M23 21h9M23 30h9M10 60h44" /></g><path fill="currentColor" d="M24 38h16l-3 18H27z" /></svg>
        <span class="brand__name">{BRAND.name}</span>
        <span class="brand__sub">{BRAND.latin}</span>
      </a>
      <nav aria-label="사이트">
        {NAV.map((n) => <a href={u(n.href)} aria-current={cur(n.href) ? "page" : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1" class={wide ? "" : ""}>
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot__in">
      <div class="foot__brand">
        <p><strong>{BRAND.name} · {BRAND.latin}</strong><br />{BRAND.lede}</p>
        <p><a class="btn" href={newsletterHref()} data-newsletter>{newsletterLabel()}</a></p>
      </div>
      <div>
        <h2>믿을 수 있나</h2>
        <ul>
          <li><a href={u("/about.html")} data-trust>방법론 · 출처 · 필명과 자격</a></li>
          <li><a href={u("/data.html")}>데이터 출처와 이용허락</a></li>
          <li><a href={ISSUES}>오류 신고</a></li>
        </ul>
      </div>
      <div>
        <h2>둘러보기</h2>
        <ul>
          <li><a href={u("/reports/")}>보고서</a></li>
          <li><a href={u("/tools/")}>셀러 물류 도구</a></li>
          <li><a href={REPO}>원시 데이터와 재현 코드</a></li>
        </ul>
      </div>
      <p class="foot__legal">
        이 사이트의 내용은 공공 1차 데이터를 정리한 정보이며 <strong>법률·세무·관세 자문이 아닙니다.</strong>
        AI로 만든 장면에는 화면 안에 「AI 생성 장면」을 표기합니다. 발행된 보고서의 주소는 바꾸지 않고, 오류는 지우지 않고 정정 표기로 남깁니다.
        글꼴 Pretendard(OFL-1.1).
      </p>
    </div>
  </footer>
  <slot name="after" />
</body>
</html>
