---
// 측심 디자인 시스템 「해도」 시안 레이아웃(2026-10-14 · docs/측심_디자인시스템_20261014.md).
// lab/ds/ 시안 지면만 쓴다 — 공개 지면은 Base.astro 그대로(공개 화면 변화 0). 분석·외부 요청 0 · noindex.
import "../styles/studio.css";
import { u } from "../lib/site";
interface Props { title: string; current?: "map" | "sim" | "notes" | "about" | "home" }
const { title, current = "home" } = Astro.props;
const NAV = [
  ["map", "지도", "/lab/ds/map.html"],
  ["sim", "시뮬레이션", "/lab/ds/beer.html"],
  ["notes", "노트", "/lab/ds/index.html#notes"],
  ["about", "소개", "/lab/ds/index.html#about"],
] as const;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <link rel="stylesheet" href={u("/fonts/pretendard/pretendard.css")} />
</head>
<body class="studio">
  <header class="s-wrap s-mast">
    <a class="s-mark" href={u("/lab/ds/index.html")}>측심<small>SCM 작업실</small></a>
    <nav class="s-nav" aria-label="주 메뉴">
      {NAV.map(([id, label, href]) => <a href={u(href)} aria-current={current === id ? "page" : undefined}>{label}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer class="s-wrap s-foot">
    <hr class="s-rule" />
    <p style="margin-top:16px">공공 1차 데이터로 잽니다 · 법률·세무 자문이 아닙니다 · 시안(공개 전)</p>
  </footer>
</body>
</html>
