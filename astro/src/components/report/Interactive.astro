---
// 보고서 ② 층 — 직접 만지는 차트·지도·시뮬레이션(기준 18). 아직 없는 편은 「준비 중」을 숨기지 않고 적는다.
// 편별 위젯은 데이터가 빌드 시 스냅샷으로 들어오는 대로 여기에 하나씩 붙인다(2단계 PR 부터).
import { u } from "../../lib/site";
interface Props { id: string }
const { id } = Astro.props;
const related: Record<string, { href: string; label: string }> = {
  "물류창고": { href: "/tools/warehouse-map.html", label: "구·동 배치도에서 개소·면적·냉동냉장을 바꿔 보기" },
};
const r = related[id];
---
{r ? (
  <p class="ia"><a class="btn btn--primary" href={u(r.href)}>{r.label}</a></p>
) : (
  <div class="ia ia--todo" data-interactive="todo">
    <p><strong>준비 중</strong> — 이 편의 숫자를 직접 고르고 바꿔 보는 차트는 아직 없다. 원시 CSV 는 저장소에 있고, 차트는 다음 단계에서 이 자리에 붙는다.</p>
  </div>
)}
<style>
  .ia--todo { border: 1px dashed var(--hair-strong); border-radius: var(--r-md); padding: 1rem 1.2rem; color: var(--mist); max-width: 880px; }
  .ia--todo p { margin: 0; }
  .ia--todo strong { color: var(--sodium); }
</style>
