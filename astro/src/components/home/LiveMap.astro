---
// 홈 첫 화면 — 살아 있는 인천 물류 지도(2026-10-14 선장님 판정 「동적인 콘텐츠·목적이 와닿지 않는다」 · 채팅 위임 A·B).
// 첫 그림 = 빌드 때 그린 정지 해도(같은 투영 · 스크립트 0) → 페이지가 다 뜬 뒤 캔버스가 받아 움직인다(lib/flowmap.ts · 외부 요청 0).
// 숫자는 data/derived/home_flows.json(tools-build/flows_derive.py)에서만. 흐름은 월 통계를 그린 것 — 실시간 위치가 아니다.
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";
import { poster, PW, PH } from "../../lib/home-poster";
import { u } from "../../lib/site";
import { profile } from "../../lib/profile";
import { sourceLine, source } from "../../lib/sources";
import { BRAND } from "../../lib/site";
import { portMonthly } from "../../lib/data";
import { room, rooms } from "../../lib/rooms";
import Trust from "../scene/Trust.astro";
import AiMark from "../scene/AiMark.astro";

const J = (f: string) => JSON.parse(readFileSync(join(repoRoot(), f), "utf-8"));
const F = J("data/derived/home_flows.json"), WL = J("data/derived/world_land.json");
const SC = existsSync(join(repoRoot(), "data/derived/sudo_corridors.json")) ? J("data/derived/sudo_corridors.json") : null; // 수도권 물류 흐름 층(추정 · 캡션용)
const PF = profile();
const rev = (x: string) => [...x].reverse().join("");
const hasMail = !!(PF.contact?.mail?.user && PF.contact?.mail?.domain); // 문의 메일 — 주소는 원문에 두지 않고 누를 때 조립(Contact 스크립트가 [data-c=mail] 을 다 받는다)
// 관문 → 실무 도구(rooms.json tools 방 · gate 칸이 있는 것만) — 관문을 누르면 이어지는 도구
const TOOLS = ((room("tools")?.items || []) as any[]).filter((t) => t.gate);
const NT = ((room("tools")?.items || []) as any[]).length; // 실무 도구 수(rooms.json — 첫 화면 대상 줄)
const L = F.months[F.months.length - 1];
// 작년 같은 달 — 전국 수출 규모가 평소의 두 배 가까워 「오류 아닌가」로 읽혔다(9~16차 화면 판정 · 원자료 일치) → 같은 원천의 비교 한 토막을 기준 줄에
const LY = F.months.find((m: any) => m.ym === `${Number(L.ym.slice(0, 4)) - 1}${L.ym.slice(4)}`);

// ── 정지 그림(같은 카메라 · 그림 파일로 따로 · lib/home-poster.ts) — 인천 고리는 HTML 로 얹어 CSS 로만 숨 쉰다(SVG 안 움직임은 주 스레드를 쓴다)
const PO = poster();
// 반대 지표(지도 지면을 내리며 옮겨 옴 · 2026-10-20) — 바다로 들어오는 수입은 부산이 인천항보다 크다(tools-build/supply_derive.py)
const CT = existsSync(join(repoRoot(), "data/derived/supply_hs85.json")) ? J("data/derived/supply_hs85.json").counter : null;
const fmt = (v: number) => v.toLocaleString("ko-KR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// ── [2026-10-21 선장님 과제 1] 세 축 — 무역(사고팖) · 물류(옮김) · 유통(팖). 숫자는 전부 refresh 가 다시 받는 파일에서(docs/숫자전수 ① 칸).
//    무역·유통 = data/derived/home_axes.json(tools-build/axes_derive.py · 관세청 시도별 = 신고 업체를 시도로 집계 · 배정 기준 미공개) · 물류 = 컨테이너 long · 외항선 · home_flows.
const AX = existsSync(join(repoRoot(), "data/derived/home_axes.json")) ? J("data/derived/home_axes.json") : null;
const T = AX?.trade, RT = AX?.retail;
const SAME = !T || Math.abs(T.nat_imp - L.nat_imp) <= 0.1;
// 관문 몫이 표시 기간 가운데 가장 높은 달이면 그렇다고 적는다(평소보다 높은 달을 평소처럼 읽지 않게 · 25차 사실 대조 제안)
const SH = F.months.map((m: any) => m.imp_share_pct), TOP = L.imp_share_pct >= Math.max(...SH);
const HS = J("data/hs2_short.json").names as Record<string, string>;
const AXES = J("data/questions.json").axes as { id: string; name: string; verb: string; who: string; tools: { href: string; gain: string }[] }[];
const AXN = Object.fromEntries(AXES.map((a) => [a.id, a])); // 축 이름·작은 말·사람·도구(질문 묶음과 같은 원천)
const TITLE: Record<string, string> = Object.fromEntries(rooms().flatMap((r) => (r.items || []).map((it) => [it.href, it.title]))); // 지면 이름 = rooms.json
const SHOTS = J("data/home_showcase.json").shots as { id: string; href: string; title: string; axis: string; note: string; whole?: number }[];
const NS = ((room("sim")?.items || []) as any[]).length;
const TRY = (J("data/derived/trade_race.json").years as any[]).filter((y) => !y.partial).at(-1)?.y ?? ""; // 트리맵 레이스 지면이 처음 보이는 해(마지막 온전한 해) — 띠 설명 줄 {Y}
// 두 몫의 분모 — 관세청 항구·공항별 전국(F)과 국가별 전 국가 합(T) · 같은 달에 0.1억 달러 안이면 「둘 다 ÷ 전국」 한 숫자로(23차 사실 대조 제안 · 2026-01~03 은 최대 1.9 차이) // 연습용 시뮬레이션 수(rooms.json)
const P = portMonthly(), PL = P.series[P.series.length - 1];
const V = J("data/derived/vessel_replay.json").latest;
const sign = (x: number | null | undefined, u = "%") => x == null ? "—" : `${x > 0 ? "+" : x < 0 ? "−" : "±"}${Math.abs(x)}${u}`;
const more = (x: number | null | undefined) => x == null ? "" : x > 0 ? "늘었다" : x < 0 ? "줄었다" : "같다";
const airPct = Math.round((L.air_imp / L.imp_total) * 100);
// KOSIS(유통) — 데이터와 출처 대장 줄이 둘 다 있을 때만 싣는다(이용지침 확인 = 대장 줄을 다는 사람 몫 · 2026-10-21 키 등록 전)
const KO = RT?.kosis && source("kostat-kosis") ? RT.kosis : null;
const won = (mil: number) => mil >= 1e6 ? `${fmt(mil / 1e6)}조 원` : `${Math.round(mil / 100).toLocaleString("ko-KR")}억 원`;
---
<section class="live" data-content="home-live" aria-labelledby="live-h">
  {/* [2026-10-20 품질 재정비 · docs/품질기준.md Q1·Q6] 글 기둥(질문·답·숫자·행동 둘)과 지도 칸을 나눈다 — 지도를 글 밑에 깔면 인천이 글에 가려졌다(1520×730 실측) */}
  {/* [2026-10-22 선장님 최종 결정 · docs/품질기준.md Q9~Q11] 첫 화면 = 측심이 무엇(제목·한 문장) · 누구를 위해·얻는 것(「이런 분께」 표) · 왜 연락(연락 줄).
      사람 정보(이름·학교·자격·채용)는 홈에 두지 않는다 — 소개 지면(상단 메뉴 「소개」). 통계 숫자·해명·실데이터 지도는 접힘선 아래 「지금 숫자」 절(#now-axes).
      도구 화면 = 배포 때 실제 지면을 찍은 정지컷(og-cards.mjs · iframe 0) — 7초마다 바뀌고, 지금 것 표시(마디)·멈춤 단추가 띠 안에 있다(Q10). */}
  <div class="live__hero idv">
  <div class="live__text idv__me">
    <span class="idv__rule" aria-hidden="true"></span>
    <h1 id="live-h" class="live__who"><span class="nb">수도권 물류·무역·유통을</span> <span class="nb">숫자·지도·시뮬레이션으로</span> 풉니다.</h1>
    <p class="idv__one"><b>{BRAND.name}</b>은 관문 인천에서 수도권까지의 공급망을 공공 통계와 공개 지도, 시뮬레이션으로 계산하는 SCM 작업실입니다 — <span class="nb">실무 도구 {NT}개 · 시뮬레이션 {NS}개.</span></p>
    <figure class="shots" id="shots" data-shots aria-label="실제 지면 화면 — 지면 셋을 차례로 보여 준다">
      <div class="shots__bar">
        <span class="shots__cap">실제 지면 화면</span>
        <span class="shots__seg" role="group" aria-label="도구 고르기">{SHOTS.map((t, i) => <button type="button" class={`seg${i ? "" : " is-on"}`} data-i={i} aria-label={t.title} title={t.title} aria-pressed={i ? "false" : "true"}><i></i></button>)}</span>
        <button type="button" class="shots__pause" id="shots-pause" aria-pressed="false">자동 넘김 멈춤</button>
      </div>
      <div class="shots__stage">
        {SHOTS.map((t, i) => <a class={`shot${i ? "" : " is-on"}${t.whole ? " shot--whole" : ""}`} data-axis={t.axis} data-i={i} href={u(t.href)} aria-hidden={i ? "true" : undefined} tabindex={i ? -1 : undefined}>
          <span class="shot__img"><picture><source media="(max-width: 899px)" srcset={u(`/assets/toolshots/${t.id}-m.jpg`)} /><img src={u(`/assets/toolshots/${t.id}.jpg`)} alt={`${t.title} — 실제 지면 화면(주 그림)`} width="1176" height="588" loading={i ? "lazy" : "eager"} decoding="async" onerror="this.hidden=true" /></picture></span>
          <span class="shot__t"><b>{t.title} →</b> <small>{t.note.replace("{Y}", TRY)}</small></span>
        </a>)}
      </div>
    </figure>
  </div>
  <div class="idv__aud">
    <p class="s-cap idv__cap">이런 분께 — 여기서 얻는 것</p>
    <ul class="who3">
      {AXES.map((a) => <li class={`who3__row${a.id === SHOTS[0]?.axis ? " is-on" : ""}`} data-axis={a.id}>
        <b class="who3__k">{a.name}</b>
        <span class="who3__p">{a.who}</span>
        <span class="who3__t">{a.tools.map((t, k: number) => <>{k > 0 && <span class="who3__sep" aria-hidden="true"> / </span>}<a href={u(t.href)} title={TITLE[t.href]}>{t.gain}</a></>)}</span>
      </li>)}
    </ul>
    <p class="idv__ask">물동량·원가 계산을 귀사 숫자로 다시 돌려 보고 싶다면, 메일로 알려 주세요.</p>
    <div class="live__cta">
      {hasMail && <a class="s-btn" href="#mail" data-c="mail" data-ask="1" data-a={rev(PF.contact.mail.user)} data-b={rev(PF.contact.mail.domain)}>문의 메일</a>}
      <a class="s-btn s-btn--ghost live__q" href={u("/tools/")}>도구 보기</a>
    </div>
  </div>
  </div>

  <section class="now" id="now-axes" aria-labelledby="axes-h">
  <div class="now__text">
    <p class="s-cap axes__cap">최신 공표분으로 잰 숫자 · 공공 통계 · 관문 · 화주 · 생활소비재<span class="nb">(서로 다른 기준 — 아래 정의)</span></p>
    <h2 id="axes-h" class="s-prose axes__h">한국 수입의 <span class="live__nb"><span class="s-signal">{L.imp_share_pct}%</span>는</span> 인천 관문으로{T && <>, <span class="live__nb"><span class="s-signal">{T.imp_pct}%</span>는</span> 수도권 화주에게</>}.</h2>
    <p class="live__one">{L.ym} 수입액 · {SAME ? <>둘 다 ÷ 전국 {fmt(L.nat_imp)}억 달러</> : <>관문 몫 ÷ 전국 {fmt(L.nat_imp)}억 달러(항구·공항별) · 화주 몫 ÷ 전국 {fmt(T.nat_imp)}억 달러(국가별)</>}<span class="lg-d"> · 인천 관문 = 공항 {airPct}% + 항만 {100 - airPct}%(입항지 기준)</span><span class="lg-s"> · 관문 = 입항지 기준</span>{TOP && <span> · 관문 몫 {L.imp_share_pct}%는 이 지면 자료 {SH.length}개월({F.months[0].ym}~{L.ym}) 가운데 가장 높은 달</span>}{T && <> · <b class="live__def">화주 = 관세청 시도별 집계 업체(물건이 들어온 곳 아님 · 기준은 아래 방법)</b></>}</p>
    <ol class="live__stat ax">
      <li class="ax__row"><a href="#ax-logi">
        <span class="ax__k">{AXN.logi.name}<small>인천항</small></span>
        <span class="ax__v"><b>{PL.v.toLocaleString("ko-KR")}</b><span class="live__unit">천TEU</span></span>
        <span class="ax__s" aria-hidden="true">인천항 컨테이너 <span class="nb">{PL.ym}</span> · 전년비 {sign(PL.yoy)}</span>
        <span class="ax__t">인천항 컨테이너 <span class="nb">{PL.ym}</span> · 작년 같은 달 {sign(PL.yoy)} · 외항선 {V.incheon.toLocaleString("ko-KR")}척(<span class="nb">{V.ym}</span>)</span>
      </a></li>
      {T && <li class="ax__row"><a href="#ax-trade">
        <span class="ax__k">{AXN.trade.name}<small>수도권 화주</small></span>
        <span class="ax__v"><b>{fmt(T.sudo_imp)}</b><span class="live__unit">억 달러</span></span>
        <span class="ax__s" aria-hidden="true">수도권 화주 수입 <span class="nb">{T.ym}</span></span>
        <span class="ax__t">수도권 화주 수입 <span class="nb">{T.ym}</span> · 수입 1위 {HS[T.top_imp[0].hs] ?? T.top_imp[0].name} {T.top_imp[0].pct}%<span class="lg-x"> · 같은 달 수출 {fmt(T.sudo_exp)}억 달러</span></span>
      </a></li>}
      {RT && <li class="ax__row"><a href="#ax-retail">
        <span class="ax__k">{AXN.retail.name}<small>생활소비재</small></span>
        <span class="ax__v"><b>{fmt(RT.cons_imp)}</b><span class="live__unit">억 달러</span></span>
        <span class="ax__s" aria-hidden="true">수도권 화주 생활소비재 수입 <span class="nb">{RT.ym}</span> · 전년비 {sign(RT.cons_yoy)}</span>
        <span class="ax__t">수도권 화주가 들여온 생활소비재({RT.groups.map((g: any) => g.name.split("·")[0]).join("·")}) <span class="nb">{RT.ym}</span> · 작년 같은 달 {sign(RT.cons_yoy)}{KO && <> · 전국 온라인쇼핑 {won(KO.online)}({KO.ym} {sign(KO.yoy)})</>}</span>
      </a></li>}
    </ol>
    <p class="now__mapis">지도 점 = 인천공항을 오간 나라별 항공화물 <b>무게</b>(위 금액과 다른 단위 · 범례 참고)</p>
  </div>
  <div class="live__frame">
  <div class="live__stage" id="live-stage">
    <img class="live__poster" src={u("/assets/home-poster.svg")} alt="" width={PW} height={PH} decoding="async" />
    <canvas id="fm" class="live__cv" role="img" aria-label={`인천 관문 지도 — 인천공항을 오간 나라별 항공화물(${F.air_cargo?.from}~${F.air_cargo?.through} 월평균)을 점으로, 도착은 주홍 · 출발은 바다색. 바다(인천항)는 나라별 공개 통계가 없어 점이 없다.`}></canvas>
    <div class="live__labels" id="fm-labels" aria-hidden="true"></div>
    <button type="button" class="live__pause" id="fm-play" aria-pressed="false" aria-label="흐름 멈춤"><span aria-hidden="true" class="live__pi"></span><span class="live__pt">멈춤</span></button>
    <p class="live__legend"><b class="live__lt">지도 = 하늘 쪽 · 무게</b> · 선 = 대권(최단) 계산 · <span class="k k-in"></span>도착 <span class="k k-out"></span>출발 항공화물 · <span id="fm-unit">점 하나 ≈ 100톤</span> · <span id="fm-sec">한 달 = 7초</span>(인천공항 · {F.air_cargo ? `${F.air_cargo.from}~${F.air_cargo.through.slice(5)} 월평균 · 반기 공표 최신분` : ""})<span id="fm-dens" hidden> · 회녹 결 = 배가 많이 다니는 바닷길(2015~21 누적)</span><span id="fm-wh" hidden> · 원 = 물류창고 등록 개소{F.warehouse_asof ? `(${F.warehouse_asof} 기준)` : ""}</span></p>
    <div class="live__ctl" role="group" aria-label="지도 보기">
      <button type="button" class="s-btn s-btn--ghost" data-view="asia">아시아</button>
      <button type="button" class="s-btn s-btn--ghost" data-view="sudo">동북아</button>
      <button type="button" class="s-btn s-btn--ghost" data-view="incheon" aria-label="인천 관문">인천<span class="lg">&nbsp;관문</span></button>
      <button type="button" class="s-btn s-btn--ghost" id="fm-tour" aria-pressed="true" aria-label="카메라 회전 끔"><span class="lg">카메라&nbsp;</span>회전 끔</button>
      <button type="button" class="s-btn s-btn--ghost" id="fm-gates" aria-expanded="false" aria-controls="fm-panel" aria-label="관문 숫자"><span class="lg">관문&nbsp;</span>숫자</button>
    </div>
  </div>
  <aside class="live__panel" id="fm-panel" hidden aria-label="관문별 숫자">
    <button type="button" class="live__x" id="fm-x" aria-label="닫기">×</button>
    <h2 class="s-cap" id="fm-p-h">{L.ym} 관문별</h2>
    <dl class="live__dl" id="fm-p-dl">
      <dt>인천공항</dt><dd>수입 {fmt(L.air_imp)} · 수출 {fmt(L.air_exp)}<small>억 달러</small></dd>
      <dt>인천항</dt><dd>수입 {fmt(L.port_imp)} · 수출 {fmt(L.port_exp)}<small>억 달러</small></dd>
      {L.teu && <><dt>인천항 컨테이너</dt><dd>{F.sea_gates.map((g: any) => `${g.id} ${L.teu[g.id]}`).join(" · ")}<small>천TEU</small></dd></>}
      <dt>전국 대비</dt><dd>수입 {L.imp_share_pct}% · 수출 {L.exp_share_pct}%</dd>
    </dl>
    {TOOLS.length > 0 && <><p class="s-cap">이 관문에서 이어지는 도구</p><ul class="live__tools">{TOOLS.map((t) => <li><a href={u(t.href)} title={t.q}>{t.title} →</a></li>)}</ul></>}
