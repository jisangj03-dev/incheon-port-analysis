---
// 홈 첫 화면 — 살아 있는 인천 물류 지도(2026-10-14 선장님 판정 「동적인 콘텐츠·목적이 와닿지 않는다」 · 채팅 위임 A·B).
// 첫 그림 = 빌드 때 그린 정지 해도(같은 투영 · 스크립트 0) → 페이지가 다 뜬 뒤 캔버스가 받아 움직인다(lib/flowmap.ts · 외부 요청 0).
// 숫자는 data/derived/home_flows.json(tools-build/flows_derive.py)에서만. 흐름은 월 통계를 그린 것 — 실시간 위치가 아니다.
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { repoRoot } from "../../lib/content";
import { poster, PW, PH } from "../../lib/home-poster";
import { u } from "../../lib/site";
import { profile } from "../../lib/profile";
import { sourceLine } from "../../lib/sources";
import { room } from "../../lib/rooms";
import Trust from "../scene/Trust.astro";
import AiMark from "../scene/AiMark.astro";

const J = (f: string) => JSON.parse(readFileSync(join(repoRoot(), f), "utf-8"));
const F = J("data/derived/home_flows.json"), WL = J("data/derived/world_land.json");
const SC = existsSync(join(repoRoot(), "data/derived/sudo_corridors.json")) ? J("data/derived/sudo_corridors.json") : null; // 수도권 물류 흐름 층(추정 · 캡션용)
const PF = profile();
const rev = (x: string) => [...x].reverse().join("");
const hasMail = !!(PF.contact?.mail?.user && PF.contact?.mail?.domain); // 문의 메일 — 주소는 원문에 두지 않고 누를 때 조립(Contact 스크립트가 [data-c=mail] 을 다 받는다)
// 관문 → 실무 도구(rooms.json tools 방 · gate 칸이 있는 것만) — 관문을 누르면 이어지는 도구
const TOOLS = ((room("tools")?.items || []) as any[]).filter((t) => t.gate);
const L = F.months[F.months.length - 1];

// ── 정지 그림(같은 카메라 · 그림 파일로 따로 · lib/home-poster.ts) — 인천 고리는 HTML 로 얹어 CSS 로만 숨 쉰다(SVG 안 움직임은 주 스레드를 쓴다)
const PO = poster();
// 반대 지표(지도 지면을 내리며 옮겨 옴 · 2026-10-20) — 바다로 들어오는 수입은 부산이 인천항보다 크다(tools-build/supply_derive.py)
const CT = existsSync(join(repoRoot(), "data/derived/supply_hs85.json")) ? J("data/derived/supply_hs85.json").counter : null;
const fmt = (v: number) => v.toLocaleString("ko-KR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---
<section class="live" data-content="home-live" aria-labelledby="live-h">
  {/* [2026-10-20 품질 재정비 · docs/품질기준.md Q1·Q6] 글 기둥(질문·답·숫자·행동 둘)과 지도 칸을 나눈다 — 지도를 글 밑에 깔면 인천이 글에 가려졌다(1520×730 실측) */}
  <div class="live__hero">
  <div class="live__text">
    <p class="s-cap live__who">{PF.name} · SCM 작업실</p>
    <h1 id="live-h" class="s-prose">한국 수입의 <span class="s-signal">{L.imp_share_pct}%</span>가 인천으로 들어옵니다.</h1>
    <p class="s-lead s-prose live__one">{L.ym} 금액 · 입·출항지 기준(관세청 항구·공항별 · 인천공항 + 인천항) — 수출은 {L.exp_share_pct}%가 인천에서 나갑니다. <span class="live__nat">같은 달 전국은 수입 {fmt(L.nat_imp)} · 수출 {fmt(L.nat_exp)}억 달러(같은 통계의 전국 합계).</span></p>
    <p class="live__stat" id="fm-hud" aria-live="off"><b id="fm-total">{fmt(L.total)}</b><span class="live__unit">억 달러</span>
      <span class="live__sub"><span id="fm-ym">{L.ym}</span> 인천 관문을 지난 수출입 · 관문별로 나누면</span>
      {/* [2026-10-21 채팅 검수 ① · 채점표 D1] 답(공항+항만 금액)과 지도(공항 항공화물 무게)가 갈려 「50.5%가 다 비행기로?」로 읽혔다 → 금액을 관문별로 갈라 첫 화면에 둔다 */}
      {[["수입", "fm-imp", L.imp_total, L.air_imp, L.port_imp], ["수출", "fm-exp", L.exp_total, L.air_exp, L.port_exp]].map(([k, id, t, a, sp]: any) => { const ap = Math.round((a / t) * 100); return (
        <span class="live__split" aria-label={`${k} ${fmt(t)}억 달러 가운데 인천공항 ${fmt(a)}(${ap}%) · 인천항 ${fmt(sp)}(${100 - ap}%)`}>
          <span class="live__sk">{k} <b id={id}>{fmt(t)}</b></span>
          <span class="live__bar" aria-hidden="true"><i class="air" style={`width:${ap}%`}></i><i class="sea"></i></span>
          <span class="live__sv" aria-hidden="true">하늘 {ap}% · 바다 {100 - ap}%</span>
        </span>); })}
      {/* [2026-10-21 11차 화면 판정 H4] 390 에서 범례(지도 아래)가 접힘선 밑 — 지도가 무엇인지는 글 기둥에서 먼저 말한다 */}
      <span class="live__mapis"><span class="lg-d">오른쪽</span><span class="lg-m">아래</span> 지도는 하늘 쪽만 그립니다 — 인천공항을 오간 나라별 항공화물 <b>무게</b>(톤 · {F.air_cargo ? `${F.air_cargo.from}~${F.air_cargo.through.slice(5)} 월평균` : ""} · 위 금액과 단위·기간이 다름)</span></p>
    <div class="live__cta">
      <a class="s-btn live__q" href="#questions">같이 푸는 질문 보기</a>
      {hasMail && <a class="s-btn s-btn--ghost" href="#mail" data-c="mail" data-ask="1" data-a={rev(PF.contact.mail.user)} data-b={rev(PF.contact.mail.domain)}>문의 메일</a>}
    </div>
  </div>

  <div class="live__frame">
  <div class="live__stage" id="live-stage">
    <img class="live__poster" src={u("/assets/home-poster.svg")} alt="" width={PW} height={PH} decoding="async" />
    <canvas id="fm" class="live__cv" role="img" aria-label={`인천 관문 지도 — 인천공항을 오간 나라별 항공화물(${F.air_cargo?.from}~${F.air_cargo?.through} 월평균)을 점으로, 도착은 주홍 · 출발은 바다색. 바다(인천항)는 나라별 공개 통계가 없어 점이 없다.`}></canvas>
    <div class="live__labels" id="fm-labels" aria-hidden="true"></div>
    <button type="button" class="live__pause" id="fm-play" aria-pressed="false" aria-label="흐름 멈춤"><span aria-hidden="true" class="live__pi"></span><span class="live__pt">멈춤</span></button>
    <p class="live__legend"><b class="live__lt">지도 = 하늘 쪽 · 무게</b> · <span class="k k-in"></span>도착 <span class="k k-out"></span>출발 항공화물 · <span id="fm-unit">점 하나 ≈ 100톤</span> · <span id="fm-sec">한 달 = 7초</span>(인천공항 · {F.air_cargo ? `${F.air_cargo.from}~${F.air_cargo.through.slice(5)} 월평균 · 반기 공표 최신분` : ""})<span id="fm-dens" hidden> · 회녹 결 = 배가 많이 다니는 바닷길(2015~21 누적)</span><span id="fm-wh" hidden> · 원 = 물류창고 개소</span></p>
    <div class="live__ctl" role="group" aria-label="지도 보기">
      <button type="button" class="s-btn s-btn--ghost" data-view="asia">아시아</button>
      <button type="button" class="s-btn s-btn--ghost" data-view="sudo">동북아</button>
      <button type="button" class="s-btn s-btn--ghost" data-view="incheon" aria-label="인천 관문">인천<span class="lg">&nbsp;관문</span></button>
      <button type="button" class="s-btn s-btn--ghost" id="fm-tour" aria-pressed="true" aria-label="카메라 회전 끔"><span class="lg">카메라&nbsp;</span>회전 끔</button>
      <button type="button" class="s-btn s-btn--ghost" id="fm-gates" aria-expanded="false" aria-controls="fm-panel" aria-label="관문 숫자"><span class="lg">관문&nbsp;</span>숫자</button>
    </div>
  </div>
  <aside class="live__panel" id="fm-panel" hidden aria-label="관문별 숫자">
    <button type="button" class="live__x" id="fm-x" aria-label="닫기">×</button>
    <h2 class="s-cap" id="fm-p-h">{L.ym} 관문별</h2>
    <dl class="live__dl" id="fm-p-dl">
      <dt>인천공항</dt><dd>수입 {fmt(L.air_imp)} · 수출 {fmt(L.air_exp)}<small>억 달러</small></dd>
      <dt>인천항</dt><dd>수입 {fmt(L.port_imp)} · 수출 {fmt(L.port_exp)}<small>억 달러</small></dd>
      {L.teu && <><dt>인천항 컨테이너</dt><dd>{F.sea_gates.map((g: any) => `${g.id} ${L.teu[g.id]}`).join(" · ")}<small>천TEU</small></dd></>}
      <dt>전국 대비</dt><dd>수입 {L.imp_share_pct}% · 수출 {L.exp_share_pct}%</dd>
    </dl>
    {TOOLS.length > 0 && <><p class="s-cap">이 관문에서 이어지는 도구</p><ul class="live__tools">{TOOLS.map((t) => <li><a href={u(t.href)} title={t.q}>{t.title} →</a></li>)}</ul></>}
    <p class="s-cap">{F.partners[0]?.imp_nat_pct != null ? `나라별 몫 — 전국 수입 대비 · 수집한 10개국 가운데 큰 순 · ${F.partner_months[0]}~${F.partner_months[F.partner_months.length - 1]}` : `나라별 몫 — 주요 10개국 합을 100으로 · ${F.partner_months[0]}~${F.partner_months[F.partner_months.length - 1]}`}</p>
    <ol class="live__bars">
      {[...F.partners].sort((a: any, b: any) => (b.imp_nat_pct ?? b.imp_pct) - (a.imp_nat_pct ?? a.imp_pct)).slice(0, 6).map((p: any) => { const v = p.imp_nat_pct ?? p.imp_pct; return <li><span>{p.name}</span><i style={`--w:${v}%`}></i><b>수입 {v}%</b></li>; })}
    </ol>
  </aside>
  </div>
  </div>

  <div class="s-wrap live__foot">
    {CT && <p class="s-prose live__counter"><b>반대 지표</b> — {CT.text}. {CT.ym.slice(0, 4)}-{CT.ym.slice(4)} 전국 수입액 중 부산항·부산신항 <b class="s-signal">{CT.busan_pct}%</b>, 인천항 <b>{CT.incheon_port_pct}%</b>(관세청 항구·공항별 · 입항지 기준). 인천의 몫이 큰 것은 하늘(인천공항) 덕이다.</p>}
    <Trust updated={F.made} source={`${sourceLine("kcs-porttrade")} · ${sourceLine("kcs-nitemtrade")}`} csv={u("/data/home-flows.csv")} csvName="incheon-gate-flows.csv" note="월별 · 억 달러" />
    <details class="live__how"><summary class="s-cap">이 지도를 만든 방법·출처</summary>
    <p class="s-cap">첫 문장의 비중 = 관세청 항구·공항별 수출입실적(수입 = 입항지 · 수출 = 출항지 기준)에서 인천공항 + 인천항 ÷ 전국 총계. 분모(전국 총계)는 같은 원천의 「전국」 줄이다(관세청 국가별 수출입실적의 전 국가 합과는 달에 따라 2억 달러 안팎 다르다). {(() => { const M = F.months, b = M[Math.max(0, M.length - 13)], e = M[M.length - 1]; return `전국 수출은 ${b.ym} ${fmt(b.nat_exp)}억 달러에서 ${e.ym} ${fmt(e.nat_exp)}억 달러로 바뀌었고, 같은 기간 인천공항 수출은 ${fmt(b.air_exp)}억 → ${fmt(e.air_exp)}억 달러다.`; })()}</p>
    <p class="s-cap">점 = 인천국제공항공사 「항공사별 노선별 운송실적」의 나라별 도착·출발 화물 톤({F.air_cargo?.from}~{F.air_cargo?.through} 월평균 · 직화물·환적화물·우편물 포함 · 반기마다 공표). 금액(수출입액)이 아니라 무게다 — 첫 문장의 금액과 단위·기간이 다르다. 표시한 10개국이 인천공항 국제 항공화물의 {F.air_cargo?.shown_pct != null ? `${F.air_cargo.shown_pct}%` : "대부분"}다. 하늘길은 대권(최단 거리)으로 계산한 길이지 그 달 실제 항적이 아니다. 바다(인천항)는 나라별로 가른 공개 통계가 없어 점도 길도 그리지 않았다 — 배가 실제로 다닌 바닷길은 회녹 결(세계은행 선박 통행 밀도)로 보인다.</p>
    <p class="s-cap">원 = 국토교통부 물류창고업 등록 개소(인천 구·군 · 서울{SC?.dests?.some((d: any) => String(d.basis).includes("시·군")) ? " · 경기 시·군" : ""}) · 회색 줄 = OpenStreetMap 고속도로. 네모 = 거점(북항·아암·공항 자유무역지역·평택·당진항·의왕 ICD) 개략 위치. 회녹 결은 세계은행 Global Shipping Traffic Density(2015-01~2021-02 AIS 누적 · CC BY 4.0) — 지금 떠 있는 배가 아니다. 땅 Natural Earth(퍼블릭 도메인) · 인천 땅·고속도로 © OpenStreetMap 기여자(ODbL) · 등심선 NOAA ETOPO 2022(항해용 아님).</p>
    </details>
    <AiMark k="index" />
  </div>
  <script define:vars={{ src: u("/data/flowmap.json") }}>window.__fmsrc = src;</script>
</section>

<script>
  import { FlowMap, greatCircle, VIEWS, VIEWS_M, fitCam, regionPts, gatePts, REGION_CAM, HERO_CAM, HERO_M, HERO_M_NARROW, type Cam } from "../../lib/flowmap";
  import { reduced, pace, paused, setPaused } from "../../lib/motion";
  const stage = document.getElementById("live-stage") as HTMLElement, cv = document.getElementById("fm") as HTMLCanvasElement;
  // [2026-10-20 · docs/품질기준.md Q7] 동작 줄이기 = 점은 느리게 계속 흐르고 카메라·반짝임만 멈춘다 · 멈춤은 단추로(기억)
  const reduce = reduced();
  let still = paused();
  const lite = matchMedia("(max-width: 720px)").matches; // 좁은 화면 = 가벼운 판(점 절반 · 해상도 1.5배까지)
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (v: number) => v.toLocaleString("ko-KR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  let fm: FlowMap | null = null;

  // 숫자가 돈다 — 달이 바뀌면 이전 값에서 새 값으로 0.7초에 걸쳐
  const tick = (el: HTMLElement, to: number) => {
    const from = Number(el.dataset.v ?? el.textContent!.replace(/,/g, "")) || 0, t0 = performance.now();
    el.dataset.v = String(to);
    if (reduce) { el.textContent = fmt(to); return; }
    const f = (now: number) => { const k = Math.min(1, (now - t0) / 700), e = 1 - (1 - k) ** 3; el.textContent = fmt(from + (to - from) * e); if (k < 1) requestAnimationFrame(f); };
    requestAnimationFrame(f);
  };

  // 이름표 — 우선순위 높은 것부터 놓고 겹치면 뺀다(매 장면)
  type LB = { el: HTMLElement; lon: number; lat: number; pri: number; near: boolean | null; w: number; h: number; dx: number; dy: number; inc?: boolean; route?: number[][] };
  const LBS: LB[] = [];
  // inc = 인천 안 자세한 이름(구·부두·거점) — 「인천 관문」 가까이 볼 때만(수도권 한 장에서는 인천 둘레가 이름으로 덮였다 · 2026-10-20)
  const mk = (html: string, lon: number, lat: number, pri: number, near: boolean | null, cls = "", inc = false, route?: number[][]) => {
    const el = document.createElement("span"); el.className = `fm-lb ${cls}`; el.dataset.label = ""; el.innerHTML = html; $("fm-labels").append(el);
    LBS.push({ el, lon, lat, pri, near, w: 0, h: 0, dx: 8, dy: -8, inc, route });
  };
  // 글자·숫자판·단추 자리(이름표가 피한다) — 화면 크기·글꼴·글 블록 크기가 바뀔 때만 다시 잰다(매 장면 재면 배치 계산이 장면마다 돈다)
  // [2026-10-20 #67 · 1568×709 검수] 글 블록은 문단마다가 아니라 한 덩어리(합친 상자 + 여백 14px)로 피한다 — 문단 틈에 이름표가 앉으면 본문과 겹쳐 보였다.
  //   글꼴이 늦게 오면 글이 다시 흐르는데 처음 잰 상자를 계속 썼다 → 글꼴 준비·글 블록 크기 변화 때도 다시 잰다
  let fixed: number[][] | null = null;
  const fixedBoxes = (H: number) => {
    const sr = stage.getBoundingClientRect(), box = (r: DOMRect, p: number, q: number) => [r.left - sr.left - p, r.top - sr.top - q, r.right - sr.left + p, r.bottom - sr.top + q];
    const txt = [...document.querySelectorAll<HTMLElement>(".live__text > *")].map((e) => e.getBoundingClientRect()).filter((r) => r.width && r.height);
    const out = [...document.querySelectorAll<HTMLElement>(".live__ctl, .live__legend, .live__pause")].map((e) => box(e.getBoundingClientRect(), 6, 4));
    if (txt.length) out.push(box(new DOMRect(Math.min(...txt.map((r) => r.left)), Math.min(...txt.map((r) => r.top)), Math.max(...txt.map((r) => r.right)) - Math.min(...txt.map((r) => r.left)), Math.max(...txt.map((r) => r.bottom)) - Math.min(...txt.map((r) => r.top))), 14, 14));
    return out.filter((b) => b[3] > 0 && b[1] < H);
  };
  const refit = () => { fixed = null; for (const l of LBS) l.w = 0; };
  addEventListener("resize", refit);
  document.fonts?.ready.then(refit);
  { const tx = document.querySelector(".live__text"); if (tx && "ResizeObserver" in window) new ResizeObserver(refit).observe(tx); }
  const place = (f: FlowMap) => {
    const near = f.cam.zoom > 6.2, W = f.W, H = f.H, detail = f.cam.zoom > (f.views.sudo.zoom + f.views.incheon.zoom) / 2;
    const taken: number[][] = [...(fixed ??= fixedBoxes(H))];
    const shown = new Set<string>();
    { const wh = document.getElementById("fm-wh"); if (wh && wh.hidden === near) wh.hidden = !near; } // 창고 원은 가까이 볼 때만 그려진다 — 범례도 그때만(9차 화면 판정: 첫 화면에 없는 원이 범례에 있었다)
    const off: { name: string; q: number[] }[] = [];
    for (const l of [...LBS].sort((a, b) => b.pri - a.pri)) {
      const want = (l.near === null || l.near === near) && (!l.inc || detail);
      if (!want) { if (l.el.style.visibility !== "hidden") l.el.style.visibility = "hidden"; continue; }
      if (!l.w) { const r = l.el.getBoundingClientRect(); l.w = r.width; l.h = r.height; }
      let s = f.screen(l.lon, l.lat);
      // [2026-10-20 3차 화면 판정] 화면 밖 나라 이름을 바닷길이 들어오는 자리에 하나씩 달면 남쪽 길 넷이 한자리에 뭉쳤다(홍콩·베트남·싱가포르·대만 · 「독일」이 중국 남쪽) →
      //   화면 밖 나라는 들어오는 가장자리별로 한 덩어리 이름표(「↓ 대만·홍콩·…」)로 묶는다 — 아래 edge()
      if (l.route && (s[0] < 24 || s[0] > W - 24 || s[1] < H * 0.15 || s[1] > H - 24)) {
        if (l.el.style.visibility !== "hidden") l.el.style.visibility = "hidden";
        if (want) for (const [lo, la] of l.route) { const q = f.screen(lo, la); if (q[0] > 30 && q[0] < W - 30 && q[1] > H * 0.18 && q[1] < H - 100) { off.push({ name: l.el.textContent || "", q }); break; } }
        continue;
      }
      let ok = false, x = 0, y = 0;
      if (s[0] < 24 || s[0] > W - 24 || s[1] < H * 0.15 || s[1] > H - 24) { if (l.el.style.visibility !== "hidden") l.el.style.visibility = "hidden"; continue; } // 자리가 화면 가장자리·안개 속이면 뺀다
      for (const [dx, dy] of [[8, -l.h - 4], [8, 4], [-l.w - 8, -l.h - 4], [-l.w - 8, 4]]) {
        x = s[0] + dx; y = s[1] + dy;
        if (x < 4 || y < H * 0.12 || x + l.w > W - 4 || y + l.h > H - 4) continue;
        if (taken.some((t) => x < t[2] && x + l.w > t[0] && y < t[3] && y + l.h > t[1])) continue;
        ok = true; break;
      }
      const v = ok ? "visible" : "hidden";
      if (l.el.style.visibility !== v) l.el.style.visibility = v;
      if (ok) { l.el.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`; taken.push([x - 3, y - 2, x + l.w + 3, y + l.h + 2]); if (l.route) shown.add(l.el.textContent || ""); }
    }
    edge(off, W, H, taken);
    f.labeled = shown;
  };
  // 화면 밖 나라 — 길이 들어오는 가장자리(위·오른쪽·아래·왼쪽)별로 이름을 묶어, 그 길들이 들어오는 자리의 가운데에 단다
  // 화면 밖 나라 — 나라마다 이름표 하나를 그 하늘길이 화면에 들어오는 자리에 단다. 화살표 = 인천에서 본 방위(8방).
  //   [4차 화면 판정] 바닷길 기준 4방 묶음 → 「→ 미국·호주」(호주는 남쪽) · [5차] 「홍콩·베트남·싱가포르·대만」 한 덩어리가 여러 선을 맡아 선 끝에 이름이 없었다 → 나라마다 따로
  const EDGE = new Map<string, HTMLElement>();
  const AR = ["→", "↘", "↓", "↙", "←", "↖", "↑", "↗"];
  const edge = (off: { name: string; q: number[] }[], W: number, H: number, taken: number[][]) => {
    const D0 = (window as any).__fmdata?.flows, o0 = fm && D0 ? fm.screen(D0.air_gate.lon, D0.air_gate.lat) : [W / 2, H / 2];
    // 들어오는 자리가 36px 안에 겹치는 하늘길은 한 이름표로 묶고 「겹친 하늘길」이라고 적는다 — 따로 달면 거의 평행한 선 위에 이름표만 몰려 어느 선인지 대응이 안 됐다(9차 화면 판정 · 중대)
    const groups: { name: string; q: number[] }[] = [];
    for (const o of off) { const g = groups.find((x) => Math.hypot(x.q[0] - o.q[0], x.q[1] - o.q[1]) < 36); if (g) { if (!g.name.split("·").includes(o.name)) g.name += `·${o.name}`; } else groups.push({ name: o.name, q: o.q }); }
    off = groups.map((g) => ({ name: g.name.includes("·") ? `${g.name}(겹친 하늘길)` : g.name, q: g.q }));
    const seen = new Set<string>();
    for (const o of off) {
      if (seen.has(o.name)) continue; seen.add(o.name);
      let el = EDGE.get(o.name);
      if (!el) { el = document.createElement("span"); el.className = "fm-lb fm-lb--edge"; el.dataset.label = ""; $("fm-labels").append(el); EDGE.set(o.name, el); }
      const ang = Math.atan2(o.q[1] - o0[1], o.q[0] - o0[0]), txt = `${AR[((Math.round(ang / (Math.PI / 4)) % 8) + 8) % 8]} ${o.name}`;
      if (el.textContent !== txt) el.textContent = txt;
      const r = el.getBoundingClientRect(), w = r.width, h = r.height;
      // 들어오는 자리에서 화면 안쪽으로 조금 — 겹치면 선을 따라 안쪽으로 밀고, 그래도 겹치면 옆으로
      const ux = -Math.cos(ang), uy = -Math.sin(ang);
      let x = 0, y = 0, ok = false;
      for (let k = 0; k < 10 && !ok; k++) for (const side of [0, 1, -1]) {
        x = o.q[0] + ux * (10 + k * 14) - w / 2 + side * (w / 2 + 8); y = o.q[1] + uy * (10 + k * 14) - h / 2;
        x = Math.max(6, Math.min(W - w - 6, x)); y = Math.max(H * 0.14, Math.min(H - h - 96, y));
        if (!taken.some((t) => x < t[2] && x + w > t[0] && y < t[3] && y + h > t[1])) { ok = true; break; }
      }
      el.style.visibility = ok ? "visible" : "hidden";
      if (ok) { el.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`; taken.push([x - 3, y - 2, x + w + 3, y + h + 2]); }
    }
    for (const [n, el] of EDGE) if (!seen.has(n) && el.style.visibility !== "hidden") el.style.visibility = "hidden";
  };

  async function boot() {
    const D = await fetch((window as any).__fmsrc).then((r) => r.json());
    (window as any).__fmdata = D;
    if (D.density) { const e = document.getElementById("fm-dens"); if (e) e.hidden = false; }
    const F = D.flows;
    const unit = lite ? 250 : 100; // 점 하나 = 항공화물 톤
    // [2026-10-20] 보기 = 지도 칸 모양에 맞춘 카메라 — 수도권 = 인천 관문(서)·서울·김포·광주·이천·안성(경부·영동축)이 한 장에 · 인천 관문 = 공항·항만·창고 몰린 구
    const fit = (): Record<string, Cam> => {
      const W = cv.clientWidth || 800, H = cv.clientHeight || 600, narrow = W < 640, M = narrow ? HERO_M_NARROW : HERO_M;
      return { asia: { ...(narrow ? VIEWS_M : VIEWS).asia, ox: 0, oy: 0.04 }, sudo: fitCam(REGION_CAM, W, H, regionPts(D), M), incheon: fitCam({ ...HERO_CAM, zoom: 11, pitch: 50, bearing: 18 }, W, H, gatePts(D), M) };
    };
    let views = fit(); viewNow = "sudo";
    $("fm-unit").textContent = `점 하나 ≈ ${unit}톤`;
    $("fm-sec").textContent = `한 달 = ${String(Math.round((7 / pace()) * 10) / 10)}초`; /* 동작 줄이기 = 느리게(11차 사실 대조 M3 — 범례 7초가 17.5초로 돌았다) */
    const cam: Cam = { ...views.sudo }; // [2026-10-15 P0] 첫 화면 = 수도권 · 「아시아」는 단추
    fm = new FlowMap(cv, D, { unit, monthSec: 7, airTons: true, maxDpr: lite ? 1 : 2, lite, speed: pace(), calm: reduce, inland: false, onFrame: place, onMonth: (i) => {
      const m = F.months[i];
      $("fm-ym").textContent = m.ym;
      tick($("fm-total"), m.total); tick($("fm-imp"), m.imp_total); tick($("fm-exp"), m.exp_total);
      panel(i);
    } }, cam);
    // 이름표 — 멀리: 나라·인천 / 가까이: 관문·목적지
    // 나라 이름 = 그 나라 공항 자리 · 화면 밖이면 하늘길(대권)이 화면에 들어오는 자리로 묶는다 — 점이 하늘길에만 있다(4차 화면 판정: 굵은 흐름에 이름이 없고 「미국」이 다른 선에 붙었다)
    for (const p of F.partners) mk(`<b>${p.name}</b>`, p.air[0], p.air[1], (p.air_in_t || 0) + (p.air_out_t || 0), false, "", false, greatCircle(p.air, [F.air_gate.lon, F.air_gate.lat], 48));
    mk(`<b class="s-signal">인천</b>`, F.air_gate.lon, F.air_gate.lat, 1000, false, "fm-lb--gate");
    mk(`<b class="s-signal">인천공항</b>`, F.air_gate.lon, F.air_gate.lat, 1000, true, "fm-lb--gate");
    for (const g of F.sea_gates) mk(`<b class="s-signal">${g.id}</b>`, g.lon, g.lat, 900 - g.lon, true, "fm-lb--gate", g.id !== F.sea_gates[0].id);
    // 목적지 — 이름만(설명·추정 표기는 지도 아래 방법 칸에 · 2026-10-20 선장님 「지도 라벨은 도시 이름만」)
    const S = D.sudo;
    for (const d of S?.dests ?? F.dests) mk(`<b>${d.id === "서울특별시" ? "서울" : d.id}</b>`, d.lon, d.lat, d.n, true, "", /[구군]$/.test(d.id));
    for (const h of S?.hubs ?? []) mk(`<b>${h.id}</b>`, h.lon, h.lat, 60, true, "fm-lb--hub", h.lon < 126.8 && h.lat > 37.3);
    for (const l of S?.labels ?? []) mk(`<b>${l.id}</b>`, l.lon, l.lat, 40, true, "fm-lb--hw");
    fm.views = views; fm.o.detailZoom = (views.sudo.zoom + views.incheon.zoom) / 2; (window as any).__fm = fm; (window as any).__fmViews = () => views;
    // [2026-10-15 P0 · 모바일 성능] 좁은 화면의 첫 장면은 해상도 배율 1 — GPU 없이 칠하는 환경에서 배율 1.5 는 장면마다 70ms 를 넘겼고 1 이면 긴 작업이 거의 0(실측).
    // 사람이 만지거나 15초가 지나면 1.5 로 올려 선을 또렷하게 한다(움직임은 처음부터 같다 — 픽셀 수만 다르다)
    if (lite && (devicePixelRatio || 1) > 1) {
      const sharp = () => { if (!fm || fm.o.maxDpr >= 1.5) return; fm.o.maxDpr = 1.5; fm.resize(); fm.draw(); };
      for (const ev of ["touchstart", "pointerdown", "scroll", "keydown"]) addEventListener(ev, sharp, { once: true, passive: true });
      setTimeout(sharp, 15000);
    }
    fm.warm(lite ? 6 : 9);
    hold = reduce; // 동작 줄이기 = 카메라 둘러보기만 꺼 둔다(점은 흐른다)
    fm.touring = !hold; stage.dataset.touring = hold ? "0" : "1"; fm.draw();
    stage.dataset.ready = "1"; stage.dataset.motion = reduce ? "reduce" : "full";
    if (!still) fm.start();
    tourBtn(); playBtn();
    // 보이지 않으면 쉰다 · 멈춤을 골랐으면 그대로
    new IntersectionObserver(([e]) => { if (!fm) return; if (e.isIntersecting && !still) fm.start(); else fm.stop(); }).observe(stage);
    document.addEventListener("visibilitychange", () => { if (!fm) return; if (document.hidden) fm.stop(); else if (!still) fm.start(); });
    addEventListener("resize", () => { if (!fm) return; fm.resize(); views = fit(); fm.views = views; fm.o.detailZoom = (views.sudo.zoom + views.incheon.zoom) / 2; if (!fm.tour && !fm.touring && views[viewNow]) fm.cam = { ...views[viewNow] }; fm.draw(); });
  }
  // ── 자동 재생 [2026-10-15 공개 전 개편 P0] — 들어오자마자 돈다. 만지면(끌기·바퀴·보기 단추) 카메라가 멈췄다가 6초 뒤 다시 돈다.
  //    「둘러보기 멈춤」 단추로 멈춘 것(hold)은 다시 누를 때까지 그대로 · 동작 줄이기(prefers-reduced-motion)면 처음부터 hold.
  let hold = false, resumeT = 0, viewNow = "sudo"; // viewNow = 지금 고른 보기(단추·창 크기 바뀜이 같이 읽는다 — boot 안에 두면 단추가 못 읽었다 · 10/20 시험이 잡음)
  const RESUME_MS = 6000;
  const tourBtn = () => { const b = $("fm-tour"); b.innerHTML = hold ? `<span class="lg">카메라\u00a0</span>회전` : `<span class="lg">카메라\u00a0</span>회전 끔`; /* 좁은 화면에서 「멈춤」만 남아 흐름 멈춤 단추와 이름이 같았다(2차 화면 판정) */ b.setAttribute("aria-label", hold ? "카메라 회전" : "카메라 회전 끔"); b.setAttribute("aria-pressed", String(!hold)); };
  const resume = () => { if (!fm || hold) return; fm.touring = true; fm.tourT = 0; stage.dataset.touring = "1"; };
  const stopTour = () => {
    if (!fm) return;
    fm.touring = false; fm.tour = null; stage.dataset.touring = "0"; (window as any).__fmStops = ((window as any).__fmStops || 0) + 1; // 시험 손잡이 — 멈춘 횟수
    clearTimeout(resumeT); if (!hold) resumeT = window.setTimeout(resume, RESUME_MS);
  };
  (window as any).__fmResumeMs = RESUME_MS;

  // ── 조작: 끌면 돌린다(가로 = 방위 · 세로 = 기울기) · 누르면 관문 숫자 · 보기 단추 ──
  let drag: { x: number; y: number; b: number; p: number; moved: boolean } | null = null;
  cv.addEventListener("pointerdown", (e) => { if (!fm) return; stopTour(); drag = { x: e.clientX, y: e.clientY, b: fm.cam.bearing, p: fm.cam.pitch, moved: false }; });
  addEventListener("pointermove", (e) => {
    if (!drag || !fm) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (!drag.moved && Math.hypot(dx, dy) < 6) return;
    if (!drag.moved) { drag.moved = true; stopTour(); }
    fm.cam.bearing = drag.b - dx * 0.25;
    if (e.pointerType === "mouse") fm.cam.pitch = Math.max(0, Math.min(62, drag.p - dy * 0.2));
    if (!fm.running) fm.draw();
  });
  addEventListener("pointerup", (e) => {
    if (!drag || !fm) return;
    const was = drag.moved; drag = null;
    if (was) return;
    // 누름 — 가까운 관문(28px)이면 관문 숫자를 연다
    const r = cv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    const hit = fm.gates.some((g) => { const s = fm!.screen(g.lon, g.lat); return Math.hypot(s[0] - x, s[1] - y) < 28; });
    if (hit) openPanel(true);
  });
  // 바퀴 — 지도 위에서만 줌(Ctrl/⌘ 없이 굴리면 페이지가 내려간다)
  cv.addEventListener("wheel", (e) => { if (!fm || !(e.ctrlKey || e.metaKey)) return; e.preventDefault(); stopTour(); fm.cam.zoom = Math.max(2.3, Math.min(10.5, fm.cam.zoom - e.deltaY * 0.004)); if (!fm.running) fm.draw(); }, { passive: false });
  // 보기 단추 — 아시아면 아시아에서, 수도권이면 수도권 안에서 다시 돈다(6초 뒤)
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-view]")) b.addEventListener("click", () => {
    if (!fm) return; stopTour();
    const v = b.dataset.view!;
    fm.tourViews = v === "asia" ? ["asia"] : ["sudo", "incheon"]; fm.tourStep = v === "incheon" ? 1 : 0;
    viewNow = v === "asia" ? "asia" : v; fm.flyTo(fm.views[v], 3.2); if (!fm.running && !still) fm.start();
  });
  $("fm-tour").addEventListener("click", () => {
    if (!fm) return;
    hold = !hold; tourBtn();
    if (hold) { clearTimeout(resumeT); fm.touring = false; fm.tour = null; stage.dataset.touring = "0"; }
    else { clearTimeout(resumeT); resume(); if (!still) fm.start(); }
  });
  // 흐름 멈춤/재생 — 지도 칸 구석 · 키보드로 누를 수 있다 · 지면을 옮겨도 기억(lib/motion.ts)
  const playBtn = () => { const b = $("fm-play"); b.setAttribute("aria-pressed", String(still)); b.setAttribute("aria-label", still ? "흐름 재생" : "흐름 멈춤"); b.querySelector(".live__pt")!.textContent = still ? "재생" : "멈춤"; b.dataset.state = still ? "paused" : "playing"; };
  $("fm-play").addEventListener("click", () => {
    still = !still; setPaused(still); playBtn();
    if (!fm) return;
    if (still) fm.stop(); else fm.start();
  });
  playBtn();
  // 관문 숫자 판 — 달이 바뀌면 같이 바뀐다
  let D0: any = null;
  const panel = (i: number) => {
    if (!D0) D0 = (window as any).__fmdata;
    const F = D0?.flows; if (!F) return;
    const m = F.months[i];
    $("fm-p-h").textContent = `${m.ym} 관문별`;
    $("fm-p-dl").innerHTML = `<dt>인천공항</dt><dd>수입 ${fmt(m.air_imp)} · 수출 ${fmt(m.air_exp)}<small>억 달러</small></dd>` +
      `<dt>인천항</dt><dd>수입 ${fmt(m.port_imp)} · 수출 ${fmt(m.port_exp)}<small>억 달러</small></dd>` +
      (m.teu ? `<dt>인천항 컨테이너</dt><dd>${F.sea_gates.map((g: any) => `${g.id} ${m.teu[g.id] ?? "—"}`).join(" · ")}<small>천TEU</small></dd>` : "") +
      `<dt>전국 대비</dt><dd>수입 ${m.imp_share_pct}% · 수출 ${m.exp_share_pct}%</dd>`;
  };
  const openPanel = (open: boolean) => { $("fm-panel").hidden = !open; $("fm-gates").setAttribute("aria-expanded", String(open)); };
  $("fm-gates").addEventListener("click", () => openPanel($("fm-panel").hidden === true));
  $("fm-x").addEventListener("click", () => openPanel(false));
  addEventListener("keydown", (e) => { if (e.key === "Escape") openPanel(false); });

  // 다 뜬 뒤에 받는다(첫 그림·글꼴을 막지 않게) — 정지 해도가 그동안 같은 자리를 보인다
  let booted = false;
  const kick = () => { if (booted) return; booted = true; boot().catch((e) => { stage.dataset.ready = "error"; console.error(e); }); };
  // [2026-10-15 P0] 좁은 화면도 만지기를 기다리지 않는다 — 페이지가 다 뜬 뒤 한가할 때 받는다(첫 장면은 정지 해도 · 같은 자리).
  const go = () => {
    "requestIdleCallback" in window ? (window as any).requestIdleCallback(kick, { timeout: lite ? 2500 : 1500 }) : setTimeout(kick, lite ? 600 : 300);
    // 그 사이 사람이 먼저 만지면 바로
    for (const ev of ["touchstart", "pointerdown", "keydown", "wheel"]) addEventListener(ev, kick, { once: true, passive: true });
  };
  document.readyState === "complete" ? go() : addEventListener("load", go, { once: true });
</script>

<style>
