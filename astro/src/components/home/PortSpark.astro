---
// 인천항 컨테이너 월별 처리량 — 빌드 때 SVG 로 그린다(JS 0 · 첫 화면 성능). 값은 공표 원값(천TEU) 그대로.
import Updated from "../Updated.astro";
import { portMonthly } from "../../lib/data";
const { series, updated, source } = portMonthly();
const W = 640, H = 200, P = { l: 8, r: 8, t: 18, b: 22 };
const vs = series.map((s) => s.v);
const lo = Math.min(...vs) * 0.9, hi = Math.max(...vs) * 1.04;
const x = (i: number) => P.l + (i * (W - P.l - P.r)) / (series.length - 1);
const y = (v: number) => P.t + (1 - (v - lo) / (hi - lo)) * (H - P.t - P.b);
const line = series.map((s, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(s.v).toFixed(1)}`).join("");
const area = `${line}L${x(series.length - 1).toFixed(1)},${H - P.b}L${x(0).toFixed(1)},${H - P.b}Z`;
const last = series[series.length - 1];
const maxI = vs.indexOf(Math.max(...vs));
const years = series.map((s, i) => ({ i, y: s.ym.slice(0, 4), m: s.ym.slice(5) })).filter((d) => d.m === "01");
const desc = `인천항 컨테이너 월별 처리량 ${series[0].ym}부터 ${last.ym}까지 ${series.length}개월. 최근 ${last.ym} ${last.v}천TEU, 최대 ${series[maxI].ym} ${series[maxI].v}천TEU.`;
---
<figure class="spark" data-chart="port-monthly">
  <div class="spark__head">
    <p class="spark__k">인천항 컨테이너 처리량 <span>{last.ym}</span></p>
    <p class="spark__v"><strong>{last.v.toLocaleString("ko-KR")}</strong><span>천TEU</span>{last.yoy !== null && <em class={last.yoy >= 0 ? "up" : "down"}>전년 같은 달 대비 {last.yoy > 0 ? "+" : ""}{last.yoy}%</em>}</p>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={desc}>
    <defs><linearGradient id="sg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#3fd3e6" stop-opacity="0.45" /><stop offset="1" stop-color="#3fd3e6" stop-opacity="0" /></linearGradient></defs>
    {years.map((d) => <line x1={x(d.i)} x2={x(d.i)} y1={P.t} y2={H - P.b} stroke="rgba(170,210,235,.16)" />)}
    {years.map((d) => <text x={x(d.i) + 4} y={H - 6} fill="#a3b9c9" font-size="11">{d.y}</text>)}
    <path d={area} fill="url(#sg)" />
    <path d={line} fill="none" stroke="#3fd3e6" stroke-width="2.2" vector-effect="non-scaling-stroke" />
    <circle cx={x(series.length - 1)} cy={y(last.v)} r="4.5" fill="#ffb547" />
  </svg>
  <figcaption><Updated date={updated} source={`${source} · ${series.length}개월`} /></figcaption>
</figure>
<style>
  .spark { margin: 0; }
  .spark__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem; }
  .spark__k { margin: 0; font-size: 0.9rem; color: var(--mist); font-weight: 600; }
  .spark__k span { color: var(--sodium); margin-left: 0.3rem; }
  .spark__v { margin: 0; color: var(--ink); display: flex; align-items: baseline; gap: 0.35rem; flex-wrap: wrap; }
  .spark__v strong { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .spark__v span { color: var(--mist); font-weight: 600; }
  .spark__v em { font-style: normal; font-size: 0.82rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid currentColor; }
  .spark__v em.up { color: var(--pass); }
  .spark__v em.down { color: var(--fail); }
  .spark svg { width: 100%; height: auto; display: block; margin-top: 0.4rem; }
  .spark figcaption { margin-top: 0.3rem; }
</style>
